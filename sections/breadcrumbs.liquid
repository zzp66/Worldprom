{{- 'breadcrumbs.css' | asset_url | stylesheet_tag -}}
{%- liquid
	assign bc_collection = collection

	if bc_collection == blank and template contains 'product'
		assign bc_best = 999999

		assign bc_style = 'a-line-prom-dresses,ball-gown-prom-dresses,beading-prom-dresses,floral-prom-dresses,lace-prom-dresses,ruffle-prom-dresses,sequin-prom-dresses,sparkly-prom-dresses' | split: ','
		for c in product.collections
			if bc_style contains c.handle
				if c.products_count < bc_best
					assign bc_collection = c
					assign bc_best = c.products_count
				endif
			endif
		endfor

		if bc_collection == blank
			assign bc_exclude = 'prom-dresses,all-prom-dresses,2026-spring-prom-dresses,trending-prom-dresses-2026,luxury-prom-dresses-1,prom-dresses-under-150,custom-size-prom-dresses,modest-prom-dresses,long-prom-dresses,short-prom-dresses' | split: ','
			for c in product.collections
				if c.handle contains 'prom-dress'
					unless bc_exclude contains c.handle
						unless c.handle contains '-fb'
							if c.products_count < bc_best
								assign bc_collection = c
								assign bc_best = c.products_count
							endif
						endunless
					endunless
				endif
			endfor
		endif

		if bc_collection == blank
			assign bc_priority = 'quinceanera,wedding-dresses,bridesmaids,wedding-guest-dresses,graduation-dresses,prom-dresses,homecoming-dresses,cocktail-dresses,evening-dresses,formal-dresses' | split: ','
			for bc_handle in bc_priority
				for c in product.collections
					if c.handle == bc_handle
						assign bc_collection = c
						break
					endif
				endfor
				if bc_collection != blank
					break
				endif
			endfor
		endif
	endif
-%}
<div class="row full-width-row">
	<div class="small-12 columns">
		<scroll-shadow>
			<nav class="breadcrumbs" aria-label="breadcrumbs">
				<a href="{{ routes.root_url }}" title="{{ 'sections.breadcrumbs.home' | t | escape }}">{{ 'sections.breadcrumbs.home' | t }}</a>
				{% if bc_collection.url %}
					<i>/</i>
					<a href="{{ bc_collection.url }}" title="{{ bc_collection.title | escape }}">{{ bc_collection.title }}</a>
				{% endif %}
				{% if template contains 'cart' %}
					<i>/</i>
					{{ 'sections.breadcrumbs.cart' | t }}
				{% endif %}
				{% if template contains 'product' %}
					<i>/</i>
					{{ product.title }}
				{% endif %}
				{% if template contains 'blog' %}
					{% if current_tags %}
						<i>/</i>
						<a href="{{ blog.url }}" title="{{ blog.title | escape }}">{{ blog.title }}</a>
						<i>/</i>
						{{ current_tags }}
					{% else %}
						<i>/</i>
						{{ blog.title }}
					{% endif %}
				{% endif %}
				{% if template contains 'article' %}
					<i>/</i>
					<a href="{{ blog.url }}" title="{{ blog.title | escape }}">{{ blog.title }}</a>
					<i>/</i>
					{{ article.title }}
				{% endif %}
				{% if template contains 'page' %}
					<i>/</i>
					{{ page.title }}
				{% endif %}
				{% if template contains 'search' %}
					<i>/</i>
					{{ 'sections.breadcrumbs.search' | t }}
				{% endif %}
				{% if template contains 'customers' %}
					<i>/</i>
					{{ 'sections.breadcrumbs.my_account' | t }}
				{% endif %}
			</nav>
		</scroll-shadow>
	</div>
</div>
{% schema %}
{
	"name": "Breadcrumbs",
	"class": "section-breadcrumbs",
	"limit": 1,
	"presets": [
		{
			"name": "Breadcrumbs"
		}
	],
  "disabled_on": {
    "groups": [
      "custom.overlay"
    ]
  }
}
{% endschema %}
