<script>
  document.addEventListener('DOMContentLoaded', function () {

    const section = document.getElementById(
      'InstagramCarousel-{{ section.id }}'
    );

    if (!section) return;

    const track = section.querySelector('[data-instagram-track]');
    const prevButton = section.querySelector('.instagram-carousel-prev');
    const nextButton = section.querySelector('.instagram-carousel-next');

    if (!track) return;

    const videos = track.querySelectorAll('[data-instagram-video]');

    // 区块进入可视区上下 600px 范围时，一次性设置所有视频的封面图
    function showPosters() {
      videos.forEach(function (video) {
        if (video.dataset.poster) {
          video.poster = video.dataset.poster;
          video.removeAttribute('data-poster');
        }
      });
    }

    if (videos.length) {
      if ('IntersectionObserver' in window) {
        const posterObserver = new IntersectionObserver(function (entries, observer) {
          if (entries.some(function (entry) { return entry.isIntersecting; })) {
            observer.disconnect();
            showPosters();
          }
        }, { rootMargin: '600px 0px' });
        posterObserver.observe(section);
      } else {
        showPosters();
      }
    }

    // 弹窗打开期间卡片视频全部暂停，关闭后只恢复还在可视区里的
    let lightboxOpen = false;
    const visibleVideos = new Set();

    if (videos.length && 'IntersectionObserver' in window) {
      const videoObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          const video = entry.target;

          if (entry.isIntersecting) {
            visibleVideos.add(video);
            if (lightboxOpen) return;
            video.muted = true;
            video.play().catch(function () {});
          } else {
            visibleVideos.delete(video);
            video.pause();
          }
        });
      }, { threshold: 0.25 });

      videos.forEach(function (video) {
        videoObserver.observe(video);
      });
    }

    function getScrollAmount() {
      const item = track.querySelector('.instagram-carousel-item');

      if (!item) {
        return 0;
      }

      return item.offsetWidth + {{ section.settings.gap }};
    }

    if (prevButton) {
      prevButton.addEventListener('click', function () {

        track.scrollBy({
          left: -getScrollAmount() * 2,
          behavior: 'smooth'
        });

      });
    }

    if (nextButton) {
      nextButton.addEventListener('click', function () {

        track.scrollBy({
          left: getScrollAmount() * 2,
          behavior: 'smooth'
        });

      });
    }

    /* ---------- Lightbox ---------- */

    const cards = Array.prototype.slice.call(track.querySelectorAll('[data-instagram-open]'));
    const lightbox = section.querySelector('[data-instagram-lightbox]');

    if (!cards.length || !lightbox) return;

    const canShowModal = typeof lightbox.showModal === 'function';
    const media = lightbox.querySelector('[data-ig-media]');
    const lbVideo = lightbox.querySelector('[data-ig-video]');
    const lbImage = lightbox.querySelector('[data-ig-image]');
    const soundButton = lightbox.querySelector('[data-ig-sound]');
    const head = lightbox.querySelector('[data-ig-head]');
    const userEl = lightbox.querySelector('[data-ig-user]');
    const captionEl = lightbox.querySelector('[data-ig-caption]');
    const foot = lightbox.querySelector('[data-ig-foot]');
    const linkEl = lightbox.querySelector('[data-ig-link]');
    const shop = lightbox.querySelector('[data-ig-shop]');
    const productSlot = lightbox.querySelector('[data-ig-product-slot]');
    const lbPrev = lightbox.querySelector('[data-ig-prev]');
    const lbNext = lightbox.querySelector('[data-ig-next]');
    const brandUser = lightbox.dataset.brandUser || '';

    let current = 0;
    let opener = null;
    let soundOn = true;

    function updateSoundButton() {
      soundButton.classList.toggle('is-muted', lbVideo.muted);
      soundButton.setAttribute('aria-label', lbVideo.muted ? 'Unmute' : 'Mute');
    }

    // 点击本身是用户操作，浏览器一般允许带声音播放；被拦下时退回静音播放，用户可以点喇叭打开声音
    function playLightboxVideo() {
      lbVideo.muted = !soundOn;
      updateSoundButton();

      const playing = lbVideo.play();
      if (playing && playing.catch) {
        playing.catch(function (error) {
          if (error && error.name === 'NotAllowedError' && !lbVideo.muted) {
            lbVideo.muted = true;
            updateSoundButton();
            lbVideo.play().catch(function () {});
          }
        });
      }
    }

    // 去掉 src 才会停止继续下载
    function stopLightboxVideo() {
      lbVideo.pause();
      if (lbVideo.hasAttribute('src')) {
        lbVideo.removeAttribute('src');
        lbVideo.load();
      }
      media.classList.remove('is-paused');
    }

    function showItem(index) {
      current = (index + cards.length) % cards.length;
      const data = cards[current].dataset;

      media.style.setProperty('--ig-ratio', data.ratio || '0.5625');

      if (data.type === 'video') {
        lbImage.hidden = true;
        lbImage.removeAttribute('srcset');
        lbImage.removeAttribute('src');

        lbVideo.hidden = false;
        soundButton.hidden = false;
        if (lbVideo.getAttribute('src') !== data.src) {
          media.classList.remove('is-paused');
          lbVideo.poster = data.fullPoster || '';
          lbVideo.src = data.src;
        }
        playLightboxVideo();
      } else {
        stopLightboxVideo();
        lbVideo.hidden = true;
        soundButton.hidden = true;

        lbImage.hidden = false;
        lbImage.alt = data.caption || '';
        if (data.srcset) {
          lbImage.srcset = data.srcset;
        } else {
          lbImage.removeAttribute('srcset');
        }
        lbImage.src = data.image;
      }

      const user = data.user || brandUser;
      userEl.textContent = user ? '@' + user : '';
      head.hidden = !user;

      captionEl.textContent = data.caption || '';

      // 关联产品：卡片旁边的 template 是服务端渲染好的产品卡，没选产品就没有 template
      const productTemplate = cards[current].parentNode.querySelector('template[data-ig-product]');
      productSlot.textContent = '';
      if (productTemplate) {
        productSlot.appendChild(productTemplate.content.cloneNode(true));
        shop.hidden = false;
      } else {
        shop.hidden = true;
      }

      if (data.link) {
        linkEl.href = data.link;
        foot.hidden = false;
      } else {
        foot.hidden = true;
      }
    }

    function openLightbox(index) {
      opener = cards[index];
      lightboxOpen = true;
      videos.forEach(function (video) { video.pause(); });
      document.body.classList.add('overflow-hidden');
      lightbox.showModal();
      showItem(index);
    }

    cards.forEach(function (card, index) {
      card.addEventListener('click', function () {
        if (canShowModal) {
          openLightbox(index);
        } else if (card.dataset.link) {
          // 不支持 <dialog> 的老浏览器才会走这里
          window.open(card.dataset.link, '_blank', 'noopener');
        }
      });
    });

    if (!canShowModal) return;

    const single = cards.length < 2;
    lbPrev.hidden = single;
    lbNext.hidden = single;

    lbPrev.addEventListener('click', function () { showItem(current - 1); });
    lbNext.addEventListener('click', function () { showItem(current + 1); });

    lightbox.querySelector('[data-ig-close]').addEventListener('click', function () {
      lightbox.close();
    });

    // 点遮罩（弹窗内容以外的区域）关闭
    lightbox.addEventListener('click', function (event) {
      if (event.target === lightbox) lightbox.close();
    });

    lightbox.addEventListener('keydown', function (event) {
      if (single) return;
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        showItem(current - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        showItem(current + 1);
      }
    });

    // ESC、关闭按钮、点遮罩最后都会走到这里
    lightbox.addEventListener('close', function () {
      stopLightboxVideo();
      lbImage.removeAttribute('srcset');
      lbImage.removeAttribute('src');
      document.body.classList.remove('overflow-hidden');
      lightboxOpen = false;

      visibleVideos.forEach(function (video) {
        video.muted = true;
        video.play().catch(function () {});
      });

      if (opener) opener.focus({ preventScroll: true });
    });

    soundButton.addEventListener('click', function () {
      soundOn = lbVideo.muted;
      lbVideo.muted = !soundOn;
      updateSoundButton();
      if (lbVideo.paused) lbVideo.play().catch(function () {});
    });

    lbVideo.addEventListener('click', function () {
      if (lbVideo.paused) {
        lbVideo.play().catch(function () {});
      } else {
        lbVideo.pause();
      }
    });

    lbVideo.addEventListener('play', function () { media.classList.remove('is-paused'); });
    lbVideo.addEventListener('pause', function () {
      if (lbVideo.hasAttribute('src')) media.classList.add('is-paused');
    });

    // 手机上左右滑动切换
    let touchStartX = null;
    let touchStartY = 0;

    media.addEventListener('touchstart', function (event) {
      if (event.touches.length !== 1) {
        touchStartX = null;
        return;
      }
      touchStartX = event.touches[0].clientX;
      touchStartY = event.touches[0].clientY;
    }, { passive: true });

    media.addEventListener('touchend', function (event) {
      if (touchStartX === null || single) return;
      const touch = event.changedTouches[0];
      const dx = touch.clientX - touchStartX;
      const dy = touch.clientY - touchStartY;
      touchStartX = null;

      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        showItem(current + (dx < 0 ? 1 : -1));
      }
    }, { passive: true });

  });
</script>


