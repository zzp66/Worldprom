{{- 'product-grid.css' | asset_url | stylesheet_tag -}}
{{- 'collection-tabs.css' | asset_url | stylesheet_tag -}}
{%- liquid
	assign section_subheading = section.settings.subheading
	assign section_heading = section.settings.heading
	assign section_heading_left = section.settings.heading_left
	assign section_description = section.settings.description
	assign full_width = section.settings.full_width
	assign columns_desktop = section.settings.columns_desktop
	assign show_view_all = section.settings.show_view_all
	assign product_limit = section.settings.product_limit

	assign disable_top_spacing = section.settings.disable_top_spacing
	assign disable_bottom_spacing = section.settings.disable_bottom_spacing

	assign has_promotion = false
	for block in section.blocks
		if block.settings.enable_promotion == true
			assign has_promotion = true
			continue
		endif
	endfor

	assign columns_tablet = columns_desktop | minus: 2 | at_most: 5 | at_least: 3
-%}
{%- if has_promotion -%}
	<link id="PromotionStyle-{{ section.id }}" rel="stylesheet" href="{{ 'product-card-promotion.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}
<div class="collection-tabs section-spacing{% if disable_top_spacing %} section-spacing--disable-top{% endif %}{% if disable_bottom_spacing %} section-spacing--disable-bottom{% endif %}">
	<div class="row{% if full_width %} full-width-row{% endif %}">
		<div class="small-12 columns">
			{% render 'section-header', section_heading: section_heading, section_description: section_description, section_heading_left: section_heading_left, section_subheading: section_subheading, section_id: section.id, blocks: section.blocks %}
			<theme-scroll class="theme-scroll" data-overlayscrollbars-initialize>
				<div class="theme-scroll--inner">
					<div id="product-grid-{{ section.id }}" data-id="{{ section.id }}" class="products carousel" style="--desktop-columns: {{ columns_desktop }}; --tablet-columns: {{ columns_tablet }};">
						{%- for block in section.blocks -%}
							{% assign mainloop = forloop %}
							{%- if block.settings.collection != blank %}
								{%- for product in block.settings.collection.products limit: product_limit -%}
									{%- assign product_loop = forloop -%}
									{%- liquid
										assign display_promotion = false
										if product_loop.index == block.settings.promotion_position
											assign display_promotion = true
										endif

										if product_loop.index == block.settings.promotion_position and block.settings.enable_promotion
											assign display_promotion = true
										else
											assign display_promotion = false
										endif
									-%}
									{%- if display_promotion -%}
									<div class="collection-tabs--product{% if mainloop.first == true %} carousel__slide{% endif %}" data-collection="collection-{{ block.id }}">
										{%- render 'product-card-promotion', block: block -%}
									</div>
									{%- endif -%}
									<div class="collection-tabs--product{% if mainloop.first == true %} carousel__slide{% endif %}" data-collection="collection-{{ block.id }}">
										{% render 'product-card', product_card_product: product %}
									</div>
								{%- endfor -%}
							{%- else -%}
								{%- for i in (1..product_limit) -%}
									{%- assign product_loop = forloop -%}
									{%- liquid
										assign display_promotion = false
										if product_loop.index == block.settings.promotion_position
											assign display_promotion = true
										endif

										if product_loop.index == block.settings.promotion_position and block.settings.enable_promotion
											assign display_promotion = true
										else
											assign display_promotion = false
										endif
									-%}
									{%- if display_promotion -%}
									<div class="collection-tabs--product{% if mainloop.first == true %} carousel__slide{% endif %}" data-collection="collection-{{ block.id }}">
										{%- render 'product-card-promotion', block: block -%}
									</div>
									{%- endif -%}
									<div class="collection-tabs--product{% if mainloop.first == true %} carousel__slide{% endif %}" data-collection="collection-{{ block.id }}">
										{% render 'product-card', index: i %}
									</div>
								{%- endfor -%}
							{%- endif -%}
						{%- endfor -%}
					</div>
				</div>
				{% render 'slideshow-arrows', disabled: true %}
			</theme-scroll>
			{% if show_view_all %}
			<div class="section-header--button">
				{%- for block in section.blocks -%}
					{%- if block.settings.collection != blank -%}
						<a class="button outline linked-to-tab{% if forloop.first == true %} active{% endif %}" href="{{ block.settings.collection.url }}">{{ 'sections.featured_collection.shop_collection' | t: collection: block.settings.collection.title }}</a>
					{%- else -%}
						<a class="button outline linked-to-tab{% if forloop.first == true %} active{% endif %}" href="#">{{ 'sections.featured_collection.shop_collection' | t: collection: 'Collection' }}</a>
					{%- endif -%}
				{%- endfor -%}
			</div>
		  {% endif %}
		</div>
	</div>
</div>
<script src="{{ 'collection-tabs.js' | asset_url }}" defer="defer"></script>
{% schema %}
  {
    "name": "Collection tabs",
		"class": "section-collection-tabs",
		"max_blocks": 4,
    "settings": [
			{
        "type": "text",
        "id": "subheading",
        "label": "Subheading",
        "default": "Add a tagline"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Collection Tabs"
      },
			{
				"type": "checkbox",
				"id": "heading_left",
				"default": false,
				"label": "Left align heading"
			},
      {
        "type": "richtext",
        "id": "description",
        "label": "Description",
        "default": "<p>Add a short description for your collections</p>"
      },
			{
				"type": "checkbox",
				"id": "full_width",
				"label": "Make section full width",
				"default": true
			},
			{
	      "type": "range",
	      "id": "product_limit",
	      "min": 2,
	      "max": 16,
	      "step": 1,
	      "default": 5,
	      "label": "Number of products to show"
	    },
			{
	      "type": "range",
	      "id": "columns_desktop",
	      "min": 2,
	      "max": 6,
	      "step": 1,
	      "default": 4,
	      "label": "Number of columns on desktop"
	    },
	    {
	      "type": "checkbox",
	      "id": "show_view_all",
	      "default": true,
	      "label": "Enable \"View all\" button",
				"info": "Enable \"View all\" button if collection includes more products than shown"
	    },
			{
        "type": "header",
        "content": "Spacing"
      },
			{
				"type": "checkbox",
				"id": "disable_top_spacing",
				"default": false,
				"label": "Remove top spacing"
			},
			{
				"type": "checkbox",
				"id": "disable_bottom_spacing",
				"default": false,
				"label": "Remove bottom spacing"
			}
    ],
		"blocks": [
      {
        "type": "collection",
        "name": "Collection",
        "settings": [
          {
            "type": "collection",
            "id": "collection",
            "label": "Collection"
          },
					{
						"type": "header",
						"content": "Promotion"
					},
					{
						"type": "checkbox",
						"id": "enable_promotion",
						"default": false,
						"label": "Enable promotion"
					},
					{
						"type": "range",
						"id": "promotion_position",
						"min": 1,
						"max": 5,
						"step": 1,
						"label": "Show in position",
						"default": 1
					},
					{
						"type": "header",
						"content": "Content"
					},
					{
						"type": "image_picker",
						"id": "image",
						"label": "Image"
					},
					{
						"type": "text",
						"id": "title",
						"default": "Promotion",
						"label": "Heading"
					},
					{
						"type": "select",
						"id": "heading_size",
						"label": "Heading size",
						"options": [
							{
								"value": "h3",
								"label": "Large"
							},
							{
								"value": "h4",
								"label": "Medium"
							},
							{
								"value": "h5",
								"label": "Small"
							}
						],
						"default": "h3"
					},
					{
						"type": "textarea",
						"id": "text",
						"default": "Advertise a promotion or a sale",
						"label": "Description"
					},
					{
						"id": "link_label",
						"type": "text",
						"label": "Button label",
						"default": "Explore",
						"info": "Leave the label blank to hide the button."
					},
					{
						"id": "link",
						"type": "url",
						"label": "Link"
					},
					{
						"type": "header",
						"content": "Layout"
					},
					{
						"type": "select",
						"id": "content_position",
						"label": "Content position",
						"options": [
							{ "value": "top-left", "label": "Top left" },
							{ "value": "top-center", "label": "Top center" },
							{ "value": "top-right", "label": "Top right" },
							{ "value": "middle-left", "label": "Middle left" },
							{ "value": "middle-center", "label": "Middle center" },
							{ "value": "middle-right", "label": "Middle right" },
							{ "value": "bottom-left", "label": "Bottom left" },
							{ "value": "bottom-center", "label": "Bottom center" },
							{ "value": "bottom-right", "label": "Bottom right" }
						],
						"default": "bottom-left"
					},
					{
						"type": "select",
						"id": "text_alignment",
						"options": [
							{
								"value": "left",
								"label": "Left"
							},
							{
								"value": "center",
								"label": "Center"
							},
							{
								"value": "right",
								"label": "Right"
							}
						],
						"default": "left",
						"label": "Content alignment"
					},
					{
						"type": "header",
						"content": "Colors"
					},
					{
						"type": "color",
						"id": "color_text",
						"label": "Text",
						"default": "#4E693D"
					},
					{
						"type": "color",
						"id": "color_bg",
						"label": "Background",
						"default": "#FFF6DF"
					},
					{
						"type": "color",
						"id": "color_button_text",
						"label": "Button text",
						"default": "#FFF6DF"
					}
				]
			}
		],
    "presets": [
      {
        "name": "Collection tabs",
				"blocks": [
					{
						"type": "collection"
					},
					{
						"type": "collection"
					},
					{
						"type": "collection"
					}
				]
      }
    ],
		"disabled_on": {
			"groups": [
				"custom.overlay"
			]
		}
  }

{% endschema %}
