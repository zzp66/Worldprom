{{- 'collapsible-content.css' | asset_url | stylesheet_tag -}}
{%- liquid
	assign section_subheading = section.settings.subheading
	assign section_heading = section.settings.heading
	assign section_description = section.settings.description
	assign uppercase_heading = section.settings.uppercase_heading
	assign disable_top_spacing = section.settings.disable_top_spacing
	assign disable_bottom_spacing = section.settings.disable_bottom_spacing
-%}
<div class="collapsible-content heading-uppercase-{{ uppercase_heading }} section-spacing{% if disable_top_spacing %} section-spacing--disable-top{% endif %}{% if disable_bottom_spacing %} section-spacing--disable-bottom{% endif %}">
	<div class="row">
		<div class="small-12 columns">
			{% render 'section-header', section_heading: section_heading, section_description: section_description, section_heading_left: false, section_subheading: section_subheading %}
			<div class="collapsible-content__inner">
				{%- for block in section.blocks -%}
					{%- if block.settings.heading != blank -%}
						{%- liquid
							assign icon = block.settings.icon
							assign icon_image = block.settings.icon_image

							unless icon == 'none' or icon_image
								assign has_icon = true
							endunless
							if icon_image
								assign has_icon = true
							endif
						-%}
						<collapsible-row class="accordion{%- if has_icon %} accordion--has-icon{%- endif -%}" {{ block.shopify_attributes }}>
							<details id="Details-{{ block.id }}-{{ section.id }}" {% if block.settings.open %}open{% endif %}>
								<summary>
									{%- if icon_image -%}
										<div class="accordion--icon">
											{%- render 'responsive-image', image: icon_image -%}
										</div>
									{%- else -%}
										<div class="accordion--icon">
											{% render 'svg-icons-inline', icon: icon %}
										</div>
									{%- endif -%}
									{{ block.settings.heading | default: block.settings.page.title }}
									<span>{%- render 'svg-icons' with 'thb-accordion-arrow' -%}</span>
								</summary>
								<div class="collapsible__content accordion__content rte" id="Accordion-{{ block.id }}-{{ section.id }}">
									{%- if block.type == 'specification' -%}
											{%- render 'product-specification-table', block: block -%}
									{%- else -%}
									{{ block.settings.content }}
									{{ block.settings.page.content }}
									{{ block.settings.custom_liquid }}
									{%- endif -%}
								</div>
							</details>
						</collapsible-row>
						{%- endif -%}
				{%- endfor -%}
			</div>
		</div>
	</div>
</div>
