{{- 'image-with-scrolling-text.css' | asset_url | stylesheet_tag -}}
{%- liquid
	assign section_width = section.settings.section_width
	assign image = section.settings.image
	assign image_parallax = section.settings.image_parallax
	assign mobile_image = section.settings.mobile_image
	assign overlay_image = section.settings.overlay_image

	assign desktop_height = section.settings.desktop_height
	assign mobile_height = section.settings.mobile_height

	assign speed = section.settings.speed
	assign font_family = section.settings.font_family
	assign text_size = section.settings.text_size
	assign text_uppercase = section.settings.text_uppercase
	assign direction = section.settings.direction

	assign content_width = section.settings.content_width
	assign content_position = section.settings.content_position
	assign text_alignment = section.settings.text_alignment

	assign color_bg = section.settings.color_bg
	assign color_text = section.settings.color_text
	assign overlay_color = section.settings.overlay_color
	assign overlay_opacity = section.settings.overlay_opacity
	assign color_button_hover = color_text | color_darken: 7

	assign disable_top_spacing = section.settings.disable_top_spacing
	assign disable_bottom_spacing = section.settings.disable_bottom_spacing

	case mobile_height
		when 'mobile-height-350'
			assign mobile_image_height = 350
		when 'mobile-height-400'
			assign mobile_image_height = 400
		when 'mobile-height-450'
			assign mobile_image_height = 450
		when 'mobile-height-500'
			assign mobile_image_height = 500
		else
			assign mobile_image_height = 500
	endcase

	assign solid_button_label = color_bg
	assign has_padding = true
	if color_bg == 'transparent' or color_bg == 'rgba(0,0,0,0)'
		assign brightness = color_text | color_brightness
		if brightness < 128
			assign solid_button_label = color_text | color_lighten: 80
		else
			assign solid_button_label = color_text | color_darken: 80
		endif
		assign has_padding = false
	endif

	assign priority = false
	assign heading_tag = 'div'

	if section.index == 1
		assign priority = 'high'
		assign heading_tag = 'h1'
	endif
	
	assign scrolling_texts = section.blocks | where: "type", "scrolling_text"
	
-%}
<div class="row {{ section_width }}">
	<div class="small-12 columns">
		<image-with-scrolling-text class="image-with-scrolling-text text-{{ text_alignment }} {{ mobile_height }} {{ desktop_height }} section-spacing{% if disable_top_spacing %} section-spacing--disable-top{% endif %}{% if disable_bottom_spacing %} section-spacing--disable-bottom{% endif %}" style="--overlay-color-rgb: {{ overlay_color.rgb | replace: ' ' , ',' }}; --overlay-opacity: {{ overlay_opacity | divided_by: 100.0 }}; --color-bg: {{ color_bg }}; --color-body-rgb: {{ color_text.rgb | replace: ' ' , ',' }}; --color-body: {{ color_text }}; --solid-button-label: {{ solid_button_label }}; --solid-button-background: {{ color_text }}; --solid-button-background-hover: {{ color_button_hover }};">
			<div class="image-with-scrolling-text--bg parallax--{{ image_parallax }}">
				{%- if image -%}
					{%- liquid
						assign small_width = image.src.height | times: '375' | divided_by: image.src.width
						assign master_width = image.src.width | append: 'x' | append: image.src.height
						assign width = '375x' | append: small_width | append: ',' | append: master_width

						assign class = 'image-with-scrolling-text--image'
						if image_parallax
							assign class = class | append: ' thb-parallax-image'
						endif

						if mobile_image
							assign class = class | append: ' image-with-scrolling-text--desktop'
						endif
					-%}
					{%- render 'responsive-image', image: image, sizes: width, class: class, priority: priority -%}
				{%- else -%}
					{{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder_svg_tag' }}
				{%- endif -%}
				{%- if mobile_image -%}
					{%- liquid
						assign image = mobile_image
						assign master_width = image.src.width | append: 'x' | append: image.src.height
						assign width = '375x' | append: mobile_image_height | append: ',' | append: master_width

						assign class = 'image-with-scrolling-text--image'
						if image_parallax
							assign class = class | append: ' thb-parallax-image'
						endif

						assign class = class | append: ' image-with-scrolling-text--image image-with-scrolling-text--mobile'
						
						render 'responsive-image', image: image, sizes: width, class: class, priority: priority
					-%}
				{%- endif -%}
				<div class="image-with-scrolling-text--scrolling-text image-with-scrolling-text--scrolling-text-uppercase--{{ text_uppercase }}">
					<div class="image-with-scrolling-text--scrolling-text-inner direction-{{ direction }} {{ font_family }}-font" style="--marquee-speed: {{ speed }}; --font-size: {{ text_size | append: 'px' }}">
						{%- capture scrolling_text -%}
							{%- for block in scrolling_texts -%}
								<div class="image-with-scrolling-text--scrolling-text--item outline-text--{{ block.settings.outline_text }}" {{ block.shopify_attributes }}>
									<span>{{ block.settings.text }}</span>
								</div>
							{%- endfor -%}
						{%- endcapture -%}
						{{ scrolling_text }}{{ scrolling_text }}{{ scrolling_text }}
					</div>
				</div>
				{%- if overlay_image -%}
					<div class="image-with-scrolling-text--overlay-image-container">
					{%- liquid
						assign image = overlay_image
						assign width = image.src.width | append: 'x' | append: image.src.height

						assign class = 'image-with-scrolling-text--overlay-image'
						
						render 'responsive-image', image: image, sizes: width, class: class, priority: priority, retina: section.settings.retina
					-%}
					</div>
				{%- endif -%}
			</div>
			<div class="image-with-scrolling-text--content content-{{ content_position }}">
				<div class="image-with-scrolling-text--content-inner image-with-scrolling-text--content-inner-has-padding--{{ has_padding }} content-width-{{ content_width }}">
					{%- for block in section.blocks -%}
						{%- case block.type -%}
							{%- when 'badge' -%}
								<div {{ block.shopify_attributes }}>
									<span class="inline-badge" style="--badge-bg: {{ block.settings.color_bg }};--badge-bg-rgb: {{ block.settings.color_bg.rgb | replace: ' ' , ',' }}; --badge-text: {{ block.settings.color_text }}">{{ block.settings.text }}</span>
								</div>
							{%- when 'subheading' -%}
								<p class="subheading" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
							{%- when 'heading' -%}
								<{{ heading_tag }} class="image-with-scrolling-text--heading split-text {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>{{ block.settings.text | newline_to_br }}</{{ heading_tag }}>
							{%- when 'text' -%}
								<div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
							{%- when 'button' -%}
								{% if block.settings.button_text != blank %}
									<a class="button {% if block.settings.button_outline %} outline{%- endif %}" href="{{ block.settings.button_link }}" role="button" title="{{ block.settings.button_text | escape }}" {{ block.shopify_attributes }}>{{ block.settings.button_text }}</a>
								{% endif %}
							{%- when 'space' -%}
		            <div style="height: {{ block.settings.height | append: 'px' }}" {{ block.shopify_attributes }}></div>
						{%- endcase -%}
					{%- endfor -%}
				</div>
			</div>
		</image-with-scrolling-text>
	</div>
</div>
<script src="{{ 'image-with-scrolling-text.js' | asset_url }}" defer="defer"></script>
{% schema %}
  {
    "name": "Image with scrolling text",
