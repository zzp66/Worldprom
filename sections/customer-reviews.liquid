{{- 'customer-reviews.css' | asset_url | stylesheet_tag -}}
{%- liquid
	assign section_width = section.settings.section_width
  assign section_subheading = section.settings.subheading
	assign section_heading = section.settings.heading
	assign section_heading_left = section.settings.heading_left
  assign section_description = section.settings.description
  assign columns_desktop = section.settings.columns_desktop
  assign disable_top_spacing = section.settings.disable_top_spacing
  assign disable_bottom_spacing = section.settings.disable_bottom_spacing

  assign columns_tablet = columns_desktop | minus: 2 | at_most: 5 | at_least: 3
-%}

<div
  class="customer-reviews section-spacing-padding{% if disable_top_spacing %} section-spacing--disable-top{% endif %}{% if disable_bottom_spacing %} section-spacing--disable-bottom{% endif %}" style="--desktop-columns: {{ columns_desktop }}; --tablet-columns: {{ columns_tablet }}; --mobile-columns: 2"
>
  <div class="row {{ section_width }}">
    <div class="small-12 columns">
      {%- render 'section-header', section_heading: section_heading, section_description: section_description, section_heading_left: section_heading_left, section_subheading: section_subheading -%}
      <theme-scroll class="theme-scroll customer-reviews--container" data-overlayscrollbars-initialize>
				<div class="customer-reviews--grid theme-scroll--inner">
          {%- for block in section.blocks -%}
            {%- liquid
              assign product_image = block.settings.product_image
              assign product_handle = block.settings.product_handle
              assign review_product = all_products[product_handle]
            -%}
            <div
              class="customer-reviews--review carousel__slide"
              {{ block.shopify_attributes }}
            >
              {%- if product_image or product_handle != blank -%}
                <div class="customer-reviews--product">
                  {%- if product_image -%}
                    {%- render 'responsive-image', image: product_image -%}
                  {%- elsif product_handle and review_product.featured_image -%}
                    {%- render 'responsive-image', image: review_product.featured_image, sizes: '300x250,600x500' -%}
                  {%- else -%}
                    <div class="thb-placeholder">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {%- endif -%}
                  {%- if product_handle != blank -%}
                    <quick-view class="customer-reviews--quick-view" data-product-handle="{{ review_product.handle }}">
                      {%- render 'svg-icons' with 'thb-quick-view' %}
                      {%- unless review_product == empty -%}
                        <div class="loading-overlay">
                          {% render 'svg-icons' with 'thb-loading' %}
                        </div>
                      {%- endunless -%}
                    </quick-view>
                  {%- endif -%}
                </div>
              {%- endif -%}
              <div class="customer-reviews--content">
                {%- if block.settings.stars and block.settings.stars != '' -%}
                  <div class="star-rating" style="--star-rating: {{ block.settings.stars }};"></div>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <div class="customer-reviews--heading">{{ block.settings.heading }}</div>
                {%- endif -%}
                <p>{{ block.settings.text | newline_to_br }}</p>
                {%- if block.settings.author != blank -%}
                  <div class="customer-reviews--author">
                    {%- if block.settings.author_image != blank -%}
                      {%- render 'responsive-image', image: block.settings.author_image, sizes: '64x64' -%}
                    {%- endif -%}
                    <span>{{- block.settings.author -}}</span>
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
				{% render 'slideshow-arrows', disabled: true %}
      </theme-scroll>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Customer reviews",
  "class": "section-customer-reviews",
  "settings": [
		{
			"type": "select",
			"id": "section_width",
			"options": [
				{
					"value": "grid",
					"label": "Grid"
				},
				{
					"value": "full-width-row",
					"label": "Full width"
				}
			],
			"default": "full-width-row",
			"label": "Section width"
		},
    {
        "type": "text",
        "id": "subheading",
        "label": "Subheading",
        "default": "Add a tagline"
      },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer reviews"
    },
		{
			"type": "checkbox",
			"id": "heading_left",
			"default": false,
			"label": "Left align heading"
		},
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Add a short description for this section</p>"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Number of columns on desktop",
      "default": 5
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "disable_top_spacing",
      "default": false,
      "label": "Remove top spacing"
    },
    {
      "type": "checkbox",
      "id": "disable_bottom_spacing",
      "default": false,
      "label": "Remove bottom spacing"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Image",
          "info": "310 x 310 .jpg recommended"
        },
        {
          "type": "product",
          "id": "product_handle",
          "label": "Product"
        },
        {
          "type": "select",
          "id": "stars",
          "options": [
            { "value": "", "label": "None" },
            { "value": "3", "label": "3 out of 5" },
            { "value": "3.5", "label": "3.5 out of 5" },
            { "value": "4", "label": "4 out of 5" },
            { "value": "4.5", "label": "4.5 out of 5" },
            { "value": "5", "label": "5 out of 5" }
          ],
          "default": "",
          "label": "Star rating"
        },
        {
          "id": "heading",
          "type": "text",
          "label": "Heading",
          "default": "Review heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Add your customer review here to showcase them."
        },
        {
          "type": "header",
          "content": "Author"
        },
        {
          "id": "author",
          "type": "text",
          "label": "Name",
          "default": "Review author"
        },
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "Avatar"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer reviews",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        }
      ]
    }
  ],
  "disabled_on": {
			"groups": [
				"custom.overlay"
			]
		}
}
{% endschema %}