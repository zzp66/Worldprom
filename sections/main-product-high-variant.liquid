{{- 'product.css' | asset_url | stylesheet_tag -}}
{%- liquid
  assign first_3d_model = product.media | where: 'media_type', 'model' | first
  assign media_aspect_ratio = section.settings.media_aspect_ratio
  assign full_width = section.settings.full_width
  assign media_layout = section.settings.media_layout
  assign product_media_width = section.settings.product_media_width
  assign display_slider_pagination = section.settings.display_slider_pagination

  assign display_captions = section.settings.display_captions
  assign hide_variants = section.settings.hide_variants
  assign featured_media = product.selected_or_first_available_variant.featured_media

  assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src'

  assign sizes = '375x0,640x0,960x0,1280x0'

  assign color_option = nil
  assign active_color = nil
  assign active_color_variant = nil

  for option in product.options_with_values
    assign opt_name_down = option.name | downcase
    if opt_name_down contains 'color' or opt_name_down contains 'colour' or opt_name_down contains 'couleur' or opt_name_down contains 'farbe'
      assign color_option = option
      break
    endif
    assign color_swatches_variant_option = settings.color_swatches_variant_option | downcase | split: ', '
    if color_swatches_variant_option contains opt_name_down
      assign color_option = option
      break
    endif
  endfor

  if color_option
    for ov in color_option.values
      if ov.selected
        assign active_color = ov
        assign active_color_variant = ov.variant
        break
      endif
    endfor
    unless active_color
      assign active_color = color_option.values | first
      assign active_color_variant = active_color.variant
    endunless
  endif

  assign active_featured_media = nil
  if active_color_variant and active_color_variant.featured_media
    assign active_featured_media = active_color_variant.featured_media
  elsif featured_media
    assign active_featured_media = featured_media
  endif

  assign hv_media_count = 0
  assign active_color_label = ''
  if active_color
    assign active_color_label = active_color.name | default: active_color | append: ''
  endif
  assign color_media_srcs = '|'
  assign color_option_index = 0
  assign attachment_filter_ready = false
  if color_option
    assign color_option_index = color_option.position | minus: 1
  endif

  if color_option and active_color_label != blank
    for image in product.images
      if image.attached_to_variant?
        for v in image.variants
          assign v_color = v.options[color_option_index]
          if v_color == active_color_label
            assign color_media_srcs = color_media_srcs | append: image.src | append: '|'
            assign attachment_filter_ready = true
            break
          endif
        endfor
      endif
    endfor
  endif

  assign active_color_needle = active_color_label | downcase | strip
  assign other_color_needles = '|'
  if color_option
    for ov in color_option.values
      assign ov_label = ov.name | default: ov | append: '' | downcase | strip
      if ov_label != blank and ov_label != active_color_needle
        assign other_color_needles = other_color_needles | append: ov_label | append: '|'
      endif
    endfor
  endif
-%}
{%- if media_layout == 'thumbnails' -%}
  {%- assign slider_prefix = '-thumbnails' -%}
  {{- 'product-thumbnails.css' | asset_url | stylesheet_tag -}}
  {{ 'slideshow.js' | asset_url | preload_tag: as: 'script' }}
  {{ 'product-thumbnails.js' | asset_url | preload_tag: as: 'script' }}
{%- endif -%}
{%- if first_3d_model -%}
  <link
    id="ModelViewerStyle"
    rel="stylesheet"
    href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
    media="print"
    onload="this.media='all'"
  >
  <link
    id="ModelViewerOverride"
    rel="stylesheet"
    href="{{ 'product-model-viewer-ui.css' | asset_url }}"
    media="print"
    onload="this.media='all'"
  >
{%- endif -%}

<div class="thb-product-detail product" data-handle="{{ product.handle }}">
  <div class="row {% if full_width %}full-width-row{% endif %}">
    <div class="small-12 columns">
      <div class="product-grid-container product-grid-container--size-{{ product_media_width }} sticky-scroller--parent">
        <div
          class="sticky-scroller--compare"
          id="MediaGallery-{{ section.id }}"
          data-hide-variants="{{ hide_variants }}"
        >
          <div id="hv-media-gallery-{{ section.id }}" class="product-image-container product-image-container--{{ media_layout }}" data-hv-filter="1">
            <product-slider{{ slider_prefix }}
              id="Product-Slider"
              class="product-images product-images--{{ media_layout }}"
              data-captions="{{ display_captions }}"
              data-hide-variants="{{ hide_variants }}"
            >
              {%- liquid
                assign first_image = null
                assign image_index = -1
                assign shown_media_ids = ''
              -%}
              {%- if active_featured_media != null -%}
                {%- liquid
                  assign image_index = image_index | plus: 1
                  assign first_image = active_featured_media.preview_image
                  assign shown_media_ids = shown_media_ids | append: active_featured_media.id | append: ','
                  assign hv_media_count = hv_media_count | plus: 1
                -%}
                {%- render 'product-media',
                  product: product,
                  section: section,
                  forloop: false,
                  media: active_featured_media,
                  sizes: sizes,
                  variant_images: variant_images,
                  media_aspect_ratio: media_aspect_ratio,
                  hide_variants: false,
                  priority: 'high',
                  display_captions: display_captions
                -%}
              {%- endif -%}
              {%- for media in product.media -%}
                {%- liquid
                  assign media_id_str = media.id | append: ','
                  if shown_media_ids contains media_id_str
                    continue
                  endif

                  assign show_media = false
                  assign media_src = media.preview_image.src | default: media.src
                  assign media_haystack = media_src | append: '|' | append: media.alt | append: '|' | append: media | downcase

                  if active_color_needle != blank
                    if media_haystack contains active_color_needle
                      assign show_media = true
                      assign longer_other_match = false
                      assign active_len = active_color_needle | size
                      assign other_parts = other_color_needles | split: '|'
                      for other_needle in other_parts
                        if other_needle != blank
                          assign other_len = other_needle | size
                          if other_len > active_len and media_haystack contains other_needle
                            assign longer_other_match = true
                            break
                          endif
                        endif
                      endfor
                      if longer_other_match
                        assign show_media = false
                      endif
                    elsif attachment_filter_ready
                      assign src_key = '|' | append: media_src | append: '|'
                      if color_media_srcs contains src_key
                        assign show_media = true
                      endif
                    endif
                  elsif attachment_filter_ready
                    assign src_key = '|' | append: media_src | append: '|'
                    if color_media_srcs contains src_key
                      assign show_media = true
                    elsif variant_images contains media_src
                      assign show_media = false
                    else
                      assign show_media = true
                    endif
                  else
                    assign show_media = true
                  endif
                -%}
                {%- if show_media -%}
                  {%- liquid
                    if media.media_type == 'image'
                      assign image_index = image_index | default: 0 | plus: 1
                    endif
                    assign priority = false
                    if image_index == 0
                      assign first_image = media.preview_image
                      assign priority = 'high'
                    endif
                    assign hv_media_count = hv_media_count | plus: 1
                  -%}
                  {%- render 'product-media',
                    product: product,
                    section: section,
                    forloop: forloop,
                    media: media,
                    sizes: sizes,
                    variant_images: variant_images,
                    media_aspect_ratio: media_aspect_ratio,
                    hide_variants: false,
                    priority: priority,
                    display_captions: display_captions
                  -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if media_layout == 'thumbnails' and hv_media_count > 1 -%}
                {%- render 'slideshow-arrows' -%}
              {%- endif -%}
            </product-slider{{ slider_prefix }}>
            {%- if media_layout == 'thumbnails' -%}
              <scroll-shadow>
                <div
                  id="Product-Thumbnails"
                  class="product-thumbnail-container"
                  data-hide-variants="{{ hide_variants }}"
                >
                  {%- liquid
                    assign thumb_shown_ids = ''
                  -%}
                  {%- if active_featured_media != null -%}
                    {%- liquid
                      assign thumb_shown_ids = thumb_shown_ids | append: active_featured_media.id | append: ','
                    -%}
                    {%- render 'product-thumbnail',
                      product: product,
                      media: active_featured_media,
                      forloop: false,
                      variant_images: variant_images,
                      media_aspect_ratio: media_aspect_ratio,
                      hide_variants: false
                    -%}
                  {%- endif -%}
                  {%- for media in product.media -%}
                    {%- liquid
                      assign media_id_str = media.id | append: ','
                      if thumb_shown_ids contains media_id_str
                        continue
                      endif

                      assign show_media = false
                      assign media_src = media.preview_image.src | default: media.src
                      assign media_haystack = media_src | append: '|' | append: media.alt | append: '|' | append: media | downcase

                      if active_color_needle != blank
                        if media_haystack contains active_color_needle
                          assign show_media = true
                          assign longer_other_match = false
                          assign active_len = active_color_needle | size
                          assign other_parts = other_color_needles | split: '|'
                          for other_needle in other_parts
                            if other_needle != blank
                              assign other_len = other_needle | size
                              if other_len > active_len and media_haystack contains other_needle
                                assign longer_other_match = true
                                break
                              endif
                            endif
                          endfor
                          if longer_other_match
                            assign show_media = false
                          endif
                        elsif attachment_filter_ready
                          assign src_key = '|' | append: media_src | append: '|'
                          if color_media_srcs contains src_key
                            assign show_media = true
                          endif
                        endif
                      elsif attachment_filter_ready
                        assign src_key = '|' | append: media_src | append: '|'
                        if color_media_srcs contains src_key
                          assign show_media = true
                        elsif variant_images contains media_src
                          assign show_media = false
                        else
                          assign show_media = true
                        endif
                      else
                        assign show_media = true
                      endif
                    -%}
                    {%- if show_media -%}
                      {%- render 'product-thumbnail',
                        product: product,
                        media: media,
                        forloop: forloop,
                        variant_images: variant_images,
                        media_aspect_ratio: media_aspect_ratio,
                        hide_variants: false
                      -%}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </scroll-shadow>
            {%- else -%}
              {%- if display_slider_pagination -%}
                {%- unless hv_media_count <= 1 -%}
                  <div class="product-images-buttons no-js-hidden">
                    <button
                      type="button"
                      class="slider-button slider-button--prev"
                      name="previous"
                      aria-label="Previous"
                    >
                      {% render 'svg-icons' with 'thb-caret-left' %}
                    </button>
                    <div class="slider-counter caption">
                      <span class="slider-counter--current">1</span>
                      <span aria-hidden="true"> / </span>
                      <span class="slider-counter--total">{{ hv_media_count }}</span>
                    </div>
                    <button
                      type="button"
                      class="slider-button slider-button--next"
                      name="next"
                      aria-label="Next"
                    >
                      {% render 'svg-icons' with 'thb-caret-right' %}
                    </button>
                  </div>
                {%- endunless -%}
              {%- endif -%}
            {%- endif -%}
          </div>
        </div>
        <sticky-scroller class="product-information" id="ProductInfo-{{ section.id }}">
          <div class="product-information--inner sticky-scroller--element sticky-scroller--disabled">

            {%- assign product_form_id = 'product-form-' | append: section.id -%}
            {%- assign outline_button = false -%}
            {%- assign sizing_popup = '' -%}
            {% for block in section.blocks %}
              {%- case block.type -%}
                {%- when 'estimate_time' -%}
                  {% assign estimate_time = product.metafields.custom.estimate_time.value %}
                  {% assign production_time = estimate_time.production_time %}
                  {% assign shipping_time = estimate_time.shipping_time %}
                  {% assign expedited_time = estimate_time.expedited_time %}
                  <div
                    id="delivery-estimate"
                    class="estimate-time"
                    data-production="{{ production_time }}"
                    data-shipping="{{ shipping_time }}"
                    data-expedited="{{ expedited_time }}"
                  >
                    <div class="top-content small-hide">
                      <div class="left-icon">
                        <img
                          src="https://cdn.shopify.com/s/files/1/0742/6628/0191/files/estimate-l.png?v=1765565078"
                          alt=""
                          class="icon"
                        >
                      </div>
                      <div class="time-desc">
                        <div class="top-desc">Production time</div>
                        <hr>
                        <div class="bot-desc">{{ production_time }}</div>
                      </div>
                      <div class="mid-icon">
                        <img
                          src="https://cdn.shopify.com/s/files/1/0742/6628/0191/files/estimate-c.png?v=1765565079"
                          alt=""
                          class="icon"
                        >
                      </div>
                      <div class="time-desc">
                        <div class="top-desc">Shipping time</div>
                        <hr>
                        <div class="bot-desc">{{ shipping_time }}</div>
                      </div>
                      <div class="right-icon">
                        <img
                          src="https://cdn.shopify.com/s/files/1/0742/6628/0191/files/estimate-r.png?v=1765565078"
                          alt=""
                          class="icon"
                        >
                      </div>
                    </div>
                    <div class="mid-content">
                      <div class="icon">
                        <img
                          src="https://cdn.shopify.com/s/files/1/0742/6628/0191/files/estimate-1.png?v=1765565078"
                          alt=""
                          class="icon"
                        >
                      </div>
                      <div class="desc">
                        This item is Made-To-Order. Whether you choose a standard size or custom measurements, our staffs craft each
                        item to order.
                      </div>
                    </div>
                    <div class="bot-content">
                      <div class="icon">
                        <img
                          src="https://cdn.shopify.com/s/files/1/0742/6628/0191/files/estimate-2.png?v=1765565078"
                          alt=""
                          class="icon"
                        >
                      </div>
                      <div class="desc">
                        <p>Order Now, Expedited Shipping delivers by <span id="expedited-delivery"></span></p>
                        <p>Choose Economy Shipping for delivery by <span id="faq-delivery-time"></span></p>
                      </div>
                    </div>
                  </div>
                {%- when '@app' -%}
                  {% render block %}
                {%- when 'label' -%}
                  {%- render 'product-card-labels', product: product, block: block -%}
                {%- when 'text' -%}
                  <p class="product--text {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
                    {{- block.settings.text -}}
                  </p>
                {%- when 'custom_liquid' -%}
                  {{ block.settings.custom_liquid }}
                {%- when 'title' -%}
                  {%- assign font_family = block.settings.font_family -%}
                  <div class="product-title-container" {{ block.shopify_attributes }}>
                    <h1 class="product-title uppercase--{{ block.settings.uppercase }} {{ font_family }}-font">
                      {{ product.title }}
                    </h1>
                    <div class="product-price-container">
                      <div class="no-js-hidden" id="price-{{ section.id }}" aria-live="polite">
                        {% render 'product-price',
                          product: product,
                          use_variant: true,
                          show_badges: true,
                          show_custom_badges: block.settings.show_custom_badges
                        %}
                      </div>
                      <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}">
                        {{ product.metafields.judgeme.badge }}
                      </div>

                      {%- if section.settings.show_taxes_included != blank -%}
                        {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                          <div class="product__tax caption">
                            {%- if cart.taxes_included -%}
                              {{ 'products.product.include_taxes' | t }}
                            {%- endif -%}
                            {%- if shop.shipping_policy.body != blank -%}
                              {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                      {%- endif -%}
                    </div>
                    {%- if block.settings.show_products_rating and product.metafields.reviews.rating.value != blank -%}
                      <a class="star-rating-container" href="#shopify-product-reviews">
                        <div class="star-rating" style="--star-rating: {{ product.metafields.reviews.rating.value.rating }};"></div>
                        <span>{{ 'products.product.reviews' | t: count: product.metafields.reviews.rating_count }}</span>
                      </a>
                    {%- endif -%}
                  </div>
                {%- when 'description' -%}
                  {%- liquid
                    assign seo_text_max_height = block.settings.seo_text_max_height
                    assign seo_text_read_more = block.settings.seo_text_read_more
                    assign seo_text_read_less = block.settings.seo_text_read_less
                  -%}
                  <div {{ block.shopify_attributes }}>
                    {%- if product -%}
                      {%- render 'text-max-height',
                        no_bg: true,
                        content: product.description,
                        custom_liquid: seo_text_custom_liquid,
                        read_more: seo_text_read_more,
                        read_less: seo_text_read_less,
                        max_height: seo_text_max_height,
                        extra_class: 'product-short-description'
                      -%}
                    {%- endif -%}
                  </div>
                {%- when 'inventory_level' -%}
                  {% render 'product-inventory-notice', product: product, section: section, block: block %}
                {%- when 'variant_picker' -%}
                  {%- unless product.has_only_default_variant -%}
                    {%- liquid
                      assign is_disabled = block.settings.variant_is_disabled
                      assign picker_type = 'dropdown'
                      assign color_picker = true
                      assign color_picker_size = block.settings.color_picker_size | default: 'regular'
                      assign color_picker_use_variants = block.settings.color_picker_use_variants
                    -%}
                    <variant-selects-hv
                      id="variant-selects-{{ section.id }}"
                      class="product--variant-selects no-js-hidden"
                      data-update-url="true"
                      data-section="{{ section.id }}"
                      data-url="{{ product.url }}"
                      data-product-url="{{ product.url }}"
                      data-is-disabled="{{ is_disabled }}"
                    >
                      <div class="variations" {{ block.shopify_attributes }}>
                        {%- for option in product.options_with_values -%}
                          {%- liquid
                            assign option_name = option.name | downcase | escape
                            assign option_type = block.settings.picker_type
                            assign picker_type = option_type
                            assign swatch_count = option.values | map: 'swatch' | compact | size
                            if block.settings.color_picker
                              if option_name contains 'color' or option_name contains 'colour' or option_name contains 'couleur' or option_name contains 'farbe'
                                assign option_type = 'color'
                              endif
                              assign color_swatches_variant_option = settings.color_swatches_variant_option | downcase | split: ', '
                              if color_swatches_variant_option contains option_name
                                assign option_type = 'color'
                              endif
                            endif
                            unless block.settings.color_picker
                              assign color_picker = false
                            endunless
                            if swatch_count > 0
                              assign option_type = 'color'
                            endif
                          -%}
                          {%- liquid
                            assign option_slug = option.name | downcase
                            assign sizing_link = ''
                            assign sizing_guide_variant = block.settings.sizing_guide_variant | default: 'Size' | downcase
                          -%}
                          {%- if option_slug == sizing_guide_variant -%}
                            {%- capture sizing_link -%}
                              {%- if block.settings.sizing_guide_text != blank -%}
                                <modal-opener class="product-popup-modal__opener no-js-hidden" data-modal="#PopupModal-{{ block.id }}">
                                  <button id="ProductPopup-{{ block.id }}" class="product-popup-modal__button text-button" type="button" aria-haspopup="dialog">{{ block.settings.sizing_guide_text }}</button>
                                </modal-opener>
                              {%- endif -%}
                              {%- if block.settings.custom_sizing_guide_text != blank -%}
                                <modal-opener class="product-popup-modal__opener no-js-hidden" data-modal="#PopupModalCustom-{{ block.id }}">
                                  <button id="ProductPopupCustom-{{ block.id }}" class="product-popup-modal__button text-button" type="button" aria-haspopup="dialog">{{ block.settings.custom_sizing_guide_text }}</button>
                                </modal-opener>
                              {%- endif -%}
                            {%- endcapture -%}

                            {%- if block.settings.sizing_guide_text != blank -%}
                              {%- capture sizing_popup_default -%}
                                <modal-dialog id="PopupModal-{{ block.id }}" class="product-popup-modal">
                                  <div role="dialog" aria-label="{{ block.settings.sizing_guide_text }}" aria-modal="true" class="product-popup-modal__content" tabindex="-1">
                                    <div class="product-popup-modal__content-header">
                                      <h5>{{ block.settings.sizing_guide_page.title }}</h5>
                                      <button id="ModalClose-{{ block.id }}" type="button" class="product-popup-modal__toggle" aria-label="{{ 'accessibility.close' | t }}">{% render 'svg-icons' with 'close' %}</button>
                                    </div>
                                    <scroll-shadow>
                                      <div class="product-popup-modal__content-info">
                                        {{ block.settings.sizing_guide_page.content }}
                                      </div>
                                    </scroll-shadow>
                                  </div>
                                </modal-dialog>
                              {%- endcapture -%}
                              {%- assign sizing_popup = sizing_popup | append: sizing_popup_default -%}
                            {%- endif -%}

                            {%- if block.settings.custom_sizing_guide_text != blank -%}
                              {%- capture sizing_popup_custom -%}
                                <modal-dialog id="PopupModalCustom-{{ block.id }}" class="product-popup-modal product-popup-modal--worldprom-size-guide">
                                  <div role="dialog" aria-label="{{ block.settings.custom_sizing_guide_text }}" aria-modal="true" class="product-popup-modal__content" tabindex="-1">
                                    <div class="product-popup-modal__content-header">
                                      <h5>{{ block.settings.custom_sizing_guide_modal_title | default: block.settings.custom_sizing_guide_text }}</h5>
                                      <button id="ModalClose-Custom-{{ block.id }}" type="button" class="product-popup-modal__toggle" aria-label="{{ 'accessibility.close' | t }}">{% render 'svg-icons' with 'close' %}</button>
                                    </div>
                                    <scroll-shadow>
                                      <div class="product-popup-modal__content-info">
                                        {%- render 'sizing-guide-custom-table', block: block -%}
                                      </div>
                                    </scroll-shadow>
                                  </div>
                                </modal-dialog>
                              {%- endcapture -%}
                              {%- assign sizing_popup = sizing_popup | append: sizing_popup_custom -%}
                            {%- endif -%}
                          {%- endif -%}
                          {% render 'product-option-hv',
                            option_type: option_type,
                            color_picker_size: color_picker_size,
                            color_picker_use_variants: color_picker_use_variants,
                            product: product,
                            option: option,
                            forloop: forloop,
                            product_form_id: product_form_id,
                            sizing_link: sizing_link,
                            block: block,
                            color_option: color_option
                          %}
                        {%- endfor -%}
                      </div>
                      <script type="application/json" data-selected-variant>
                        {{ product.selected_or_first_available_variant | json }}
                      </script>
                    </variant-selects-hv>
                  {%- endunless -%}
                {%- when 'side_panel' -%}
                  <side-panel-links class="side-panel-links">
                    {%- if block.settings.side_panel_1_label != '' -%}
                      <button class="side-panel-links--link no-js-hidden" data-id="1">
                        {% render 'svg-icons-inline', icon: block.settings.side_panel_1_icon -%}
                        <span class="text-button">{{ block.settings.side_panel_1_label }}</span>
                      </button>
                    {%- endif -%}
                    {%- if block.settings.side_panel_2_label != '' -%}
                      <button class="side-panel-links--link no-js-hidden" data-id="2">
                        {% render 'svg-icons-inline', icon: block.settings.side_panel_2_icon -%}
                        <span class="text-button">{{ block.settings.side_panel_2_label }}</span>
                      </button>
                    {%- endif -%}
                    {%- if block.settings.side_panel_3_label != '' -%}
                      <button class="side-panel-links--link no-js-hidden" data-id="3">
                        {% render 'svg-icons-inline', icon: block.settings.side_panel_3_icon -%}
                        <span class="text-button">{{ block.settings.side_panel_3_label }}</span>
                      </button>
                    {%- endif -%}
                  </side-panel-links>
                  <script src="{{ 'side-panel-content-tabs.js' | asset_url }}" defer="defer"></script>
                {%- when 'buy_buttons' -%}
                  {%- assign outline_button = block.settings.outline_button -%}
                  {%- render 'product-add-to-cart',
                    product: product,
                    form: form,
                    product_form_id: product_form_id,
                    block: block,
                    pickup: true
                  -%}
                {%- when 'share' -%}
                  <div class="product--share">
                    {% render 'social-share',
                      share_label: true,
                      share_title: product.title,
                      share_permalink: product.url,
                      share_image: product.featured_image
                    %}
                    {%- if block.settings.need_help -%}
                      <modal-opener class="product-popup-modal__opener no-js-hidden" data-modal="#PopupModal-{{ block.id }}">
                        <button
                          id="ProductPopup-{{ block.id }}"
                          class="product-popup-modal__button text-button"
                          type="button"
                          aria-haspopup="dialog"
                        >
                          {% render 'svg-icons' with 'thb-need-help' -%}
                          {{- 'products.product.need_help' | t }}
                        </button>
                      </modal-opener>
                      <modal-dialog id="PopupModal-{{ block.id }}" class="product-popup-modal">
                        <div
                          role="dialog"
                          aria-label="{{ block.settings.sizing_guide_text }}"
                          aria-modal="true"
                          class="product-popup-modal__content"
                          tabindex="-1"
                        >
                          <div class="product-popup-modal__content-header">
                            <h5>{{ 'products.product.need_help' | t }}</h5>
                            <button
                              id="ModalClose-{{ block.id }}"
                              type="button"
                              class="product-popup-modal__toggle"
                              aria-label="{{ 'accessibility.close' | t }}"
                            >
                              {% render 'svg-icons' with 'close' %}
                            </button>
                          </div>
                          <scroll-shadow>
                            <div class="product-popup-modal__content-info">
                              {% form 'contact', class: form_class %}
                                <input
                                  type="hidden"
                                  name="contact[from form]"
                                  value="{{ 'products.product.need_help' | t | escape }}"
                                >
                                <input type="hidden" name="contact[product]" value="{{ product.title }}">
                                <input type="hidden" name="contact[product url]" value="{{ product.url }}">
                                {% if form.posted_successfully? %}
                                  <div class="form-notification success" role="status" aria-live="polite" tabindex="-1" autofocus>
                                    {% render 'svg-icons' with 'thb-success' %}
                                    {{ 'sections.contact.form.post_success' | t }}
                                  </div>
                                {%- elsif form.errors %}
                                  <div class="form-notification error" role="alert" tabindex="-1" autofocus>
                                    {% render 'svg-icons' with 'thb-error' %}
                                    {{ 'sections.contact.form.error_heading' | t }}
                                    {{ form.errors | default_errors }}
                                  </div>
                                {% endif %}
                                <div class="fields">
                                  <div class="field">
                                    <input
                                      type="text"
                                      id="ContactFormName"
                                      name="contact[name]"
                                      class="full"
                                      placeholder="{{ 'sections.contact.form.name' | t | escape }}"
                                    >
                                    <label for="ContactFormName">{{ 'sections.contact.form.name' | t }}</label>
                                  </div>
                                  <div class="field">
                                    <input
                                      type="email"
                                      id="ContactFormEmail"
                                      name="contact[email]"
                                      class="full"
                                      placeholder="{{ 'sections.contact.form.email' | t | escape }}"
                                      pattern="^([a-zA-Z0-9_\-\.]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([a-zA-Z0-9\-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,10})(\]?)$"
                                      required
                                    >
                                    <label for="ContactFormEmail">{{ 'sections.contact.form.email' | t }}</label>
                                  </div>
                                </div>
                                {%- if block.settings.show_phone_number -%}
                                  <div class="field">
                                    <input
                                      type="tel"
                                      id="ContactFormPhone"
                                      name="contact[phone]"
                                      class="full"
                                      placeholder="{{ 'sections.contact.form.phone' | t | escape }}"
                                    >
                                    <label for="ContactFormPhone">{{ 'sections.contact.form.phone' | t }}</label>
                                  </div>
                                {%- endif -%}
                                <div class="field">
                                  <textarea
                                    rows="10"
                                    id="ContactFormMessage"
                                    name="contact[body]"
                                    class="full"
                                    placeholder="{{ 'sections.contact.form.comment' | t | escape }}"
                                  ></textarea>
                                  <label for="ContactFormMessage">{{ 'sections.contact.form.comment' | t }}</label>
                                </div>
                                <div class="field">
                                  <button type="submit" class="button full">
                                    <span>{{ 'sections.contact.form.send' | t }}</span>
                                  </button>
                                </div>
                              {% endform %}
                            </div>
                          </scroll-shadow>
                        </div>
                      </modal-dialog>
                      <script src="{{ 'modal-dialog.js' | asset_url }}" defer="defer"></script>
                    {%- endif -%}
                  </div>
                {%- when 'specifications_tab' -%}
                  {%- if block.settings.heading != blank -%}
                    <collapsible-row class="product--accordion accordion" {{ block.shopify_attributes }}>
                      <details
                        id="Details-{{ block.id }}-{{ section.id }}"
                        {% if block.settings.open %}
                          open
                        {% endif %}
                      >
                        <summary>
                          {{ block.settings.heading | default: block.settings.page.title -}}
                          <span>{%- render 'svg-icons' with 'thb-accordion-arrow' -%}</span>
                        </summary>
                        <div
                          class="collapsible__content accordion__content rte"
                          id="ProductAccordion-{{ block.id }}-{{ section.id }}"
                        >
                          {%- render 'product-specification-table', block: block -%}
                        </div>
                      </details>
                    </collapsible-row>
                  {%- endif -%}
                {%- when 'collapsible_tab' -%}
                  {%- if block.settings.heading != blank -%}
                    <collapsible-row class="product--accordion accordion" {{ block.shopify_attributes }}>
                      <details
                        id="Details-{{ block.id }}-{{ section.id }}"
                        {% if block.settings.open %}
                          open
                        {% endif %}
                      >
                        <summary>
                          {{ block.settings.heading | default: block.settings.page.title }}
                          <span>{%- render 'svg-icons' with 'thb-accordion-arrow' -%}</span>
                        </summary>
                        <div
                          class="collapsible__content accordion__content rte"
                          id="ProductAccordion-{{ block.id }}-{{ section.id }}"
                        >
                          {{ block.settings.content }}
                          {{ block.settings.page.content }}
                          {{ block.settings.custom_liquid }}
                        </div>
                      </details>
                    </collapsible-row>
                  {%- endif -%}
                {%- when 'complementary' -%}
                  <product-recommendations
                    class="complementary-products no-js-hidden"
                    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ block.settings.product_list_limit }}&intent=complementary"
                  >
                    {%- if recommendations.performed and recommendations.products_count > 0 -%}
                      {%- if block.settings.block_heading != blank -%}
                        <div class="product--block-heading complementary-products--heading">{{ block.settings.block_heading }}</div>
                      {%- endif -%}
                      <theme-scroll class="theme-scroll theme-scroll--no-arrows">
                        <div class="theme-scroll--inner complementary-products--inner">
                          {%- for recommended_product in recommendations.products
                            limit: block.settings.product_list_limit
                            offset: continue
                          -%}
                            {%- render 'product-card-small',
                              product_small: recommended_product,
                              quick_add: true,
                              class: 'product-card-small--smaller'
                            -%}
                          {%- endfor -%}
                        </div>
                        <script src="{{ 'product-recommendations.js' | asset_url }}" defer="defer"></script>
                      </theme-scroll>
                    {%- endif -%}
                  </product-recommendations>
                {%- when 'image' -%}
                  <div class="product--image {{ block.settings.position }}" {{ block.shopify_attributes }}>
                    {%- if block.settings.image_link -%}<a href="{{ block.settings.image_link }}">{%- endif -%}
                    {% if block.settings.image %}
                      {%- liquid
                        assign image = block.settings.image
                        assign sizes = image.src.width | append: 'x' | append: image.src.height
                        render 'responsive-image', image: image, sizes: sizes
                      -%}
                    {%- else -%}
                      <div class="thb-placeholder">
                        {{ 'image' | placeholder_svg_tag: 'placeholder_svg_tag' }}
                      </div>
                    {%- endif -%}
                    {%- if block.settings.image_link -%}</a>{%- endif -%}
                  </div>
                {%- when 'icon_list' -%}
                  <div class="product--icon-list {{ block.settings.position }}" {{ block.shopify_attributes }}>
                    <ul>
                      {% assign block_setting = block.settings %}
                      {%- for index in (1..5) -%}
                        {%- capture icon_label -%}icon_{{ index }}_label{%- endcapture -%}
                        {%- capture icon_icon -%}icon_{{ index }}_icon{%- endcapture -%}
                        {%- capture icon_image -%}icon_{{ index }}_image{%- endcapture -%}
                        {%- unless block_setting[icon_label] == blank -%}
                          <li>
                            {% if block_setting[icon_image] %}
                              <span class="product--icon-list-image">
                                {%- render 'responsive-image', image: block_setting[icon_image] -%}
                              </span>
                            {%- else -%}
                              <span class="product--icon-list-image">
                                {% render 'svg-icons-inline', icon: block_setting[icon_icon] %}
                              </span>
                            {%- endif -%}
                            <span>{{ block_setting[icon_label] }}</span>
                          </li>
                        {% endunless %}
                      {%- endfor -%}
                    </ul>
                  </div>
                {% when 'custom_option' %}
                  {%- if block.settings.label != blank -%}
                    {%- liquid
                      assign line_item_input_id = product_form_id | append: '-custom-' | append: forloop.index
                      assign line_item_input_name = block.settings.label | escape | prepend: 'properties[' | append: ']'
                      assign required = block.settings.text_required
                      assign text_placeholder = block.settings.text_placeholder
                    -%}
                    <fieldset class="product-form__input product-information--line-item" {{ block.shopify_attributes }}>
                      <div class="form__label" for="{{ line_item_input_id }}">{{ block.settings.label | escape }}</div>
                      {% case block.settings.type %}
                        {% when 'text' %}
                          <input
                            class="product-information--line-item--text"
                            type="text"
                            id="{{ line_item_input_id }}"
                            form="{{ product_form_id }}"
                            name="{{ line_item_input_name }}"
                            placeholder="{{ text_placeholder }}"
                            {% if required %}
                              required
                            {% endif %}
                          >

                        {% when 'textarea' %}
                          <textarea
                            class="product-information--line-item--textarea"
                            id="{{ line_item_input_id }}"
                            form="{{ product_form_id }}"
                            name="{{ line_item_input_name }}"
                            rows="3"
                            placeholder="{{ text_placeholder }}"
                            {% if required %}
                              required
                            {% endif -%}
                          ></textarea>

                        {% when 'checkbox' %}
                          <input
                            type="hidden"
                            form="{{ product_form_id }}"
                            name="{{ line_item_input_name }}"
                            value="{{ block.settings.checkbox_unchecked_value | escape }}"
                          >
                          <input
                            type="checkbox"
                            class="custom-checkbox"
                            form="{{ product_form_id }}"
                            name="{{ line_item_input_name }}"
                            value="{{ block.settings.checkbox_checked_value | escape }}"
                            id="{{ line_item_input_id }}"
                            {% if required %}
                              required
                            {% endif %}
                          >

                        {% when 'multiple' %}
                          {%- assign custom_options = block.settings.multiple_options
                            | newline_to_br
                            | strip_newlines
                            | split: '<br />'
                          -%}

                          {% if block.settings.multiple_style == 'dropdown' %}
                            <div class="select">
                              <select name="{{ line_item_input_name }}" id="{{ line_item_input_id }}" form="{{ product_form_id }}">
                                {% for option in custom_options %}
                                  <option
                                    value="{{ option | escape }}"
                                    {% if forloop.first %}
                                      selected
                                    {% endif %}
                                  >
                                    {{ option | escape }}
                                  </option>
                                {% endfor %}
                              </select>
                              <div class="select-arrow">{%- render 'svg-icons' with 'thb-select' -%}</div>
                            </div>
                          {% else %}
                            <div>
                              {% for option in custom_options %}
                                <div class="product-information--line-item--radio">
                                  <input
                                    type="radio"
                                    form="{{ product_form_id }}"
                                    id="{{ line_item_input_id }}-{{ forloop.index0 }}"
                                    name="{{ line_item_input_name }}"
                                    value="{{ option | escape }}"
                                    {% if forloop.first %}
                                      checked
                                    {% endif %}
                                  >
                                  <label for="{{ line_item_input_id }}-{{ forloop.index0 }}">{{ option | escape }}</label>
                                </div>
                              {% endfor %}
                            </div>
                          {% endif %}
                      {% endcase %}
                    </fieldset>
                  {%- endif -%}
                {%- when 'sku' -%}
                  <div
                    class="product-sku product--text {{ block.settings.sku_style }}"
                    id="sku-{{ section.id }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ product.selected_or_first_available_variant.sku }}
                  </div>
                {%- when 'product_link' -%}
                  <a
                    href="{{ product.url }}"
                    title="{{ 'products.product.view_product_details' | t | escape }}"
                    class="text-button thb-product-detail--view-details"
                    {{ block.shopify_attributes }}
                  >
                    {{- 'products.product.view_product_details' | t -}}
                  </a>
                {%- when 'border' -%}
                  <hr class="product--line">
                {%- when 'siblings' -%}
                  {%- render 'product-siblings', product: product, product_form_id: product_form_id, block: block -%}
                {%- when 'fit_guide' -%}
                  <div
                    class="product-fit-guide"
                    style="--active-color: {{ block.settings.color_active_segment }};"
                    {{ block.shopify_attributes }}
                  >
                    {%- liquid
                      assign block_heading = block.settings.block_heading
                      assign label_active = block.settings.label_active | abs | at_most: 5 | at_least: 1
                      assign label_left = block.settings.label_left
                      assign label_middle = block.settings.label_middle
                      assign label_right = block.settings.label_right
                    -%}
                    {%- if block_heading != blank -%}
                      <div class="product--block-heading">{{ block_heading }}</div>
                    {%- endif -%}
                    <div class="product-fit-guide--lines">
                      {%- for i in (1..5) -%}
                        <div
                          class="product-fit-guide--line{% if label_active == i %} product-fit-guide--line--active{%- endif -%}"
                        ></div>
                      {%- endfor -%}
                    </div>
                    <div class="product-fit-guide--labels">
                      <div class="product-fit-guide--label-left">{{ label_left }}</div>
                      {%- if label_middle != blank -%}
                        <div class="product-fit-guide--label-middle">{{ label_middle }}</div>
                      {%- endif -%}
                      <div class="product-fit-guide--label-right">{{ label_right }}</div>
                    </div>
                    <link rel="stylesheet" href="{{ 'product-fit.css' | asset_url }}" media="print" onload="this.media='all'">
                  </div>
                {%- when 'payment_icons' -%}
                  <div class="payment-icons">
                    {%- unless shop.enabled_payment_types == empty -%}
                      {%- for type in shop.enabled_payment_types -%}
                        <figure>{{ type | payment_type_svg_tag: class: 'payment-icons__icon' }}</figure>
                      {%- endfor -%}
                    {%- endunless -%}
                  </div>
                {%- when 'flash_message' -%}
                  <flash-message
                    class="product--flash-message"
                    data-close-button="{{ block.settings.close_button }}"
                    role="alert"
                    data-id="{{ section.id }}-{{ block.id }}"
                    style="--color-body: {{ block.settings.color_text }}; --color-body-rgb: {{ block.settings.color_text.rgb | replace: ' ' , ',' }};"
                    {{ block.shopify_attributes }}
                    {% unless request.design_mode %}
                      hidden
                    {% endunless %}
                  >
                    {%- render 'svg-icons-inline', icon: block.settings.icon -%}
                    <div class="product--flash-message-content">
                      {%- if block.settings.heading != blank -%}
                        <div class="product--flash-message-heading">{{ block.settings.heading }}</div>
                      {%- endif -%}
                      {%- if block.settings.heading != blank -%}
                        <div class="rte">
                          {{ block.settings.message }}
                        </div>
                      {%- endif -%}
                    </div>
                    {%- if block.settings.close_button != 'none' -%}
                      <button class="no-js-hidden" aria-label="{{ 'general.close' | t }}">
                        {%- render 'svg-icons' with 'close' -%}
                      </button>
                    {%- endif -%}
                  </flash-message>
                  <link rel="stylesheet" href="{{ 'flash-message.css' | asset_url }}" media="print" onload="this.media='all'">
                  <script src="{{ 'flash-message.js' | asset_url }}" defer="defer"></script>
                {%- when 'number_count' -%}
                  {%- if block.settings.block_heading != blank -%}
                    <div class="product--block-heading">{{- block.settings.block_heading -}}</div>
                  {%- endif -%}
                  <div
                    class="product--number-count{% if block.settings.has_border %} product--number-count-has-border{%- endif -%}"
                    {{ block.shopify_attributes }}
                  >
                    {%- if block.settings.number_count_1 != blank and block.settings.number_text_1 != blank -%}
                      <div class="product--number-count-item">
                        {%- if block.settings.number_count_1 != blank -%}
                          <span class="product--number-count-number h2">
                            {{ block.settings.number_count_1 }}
                          </span>
                        {%- endif -%}
                        {%- if block.settings.number_text_1 != blank -%}
                          <div class="product--number-count-text">
                            {{ block.settings.number_text_1 }}
                          </div>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                    {%- if block.settings.number_count_2 != blank and block.settings.number_text_2 != blank -%}
                      <div class="product--number-count-item">
                        {%- if block.settings.number_count_2 != blank -%}
                          <span class="product--number-count-number h2">
                            {{ block.settings.number_count_2 }}
                          </span>
                        {%- endif -%}
                        {%- if block.settings.number_text_2 != blank -%}
                          <div class="product--number-count-text">
                            {{ block.settings.number_text_2 }}
                          </div>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                  <link rel="stylesheet" href="{{ 'number-count.css' | asset_url }}" media="print" onload="this.media='all'">
                {%- when 'tabbed_content' -%}
                  {{- 'tabbed-content.css' | asset_url | stylesheet_tag -}}
                  <script src="{{ 'tabbed-content.js' | asset_url }}" defer="defer"></script>
                  <tabbed-content
                    class="tabbed-content product--tabbed-content tabs-left"
                    selected-index="0"
                    {{ block.shopify_attributes }}
                  >
                    <div class="tabbed-content--scroll">
                      <div class="tabbed-content--tabs tabs-left">
                        {%- for index in (1..3) -%}
                          {%- capture tab_label_key -%}tab_label_{{ index }}{%- endcapture -%}
                          {%- if block.settings[tab_label_key] != blank -%}
                            <button class="{% if forloop.index == 1 %} active{%- endif -%}">
                              {{ block.settings[tab_label_key] }}
                            </button>
                          {%- endif -%}
                        {%- endfor -%}
                        {%- if block.settings.show_specifications_tab -%}
                          <button class="">{{ block.settings.tab_label_specifications }}</button>
                        {%- endif -%}
                      </div>
                    </div>
                    {%- for index in (1..3) -%}
                      {%- capture tab_label_key -%}tab_label_{{ index }}{%- endcapture -%}
                      {%- capture tab_content_key -%}text_{{ index }}{%- endcapture -%}
                      {%- capture tab_page_key -%}page_{{ index }}{%- endcapture -%}
                      {%- capture tab_custom_key -%}custom_liquid_{{ index }}{%- endcapture -%}
                      {%- if block.settings[tab_label_key] != blank -%}
                        <div
                          class="tabbed-content--content text-left rte{% if forloop.index == 1 %} active{%- endif -%}"
                          style="--columns: 1;"
                        >
                          {{ block.settings[tab_content_key] }}
                          {{ block.settings[tab_page_key].content }}
                          {{ block.settings[tab_custom_key] }}
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if block.settings.show_specifications_tab -%}
                      <div class="tabbed-content--content text-left" style="--columns: 1;">
                        {%- render 'product-specification-table', block: block -%}
                      </div>
                    {%- endif -%}
                  </tabbed-content>
              {%- endcase -%}
            {% endfor %}
            {%- if section.settings.enable_sticky_add_to_cart -%}
              {% render 'product-add-to-cart-sticky',
                product: product,
                media: first_image,
                color_picker: color_picker,
                picker_type: picker_type,
                form: form,
                is_disabled: is_disabled,
                outline_button: outline_button
              %}
            {%- endif -%}

            {{ sizing_popup }}
            {%- if sizing_popup != blank -%}
              <script src="{{ 'modal-dialog.js' | asset_url }}" defer="defer"></script>
            {%- endif -%}

          </div>
        </sticky-scroller>
        <script src="{{ 'sticky-scroller.js' | asset_url }}" defer="defer"></script>
      </div>
    </div>
  </div>
</div>

<div class="side-panel side-availability" id="Pickup-Availability"></div>
{%- assign side_panels = section.blocks | where: 'type', 'side_panel' -%}
{%- if side_panels.size > 0 -%}
  <script src="{{ 'side-panel-links.js' | asset_url }}" defer="defer"></script>
  <div class="side-panel product-information-drawer" id="Product-Information-Drawer" tabindex="-1">
    <div class="side-panel-inner">
      <div class="side-panel-header">
        <div class="side-panel-header--inner">
          <span class="side-panel-heading">{{ 'products.product.product_information' | t }}</span>
          <side-panel-close class="side-panel-close">{%- render 'svg-icons' with 'close' -%}</side-panel-close>
        </div>
      </div>
      <div class="side-panel-content side-panel-content--has-tabs">
        {%- assign block = side_panels[0] -%}
        <side-panel-content-tabs class="side-panel-content--tabs">
          {%- if block.settings.side_panel_1_label != '' -%}
            <button class="tab-active">{{ block.settings.side_panel_1_label }}</button>
          {%- endif -%}
          {%- if block.settings.side_panel_2_label != '' -%}
            <button>{{ block.settings.side_panel_2_label }}</button>
          {%- endif -%}
          {%- if block.settings.side_panel_3_label != '' -%}
            <button>{{ block.settings.side_panel_3_label }}</button>
          {%- endif -%}
        </side-panel-content-tabs>
        <div class="side-panel-content--inner">
          {%- if block.settings.side_panel_1_label != '' -%}
            <div class="side-panel-content--tab-panel rte tab-active">
              {{ block.settings.side_panel_1_content }}
              {{ block.settings.side_panel_1_page.content }}
            </div>
          {%- endif -%}
          {%- if block.settings.side_panel_2_label != '' -%}
            <div class="side-panel-content--tab-panel rte">
              {{ block.settings.side_panel_2_content }}
              {{ block.settings.side_panel_2_page.content }}
            </div>
          {%- endif -%}
          {%- if block.settings.side_panel_3_label != '' -%}
            <div class="side-panel-content--tab-panel rte">
              {{ block.settings.side_panel_3_content }}
              {{ block.settings.side_panel_3_page.content }}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{%- if section.settings.lightbox != blank -%}
  {% render 'photoswipe' %}
