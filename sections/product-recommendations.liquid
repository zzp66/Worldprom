{{- 'product-grid.css' | asset_url | stylesheet_tag -}}
<style>
  /* Only prevent vertical movement inside carousel, without blocking page scroll */
  .section-product-recommendations theme-scroll .theme-scroll--inner {
    overflow-y: hidden !important;
    overscroll-behavior-y: contain;
    -webkit-overflow-scrolling: touch;
  }
</style>
{%- liquid
  assign section_subheading = section.settings.subheading
  assign section_heading = section.settings.heading
  assign section_heading_left = section.settings.heading_left
  assign section_description = section.settings.description
  assign full_width = section.settings.full_width
  assign columns_desktop = section.settings.columns_desktop
  assign disable_top_spacing = section.settings.disable_top_spacing
  assign disable_bottom_spacing = section.settings.disable_bottom_spacing
  assign product_id = product.id
  if template == 'cart' and cart != empty
    assign product_id = cart.items[0].product_id
  endif

  assign columns_tablet = columns_desktop | minus: 2 | at_most: 5 | at_least: 3

  # 1. 尝试获取元字段集合
  assign coll = product.metafields.custom.recommendations_collection.value

  # 2. 如果元字段为空，尝试获取后台设置的默认集合
  if coll == blank
    assign default_handle = section.settings.collection
    assign coll = collections[default_handle]
  endif
-%}
<div class="row{% if full_width %} full-width-row{% endif %}">
  <div class="small-12 columns">
    {% if coll != blank %}
      <div
        class="custom-product-recommendations section-spacing-padding{% if disable_top_spacing %} section-spacing--disable-top{% endif %}{% if disable_bottom_spacing %} section-spacing--disable-bottom{% endif %}"
      >
        {% render 'section-header',
          section_heading: section_heading,
          section_description: section_description,
          section_heading_left: section_heading_left,
          section_subheading: section_subheading
        %}
      </div>
      <theme-scroll class="theme-scroll featured-collection__inner display-type--carousel">
        <div class="theme-scroll--inner">
          <div
            id="product-grid-{{ section.id }}"
            class="products carousel"
            style="--desktop-columns: {{ columns_desktop }}; --tablet-columns: {{ columns_tablet }};"
          >
            {% for product in coll.products limit: 10 %}
              <div class="carousel__slide">
                {% render 'product-card', product_card_product: product, index: forloop.index %}
              </div>
            {% endfor %}
          </div>
        </div>
        {% render 'slideshow-arrows', disabled: true %}
      </theme-scroll>
    {% else %}
      <product-recommendations
        class="product-recommendations section-spacing-padding{% if disable_top_spacing %} section-spacing--disable-top{% endif %}{% if disable_bottom_spacing %} section-spacing--disable-bottom{% endif %}"
        data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product_id }}&limit={{ columns_desktop }}"
      >
        {% if recommendations.performed and recommendations.products_count > 0 %}
          {% render 'section-header',
            section_heading: section_heading,
            section_description: section_description,
            section_heading_left: section_heading_left,
            section_subheading: section_subheading
          %}
          <theme-scroll class="theme-scroll featured-collection__inner display-type--carousel">
            <div class="theme-scroll--inner">
              <div
                id="product-grid-{{ section.id }}"
                class="products carousel"
                style="--desktop-columns: {{ columns_desktop }}; --tablet-columns: {{ columns_tablet }};"
              >
                {% for recommendation in recommendations.products %}
                  <div class="carousel__slide">
                    {% render 'product-card', product_card_product: recommendation, index: forloop.index %}
                  </div>
                {% endfor %}
              </div>
            </div>
            {% render 'slideshow-arrows', disabled: true %}
          </theme-scroll>
        {% endif %}
      </product-recommendations>
    {% endif %}
  </div>
</div>
{%- unless settings.cart_recommendations -%}
  <script src="{{ 'product-recommendations.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

<script>
  (function () {
    const root = document.querySelector('.section-product-recommendations');
    if (!root) return;

    // Allow vertical page scroll; only hijack when user intends horizontal swipe.
    root.querySelectorAll('theme-scroll .theme-scroll--inner').forEach((viewport) => {
      let startX = 0;
      let startY = 0;
      let lastX = 0;
      let isHorizontal = null; // null until we decide
      let scrollEl = null;
      let originalScrollBehavior = '';

      function resolveScrollEl() {
        // Prefer the element that actually scrolls horizontally (OverlayScrollbars can wrap / swap viewport behavior).
        const candidates = [
          viewport,
          viewport.querySelector('[data-overlayscrollbars-viewport]'),
          viewport.closest('[data-overlayscrollbars-viewport]'),
          viewport.closest('theme-scroll')?.querySelector('[data-overlayscrollbars-viewport]'),
          viewport.closest('theme-scroll')
        ].filter(Boolean);

        for (const el of candidates) {
          try {
            if (el.scrollWidth > el.clientWidth + 1) return el;
          } catch (err) {}
        }

        // Fallback: walk up a bit to find a horizontally scrollable container.
        let el = viewport;
        for (let i = 0; i < 4 && el; i++) {
          if (el.scrollWidth > el.clientWidth + 1) return el;
          el = el.parentElement;
        }
        return viewport;
      }

      function onStart(e) {
        const t = (e.touches && e.touches[0]) || (e.changedTouches && e.changedTouches[0]);
        if (!t) return;
        startX = lastX = t.clientX;
        startY = t.clientY;
        isHorizontal = null;
        scrollEl = resolveScrollEl();
        originalScrollBehavior = scrollEl && scrollEl.style ? scrollEl.style.scrollBehavior : '';
      }

      function onMove(e) {
        const t = (e.touches && e.touches[0]) || (e.changedTouches && e.changedTouches[0]);
        if (!t) return;

        const dxTotal = t.clientX - startX;
        const dyTotal = t.clientY - startY;

        if (isHorizontal === null) {
          // Small threshold to avoid accidental lock.
          const ax = Math.abs(dxTotal);
          const ay = Math.abs(dyTotal);
          if (ax < 6 && ay < 6) return;
          isHorizontal = ax > ay;
        }

        if (!isHorizontal) return; // let page scroll normally

        // Horizontal intent: prevent vertical "rubber band" and manually scroll X.
        e.preventDefault();
        const dx = t.clientX - lastX;
        const target = scrollEl || viewport;
        if (target && target.style) target.style.scrollBehavior = 'auto';
        if (target && typeof target.scrollBy === 'function') {
          target.scrollBy({ left: -dx, top: 0, behavior: 'auto' });
        } else if (target) {
          target.scrollLeft -= dx;
        }
        lastX = t.clientX;
      }

      function onEnd() {
        const target = scrollEl || viewport;
        if (target && target.style) {
          target.style.scrollBehavior = originalScrollBehavior || '';
        }
        scrollEl = null;
        isHorizontal = null;
      }

      viewport.addEventListener('touchstart', onStart, { passive: true });
      viewport.addEventListener('touchmove', onMove, { passive: false });
      viewport.addEventListener('touchend', onEnd, { passive: true });
      viewport.addEventListener('touchcancel', onEnd, { passive: true });

      // Desktop: don't let carousel swallow vertical wheel scrolling.
      // If the intent is vertical scroll, forward it to the page.
      viewport.addEventListener(
        'wheel',
        (e) => {
          // If this is a touch device, ignore (handled by touch listeners above).
          if (window.matchMedia && window.matchMedia('(pointer: coarse)').matches) return;

          // Shift+wheel or dominant deltaX should keep default horizontal behavior.
          const ax = Math.abs(e.deltaX || 0);
          const ay = Math.abs(e.deltaY || 0);
          if (e.shiftKey || ax > ay) return;

          // Vertical intent: scroll page and prevent the carousel from hijacking.
          e.preventDefault();
          window.scrollBy({ top: e.deltaY, left: 0, behavior: 'auto' });
        },
        { passive: false }
      );
    });
  })();
</script>
{% schema %}
{
  "name": "Product recommendations",
  "class": "section-product-recommendations",
  "settings": [
    {
      "type": "text",
      "id": "collection",
      "label": "Collection 预设",
      "default": "christmas"
    },
    {
      "type": "paragraph",
      "content": "Customize product recommendations with Search and Discovery app. [Learn more](https://help.shopify.com/en/manual/online-store/search-and-discovery/product-recommendations)."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Add a tagline"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "checkbox",
      "id": "heading_left",
      "default": false,
      "label": "Left align heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Describe your featured collection here</p>"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": true
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5,
      "label": "Number of columns on desktop"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "disable_top_spacing",
      "default": false,
      "label": "Remove top spacing"
    },
    {
      "type": "checkbox",
      "id": "disable_bottom_spacing",
      "default": false,
      "label": "Remove bottom spacing"
    }
  ],
  "disabled_on": {
    "groups": ["custom.overlay"]
  }
}
{% endschema %}
