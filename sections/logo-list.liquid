{{ 'logo-list.css' | asset_url | stylesheet_tag }}
{% liquid
	assign section_subheading = section.settings.subheading
	assign section_heading = section.settings.heading
	assign section_heading_left = section.settings.heading_left
	assign section_description = section.settings.description
	assign full_width = section.settings.full_width

	assign columns_desktop = section.settings.columns_desktop
	assign columns_mobile = section.settings.columns_mobile

	assign center_align = section.settings.center_align

	assign disable_top_spacing = section.settings.disable_top_spacing
	assign disable_bottom_spacing = section.settings.disable_bottom_spacing

	assign columns_tablet = columns_desktop | minus: 2 | at_most: 5 | at_least: 3
%}
<div
	class="logo-list logo-list--full-width-{{ full_width }} logo-list--centered-{{ center_align }} section-spacing{% if disable_top_spacing %} section-spacing--disable-top{% endif %}{% if disable_bottom_spacing %} section-spacing--disable-bottom{% endif %}"
	style="--desktop-columns: {{ columns_desktop }}; --tablet-columns: {{ columns_tablet }}; --mobile-columns: {{ columns_mobile | default: 2 }}"
>
	{% render 'section-header', section_heading: section_heading, section_description: section_description, section_subheading: section_subheading, section_heading_left: section_heading_left %}
	<theme-scroll class="theme-scroll logo-list--container" data-overlayscrollbars-initialize>
		<div class="logo-list--inner theme-scroll--inner">
		{%- for block in section.blocks -%}
	    <div class="logo-list--logo" {{ block.shopify_attributes }}>
	      {% if block.settings.link %}<a href="{{ block.settings.link | escape }}" target="_blank">{% endif %}
	        {% if block.settings.image %}
	          {% assign image = block.settings.image %}
						{% assign master_width = image.src.width | append: 'x' | append: image.src.height %}
						{%- render 'responsive-image', image: image, sizes: master_width -%}
					{% else %}
						{{ 'image' | placeholder_svg_tag: 'placeholder_svg_tag' }}
	        {% endif %}
	      {% if block.settings.link %}</a>{% endif %}
	    </div>
	  {%- endfor -%}
		</div>
	</theme-scroll>
</div>
{% schema %}
  {
    "name": "Logo list",
		"class": "section-logo-list",
    "settings": [
			{
        "type": "text",
        "id": "subheading",
        "label": "Subheading",
        "default": "Add a tagline"
      },
			{
				"type": "text",
				"id": "heading",
				"label": "Heading",
				"default": "Clients"
			},
			{
				"type": "checkbox",
				"id": "heading_left",
				"default": false,
				"label": "Left align heading"
			},
			{
				"type": "richtext",
				"id": "description",
				"label": "Description",
				"default": "<p>Add a short description for this section</p>"
			},
			{
				"type": "checkbox",
				"id": "full_width",
				"label": "Make section full width",
				"default": true
			},
			{
	      "type": "range",
	      "id": "columns_desktop",
	      "min": 2,
	      "max": 8,
	      "step": 1,
	      "default": 6,
	      "label": "Number of columns on desktop"
	    },
			{
				"type": "select",
				"id": "columns_mobile",
				"options": [
					{
						"value": "1",
						"label": "One column"
					},
					{
						"value": "2",
						"label": "Two Columns"
					},
					{
						"value": "3",
						"label": "Three Columns"
					}
				],
				"default": "2",
				"label": "Number of columns on mobile"
			},
			{
				"type": "checkbox",
				"id": "center_align",
				"label": "Center align logos",
				"default": true
			},
			{
	      "type": "header",
	      "content": "Spacing"
	    },
			{
				"type": "checkbox",
				"id": "disable_top_spacing",
				"default": false,
				"label": "Remove top spacing"
			},
			{
				"type": "checkbox",
				"id": "disable_bottom_spacing",
				"default": false,
				"label": "Remove bottom spacing"
			}
    ],
    "blocks": [
      {
        "type": "logo",
        "name": "Logo",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Logo",
						"info": "240 x 100 px .png recommended."
          },
          {
            "id": "link",
            "type": "url",
            "label": "Link",
            "info": "Select an optional link."
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Logo list",
				"blocks": [
	        {
	          "type": "logo"
	        },
	        {
	          "type": "logo"
	        },
	        {
	          "type": "logo"
	        },
	        {
	          "type": "logo"
	        },
	        {
	          "type": "logo"
	        }
	      ]
      }
    ],
		"disabled_on": {
    "groups": [
      "custom.overlay"
    ]
  }
  }
{% endschema %}
