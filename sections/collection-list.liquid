{%- liquid
	assign section_subheading = section.settings.subheading
	assign section_heading = section.settings.heading
	assign section_heading_left = section.settings.heading_left
	assign section_description = section.settings.description
	assign full_width = section.settings.full_width
	assign columns_desktop = section.settings.columns_desktop
	assign columns_mobile = section.settings.columns_mobile
	assign collections = section.settings.collection_list
	assign style = section.settings.style
	assign text_alignment = section.settings.text_alignment
	assign font_family = section.settings.font_family
	assign text_uppercase = section.settings.text_uppercase
	assign first_product_image = section.settings.first_product_image
	assign collection_product_count = section.settings.collection_product_count
	assign image_ratio = section.settings.image_ratio
	
	assign disable_top_spacing = section.settings.disable_top_spacing
	assign disable_bottom_spacing = section.settings.disable_bottom_spacing

	assign columns_tablet = columns_desktop | minus: 2 | at_most: 5 | at_least: 3
-%}
<div class="row{% if full_width %} full-width-row{% endif %}">
	<div class="small-12 columns">
		<div class="list-collections section-spacing{% if disable_top_spacing %} section-spacing--disable-top{% endif %}{% if disable_bottom_spacing %} section-spacing--disable-bottom{% endif %}" style="--desktop-columns: {{ columns_desktop }}; --tablet-columns: {{ columns_tablet }}; --mobile-columns: {{ columns_mobile | default: 2 }}">
			{% render 'section-header', section_heading: section_heading, section_description: section_description, section_heading_left: section_heading_left, section_subheading: section_subheading %}
			<theme-scroll class="theme-scroll collection-grid--container" data-overlayscrollbars-initialize>
				<div class="collection-grid collection-grid--scroll {{ text_alignment }} theme-scroll--inner {{ font_family }}-font collection-grid--uppercase-{{ text_uppercase }}">
					{% if collections.count > 0 %}
						{% for collection in collections %}
							{% render 'collection-card', grid_collection: collection, media_aspect_ratio: image_ratio, index: forloop.index, first_product_image: first_product_image, collection_product_count: collection_product_count, class: 'carousel__slide', style: style %}
						{% endfor %}
					{% else %}
						{%- for i in (1..columns_desktop) -%}
							{% render 'collection-card', grid_collection: empty, media_aspect_ratio: image_ratio, index: forloop.index, collection_product_count: collection_product_count, class: 'carousel__slide', style: style %}
						{% endfor %}
					{% endif %}
				</div>
				{% render 'slideshow-arrows', disabled: true %}
			</theme-scroll>
		</div>
	</div>
</div>
{{- 'list-collections.css' | asset_url | stylesheet_tag -}}
{% schema %}
  {
    "name": "Collection list",
	  "class": "section-collection-list",
    "settings": [
			{
				"type": "select",
				"id": "section_width",
				"options": [
					{
						"value": "grid",
						"label": "Grid"
					},
					{
						"value": "full-width-row",
						"label": "Full width"
					}
				],
				"default": "full-width-row",
				"label": "Section width"
			},
			{
        "type": "text",
        "id": "subheading",
        "label": "Subheading",
        "default": "Add a tagline"
      },
			{
				"type": "text",
				"id": "heading",
				"label": "Heading",
				"default": "Shop by category"
			},
			{
				"type": "checkbox",
				"id": "heading_left",
				"default": false,
				"label": "Left align heading"
			},
      {
        "type": "richtext",
        "id": "description",
        "label": "Description",
        "default": "<p>Section description</p>"
      },
			{
				"type": "checkbox",
				"id": "full_width",
				"label": "Make section full width",
				"default": true
			},
			{
			  "type": "collection_list",
			  "id": "collection_list",
			  "label": "Collections"
			},
			{
	      "type": "select",
	      "id": "image_ratio",
	      "options": [
	        {
	          "value": "adapt",
	          "label": "Adapt to image"
	        },
	        {
	          "value": "portrait",
	          "label": "Portrait"
	        },
	        {
	          "value": "square",
	          "label": "Square"
	        }
	      ],
	      "default": "portrait",
	      "label": "Image ratio",
	      "info": "Add images by editing your collections. [Learn more](https://help.shopify.com/en/manual/products/collections)"
	    },
			{
	      "type": "range",
	      "id": "columns_desktop",
	      "min": 2,
	      "max": 8,
	      "step": 1,
	      "default": 6,
	      "label": "Number of columns on desktop"
	    },
			{
				"type": "select",
				"id": "columns_mobile",
				"options": [
					{
						"value": "1",
						"label": "One column"
					},
					{
						"value": "2",
						"label": "Two Columns"
					},
					{
						"value": "3",
						"label": "Three Columns"
					}
				],
				"default": "2",
				"label": "Number of columns on mobile"
			},
			{
        "type": "header",
        "content": "Style"
      },
			{
				"type": "select",
				"id": "style",
				"options": [
					{
						"value": "style1",
						"label": "Underneath image"
					},
					{
						"value": "style2",
						"label": "Over image"
					}
				],
				"default": "style1",
				"label": "Style"
			},
			{
				"type": "select",
				"id": "text_alignment",
				"label": "Text alignment",
				"options": [
					{ "value": "text-center", "label": "Center" },
					{ "value": "text-left", "label": "Left" },
					{ "value": "text-right", "label": "Right" }
				],
				"default": "text-center"
			},
			{
				"type": "select",
				"id": "font_family",
				"options": [
					{
						"value": "body",
						"label": "Body"
					},
					{
						"value": "heading",
						"label": "Heading"
					}
				],
				"default": "body",
				"label": "Font family"
			},
			{
				"type": "checkbox",
				"id": "text_uppercase",
				"default": false,
				"label": "Make text uppercase"
			},
			{
				"type": "checkbox",
				"id": "first_product_image",
				"default": true,
				"label": "Use the first product image as the collection image"
			},
			{
				"type": "checkbox",
				"id": "collection_product_count",
				"default": true,
				"label": "Show product counts"
			},
			{
        "type": "header",
        "content": "Spacing"
      },
			{
				"type": "checkbox",
				"id": "disable_top_spacing",
				"default": false,
				"label": "Remove top spacing"
			},
			{
				"type": "checkbox",
				"id": "disable_bottom_spacing",
				"default": false,
				"label": "Remove bottom spacing"
			}
    ],
    "presets": [
      {
        "name": "Collection list"
      }
    ],
		"disabled_on": {
			"groups": [
				"custom.overlay"
			]
		}
  }
{% endschema %}
