<style>
  .color-swatch-box {
    width: 100%;
    margin: 60px 0;
  }
  .color-swatch-wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fill, 100px);
    gap: 40px;
  }
  .color-family {
    position: relative;
    cursor: pointer;
  }
  .color-swatch-main-box {
    height: 130px;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
  }
  .color-swatch-main {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }
  .color-swatch-main span {
    margin-top: 8px;
    font-size: 16px;
    line-height: 18px;
  }
  .color-swatch-main img,
  .color-swatch-main .swatch {
    width: 75px;
    height: 75px;
    border-radius: 50%;
    object-fit: cover;
  }
  .family-img,
  .family-swatch {
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 50%;
    transition: all 0.3s ease;
    transform: translateZ(0);
  }
  .color-family:hover .family-img,
  .color-family:hover .family-swatch {
    transform: scale(1.125);
    border: 3px solid #e5b3ac;
    padding: 3px;
  }
  .color-dropdown-box {
    display: none;
    position: absolute;
    left: 48%;
    top: 100%;
    transform: translateX(-50%);
    box-sizing: border-box;
    width: max-content;
    z-index: 99;
    margin-top: -5px;
    width: 500px;
    border-radius: 10px;
  }
  .color-family:hover .color-dropdown-box {
    display: block;
  }
  .color-dropdown-content {
    position: relative;
    text-align: center;
    padding: 20px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
    background: #f6f6f6;
    border-radius: 10px;
    -webkit-box-shadow: 0 0 4px rgba(0, 0, 0, 0.5);
    box-shadow: 0 0 4px #00000080;
    -webkit-border-radius: 10px;
    -moz-border-radius: 10px;
    -ms-border-radius: 10px;
    -o-border-radius: 10px;
  }
  .triangle-box {
    position: absolute;
    top: 0;
    left: 50%;
  }
  .triangle-box-1,
  .triangle-box-2 {
    display: block;
    position: absolute;
    background: #f6f6f6;
    box-shadow: 0 0 4px #00000080;
    width: 16px;
    height: 16px;
    -webkit-transform: rotate(-45deg);
    -ms-transform: rotate(-45deg);
    transform: rotate(-45deg);
    left: 50%;
    top: -8px;
    border-radius: 2px;
    z-index: -1;
    margin: 0;
    padding: 0;
  }
  .triangle-box-2 {
    z-index: 12;
    -webkit-clip-path: polygon(0 0, 100% 0, 100% 100%, 0 0);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 0);
  }

  .sub-color {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 6px 0;
    text-decoration: none;
    color: #333;
  }
  .sub-color .swatch {
    width: 60px;
    height: 60px;
    border-radius: 8px;
  }
  .sub-color .swatch-text {
    font-size: 14px;
    line-height: 16px;
    margin-top: 10px;
  }
</style>
<div class="row full-width-row">
  <div class="small-12 columns">
    <div class="color-swatch-box">
      <div class="color-swatch-wrapper">
        {% assign color_families = collection.metafields.custom.color_families.value %}

        {%- for family in color_families -%}
          <div class="color-family">
            <div class="color-swatch-main-box">
              <div class="color-swatch-main">
                {% if family.image != blank %}
                  <div class="family-img">
                    <img src="{{ family.image | image_url: width:100 }}" alt="{{ family.name }}">
                  </div>
                {% else %}
                  <div class="swatch" style="background:#ccc;"></div>
                {% endif %}
                <span class="swatch-text">{{ family.name }}</span>
              </div>
            </div>

            <div class="color-dropdown-box">
              <div class="color-dropdown-content">
                {% for sub in family.sub_colors.value %}
                  <a href="{{ sub.collection_link }}" class="sub-color">
                    {% if sub.image != blank %}
                      <img src="{{ sub.image | image_url: width: 80 }}" alt="{{ sub.name }}" class="swatch">
                    {% else %}
                      <span class="swatch" style="background: {{ sub.swatch_color }};"></span>
                    {% endif %}
                    <span class="swatch-text">{{ sub.name }}</span>
                  </a>
                {% endfor %}
              </div>
              <div class="triangle-box-1"></div>
              <div class="triangle-box-2"></div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Color Swatch Selector",
  "settings": [],
  "presets": [
    {
      "name": "Color Swatch Selector",
      "category": "Custom"
    }
  ]
}
{% endschema %}
