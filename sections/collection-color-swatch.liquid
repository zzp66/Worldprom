<style>
  .template-collection #shopify-section-{{ section.id }} {
    --swatch-surface-rgb: 247, 245, 243;
    display: flow-root;
    padding-bottom: 0;
    background-color: rgb(var(--swatch-surface-rgb));
  }

  .template-collection #shopify-section-{{ section.id }} + .shopify-section .facets--bar-inner {
    border-top: 0;
  }

  /* 宽度和左右留白与主题 .row + .columns 保持一致 */
  .color-swatch-scroll {
    position: relative;
    width: calc(100% - 100px);
    max-width: 1340px;
    margin: var(--swatch-margin-top, 2px) auto var(--swatch-margin-bottom, 8px);
  }

  @media (max-width: 767px) {
    .color-swatch-scroll {
      width: calc(100% - 30px);
    }
  }

  .color-swatch-scroll-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    background: rgba(255, 255, 255, 0.92);
    color: #111;
    display: none;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .color-swatch-scroll-btn:hover {
    background: #fff;
  }

  .color-swatch-scroll-btn[disabled] {
    opacity: 0.35;
    cursor: default;
    pointer-events: none;
  }

  .color-swatch-scroll-btn.is-visible {
    display: inline-flex;
  }

  .color-swatch-scroll-btn.is-left {
    left: 0;
  }

  .color-swatch-scroll-btn.is-right {
    right: 0;
  }

  /* 两侧渐隐，提示还能横向滚动 */
  .color-swatch-scroll::before,
  .color-swatch-scroll::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 42px;
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .color-swatch-scroll::before {
    left: 0;
    background: linear-gradient(to right, rgba(var(--swatch-surface-rgb, 255, 255, 255), 1), rgba(var(--swatch-surface-rgb, 255, 255, 255), 0));
  }

  .color-swatch-scroll::after {
    right: 0;
    background: linear-gradient(to left, rgba(var(--swatch-surface-rgb, 255, 255, 255), 1), rgba(var(--swatch-surface-rgb, 255, 255, 255), 0));
  }

  .color-swatch-scroll.has-left::before {
    opacity: 1;
  }

  .color-swatch-scroll.has-right::after {
    opacity: 1;
  }

  .color-swatch-mobile-hint {
    display: none;
  }

  @keyframes swatchHintNudge {
    0% {
      transform: translate(0, -50%);
      opacity: 0.85;
    }
    60% {
      transform: translate(-8px, -50%);
      opacity: 1;
    }
    100% {
      transform: translate(0, -50%);
      opacity: 0.85;
    }
  }

  .color-swatch-wrapper {
    display: flex;
    gap: var(--swatch-gap, 12px);
    overflow-x: auto;
    overflow-y: hidden;
    /* 顶部留出悬停时放大和外圈的空间，避免被裁切 */
    padding: 10px 0 4px;
    -webkit-overflow-scrolling: touch;
    justify-content: flex-start;
    align-items: flex-start;
    scroll-behavior: smooth;
    /* 给按钮留出一点可点击空间，避免盖住内容 */
    padding-left: 46px;
    padding-right: 46px;
  }

  .color-swatch-wrapper::-webkit-scrollbar {
    height: 0;
    display: none;
  }

  .color-family {
    flex: 0 0 auto;
    min-width: 80px;
    position: relative;
    cursor: pointer;
  }

  .color-family.is-disabled {
    opacity: 0.4;
    cursor: default;
  }

  .color-family-count {
    margin-left: 3px;
    color: #888;
  }

  .color-swatch-main {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: transform 0.3s ease;
  }

  .color-swatch-main .swatch-text {
    margin-top: var(--swatch-label-gap, 6px);
    font-size: 16px;
    line-height: 18px;
  }

  .color-swatch-main img,
  .color-swatch-main .swatch {
    width: var(--swatch-size, 40px);
    height: var(--swatch-size, 40px);
    border-radius: 50%;
    object-fit: cover;
  }

  .family-img,
  .family-swatch {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 50%;
    transition: all 0.3s ease;
    transform: translateZ(0);
  }

  /* 用 box-shadow 画外圈，不改变元素尺寸，文字不会跟着移动 */
  .color-family:hover .family-img,
  .color-family:hover .family-swatch,
  .color-family.is-active .family-img,
  .color-family.is-active .family-swatch {
    transform: scale(1.1);
    box-shadow: 0 0 0 3px #fff, 0 0 0 6px #e5b3ac;
  }

  /* 已筛选的色系：深色外圈；全选时再加对号 */
  .color-family.is-selected .family-img,
  .color-family.is-partial .family-img {
    box-shadow: 0 0 0 3px #fff, 0 0 0 5px #222;
  }

  .color-family.is-selected .family-img::after,
  .sub-color.is-selected::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 8px;
    height: 14px;
    border: solid #fff;
    border-width: 0 2.5px 2.5px 0;
    filter: drop-shadow(0 0 1px rgba(0, 0, 0, 0.7));
    transform: translate(-50%, -60%) rotate(45deg);
    pointer-events: none;
  }

  .color-family.is-selected .family-img::after {
    top: 50%;
  }

  /* 子颜色浮层：放在滚动容器外面，避免被 overflow 裁切；left 和小三角位置由 JS 计算 */
  .color-swatch-panel {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    /* 高于商品区吸顶筛选栏 .facets--bar-row（25），低于页头（50） */
    z-index: 30;
    width: max-content;
    max-width: 100%;
    padding: 16px 20px;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 16px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(4px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  }

  .color-swatch-panel.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  /* 指向当前色块的小三角 */
  .color-swatch-panel::before {
    content: '';
    position: absolute;
    top: -7px;
    left: var(--arrow-left, 50%);
    width: 12px;
    height: 12px;
    background: #fff;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    border-left: 1px solid rgba(0, 0, 0, 0.08);
    transform: translateX(-50%) rotate(45deg);
  }

  /* 透明桥接区，鼠标从色块移到浮层途中不会触发收起 */
  .color-swatch-panel::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 12px;
  }

  .color-swatch-panel-group {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
  }

  .color-swatch-panel-group[hidden] {
    display: none;
  }

  .color-swatch-select-all {
    flex-basis: 100%;
    font-size: 14px;
  }

  .color-swatch-select-all label {
    margin: 0;
  }

  .sub-color {
    --sub-swatch-size: 44px;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 64px;
    margin: 0;
    padding: 4px;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    text-transform: none;
    text-align: center;
    color: #333;
    cursor: pointer;
  }

  .sub-color:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .sub-color.is-selected::after {
    top: calc(4px + var(--sub-swatch-size) / 2);
  }

  .sub-color .swatch {
    display: block;
    width: var(--sub-swatch-size);
    height: var(--sub-swatch-size);
    border-radius: 10px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    object-fit: cover;
    transition: box-shadow 0.2s ease;
  }

  .sub-color:not(:disabled):hover .swatch {
    box-shadow: 0 0 0 2px #fff, 0 0 0 4px #e5b3ac;
  }

  .sub-color .swatch-text {
    margin-top: 8px;
    font-size: 14px;
    line-height: 16px;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .color-swatch-wrapper {
      gap: 25px;
      padding: 10px 0 4px;
      padding-left: 0;
      padding-right: 0;
    }

    .color-swatch-scroll-btn {
      display: none !important;
    }

    /* 移动端右滑提示：仅在还能向右滚动时出现 */
    .color-swatch-scroll.has-right:not(.hint-dismissed) .color-swatch-mobile-hint {
      display: inline-flex;
      position: absolute;
      right: 10px;
      top: 50%;
      z-index: 2;
      width: 28px;
      height: 28px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.92);
      border: 1px solid rgba(0, 0, 0, 0.12);
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
      align-items: center;
      justify-content: center;
      color: #111;
      font-size: 18px;
      line-height: 1;
      pointer-events: none;
      animation: swatchHintNudge 1.2s ease-in-out infinite;
    }

    .color-family {
      min-width: auto;
    }

    .color-swatch-panel {
      padding: 12px 14px;
      border-radius: 12px;
    }
    .color-swatch-panel-group {
      gap: 6px 10px;
    }
    .sub-color {
      --sub-swatch-size: 36px;
      min-width: 52px;
    }
    .sub-color .swatch {
      border-radius: 8px;
    }
    .sub-color .swatch-text {
      margin-top: 6px;
      font-size: 12px;
      line-height: 14px;
    }
    .color-swatch-main img,
    .color-swatch-main .swatch {
      width: var(--swatch-size-mobile, 34px);
      height: var(--swatch-size-mobile, 34px);
    }
    .color-swatch-main .swatch-text {
      font-size: 12px;
      line-height: 14px;
    }
  }
</style>

<div
  class="color-swatch-scroll"
  data-color-swatch-scroll
  style="--swatch-size: {{ section.settings.swatch_size }}px; --swatch-size-mobile: {{ section.settings.swatch_size_mobile }}px; --swatch-gap: {{ section.settings.swatch_gap }}px; --swatch-margin-top: {{ section.settings.margin_top }}px; --swatch-margin-bottom: {{ section.settings.margin_bottom }}px; --swatch-label-gap: {{ section.settings.label_gap }}px;"
>
  <button class="color-swatch-scroll-btn is-left" type="button" aria-label="Scroll left" data-dir="left">
    <span aria-hidden="true">‹</span>
  </button>
  <button class="color-swatch-scroll-btn is-right" type="button" aria-label="Scroll right" data-dir="right">
    <span aria-hidden="true">›</span>
  </button>
  <div class="color-swatch-mobile-hint" aria-hidden="true">›</div>
  <div class="color-swatch-wrapper" data-color-swatch-scroll-el>
    {%- liquid
      # 色系统一用区块设置里选的这一套，所有集合共用
      assign color_families = section.settings.color_families

      # 找到集合筛选里的颜色筛选（和左侧 Filter 的 COLOR 是同一个），色块用它的参数和值来筛选
      assign color_filter = nil
      for filter in collection.filters
        if filter.type != 'list'
          continue
        endif
        assign filter_label_down = filter.label | downcase
        assign filter_param_down = filter.param_name | downcase
        if filter_label_down contains 'color' or filter_label_down contains 'colour' or filter_param_down contains 'color'
          assign color_filter = filter
          break
        endif
      endfor
    -%}

    {% if color_families != blank %}
      {% for family in color_families %}
        <div
          class="color-family"
          data-family-index="{{ forloop.index }}"
          role="button"
          tabindex="0"
          aria-pressed="false"
        >
          <div class="color-swatch-main">
            {% if family.image != blank %}
              <div class="family-img">
                <img
                  src="{{ family.image | image_url: width: 100 }}"
                  alt="{{ family.name }}"
                  width="75"
                  height="75"
                  loading="lazy"
                >
              </div>
            {% else %}
              <div class="family-img swatch" style="background: #ccc;"></div>
            {% endif %}
            <span class="swatch-text">
              {{- family.name -}}
              <span class="color-family-count" data-family-count></span>
            </span>
          </div>
        </div>
      {% endfor %}
    {% elsif request.design_mode %}
      <p style="text-align:center;">No color families selected. Choose them in this section's settings.</p>
    {% endif %}
  </div>

  {%- if color_families != blank -%}
    <div class="color-swatch-panel" data-color-swatch-panel>
      {%- for family in color_families -%}
        {%- assign select_all_id = 'ColorSwatchSelectAll-' | append: section.id | append: '-' | append: forloop.index -%}
        <div class="color-swatch-panel-group" data-family-group="{{ forloop.index }}" hidden>
          <div class="color-swatch-select-all">
            <input type="checkbox" id="{{ select_all_id }}" data-select-all>
            <label for="{{ select_all_id }}">Select all</label>
          </div>
          {%- for sub in family.sub_colors.value -%}
            {%- liquid
              assign sub_name = sub.name.value | default: sub.name | append: '' | strip
              assign sub_key = sub_name | downcase

              # 子颜色名字要和颜色筛选里的值一致（不区分大小写），匹配不到的显示为不可选
              assign sub_filter_value = nil
              for value in color_filter.values
                assign value_key = value.label | downcase | strip
                if value_key == sub_key
                  assign sub_filter_value = value
                  break
                endif
              endfor
            -%}
            <button
              type="button"
              class="sub-color{% if sub_filter_value.active %} is-selected{% endif %}"
              {% if sub_filter_value %}
                data-param="{{ sub_filter_value.param_name | escape }}"
                data-value="{{ sub_filter_value.value | escape }}"
              {% else %}
                disabled
              {% endif %}
              aria-pressed="{% if sub_filter_value.active %}true{% else %}false{% endif %}"
            >
              {% if sub.image != blank %}
                <img
                  src="{{ sub.image | image_url: width: 100 }}"
                  alt=""
                  class="swatch"
                  width="44"
                  height="44"
                  loading="lazy"
                >
              {% else %}
                <span class="swatch" style="background: {{ sub.swatch_color }};"></span>
              {% endif %}
              <span class="swatch-text">{{ sub_name | escape }}</span>
            </button>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if request.design_mode and color_filter == nil -%}
    <p style="text-align:center; color:#c00;">
      No color filter found for this collection. Add a Color filter in Shopify Search &amp; Discovery so the swatches can
      filter products.
    </p>
  {%- endif -%}
</div>

<script>
  (() => {
    const init = () => {
      // 横向滚动控制（按钮 + 悬停自动滚动）
      document.querySelectorAll('[data-color-swatch-scroll]').forEach((root) => {
        if (root.dataset.colorSwatchScrollInited === 'true') return;
        root.dataset.colorSwatchScrollInited = 'true';

        const scroller = root.querySelector('[data-color-swatch-scroll-el]');
        const btnLeft = root.querySelector('.color-swatch-scroll-btn.is-left');
        const btnRight = root.querySelector('.color-swatch-scroll-btn.is-right');
        const panel = root.querySelector('[data-color-swatch-panel]');

        if (!scroller || !btnLeft || !btnRight) return;

        let hintDismissed = false;
        const dismissHintOnce = () => {
          if (hintDismissed) return;
          hintDismissed = true;
          root.classList.add('hint-dismissed');
        };

        const update = () => {
          const maxScrollLeft = scroller.scrollWidth - scroller.clientWidth;
          const hasOverflow = maxScrollLeft > 2;

          // 只有真的溢出才展示按钮（桌面端）
          btnLeft.classList.toggle('is-visible', hasOverflow);
          btnRight.classList.toggle('is-visible', hasOverflow);

          const hasLeft = scroller.scrollLeft > 2;
          const hasRight = scroller.scrollLeft < maxScrollLeft - 2;

          root.classList.toggle('has-left', hasLeft);
          root.classList.toggle('has-right', hasRight);

          btnLeft.disabled = !hasLeft;
          btnRight.disabled = !hasRight;
        };

        let scrollRafId = null;
        const programmaticScrollTo = (left) => {
          const maxScrollLeft = scroller.scrollWidth - scroller.clientWidth;
          const target = Math.max(0, Math.min(maxScrollLeft, left));

          // 取消进行中的动画，避免左右键互相“抢”scrollLeft（左键尤其容易失效）
          if (scrollRafId != null) {
            cancelAnimationFrame(scrollRafId);
            scrollRafId = null;
          }

          const prevSnap = scroller.style.scrollSnapType;
          scroller.style.scrollSnapType = 'none';
          const prevBehavior = scroller.style.scrollBehavior;
          scroller.style.scrollBehavior = 'auto';

          const start = scroller.scrollLeft;
          const delta = target - start;
          const duration = 320;
          const startTs = performance.now();

          const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);

          const tick = (now) => {
            const t = Math.min(1, (now - startTs) / duration);
            scroller.scrollLeft = start + delta * easeOutCubic(t);
            if (t < 1) {
              scrollRafId = requestAnimationFrame(tick);
            } else {
              scrollRafId = null;
              scroller.scrollLeft = target;
              scroller.style.scrollSnapType = prevSnap || '';
              scroller.style.scrollBehavior = prevBehavior || '';
              update();
            }
          };

          scrollRafId = requestAnimationFrame(tick);
        };

        const scrollToItem = (dir) => {
          const current = scroller.scrollLeft;
          const amount = Math.max(260, Math.floor(scroller.clientWidth * 0.8));
          const delta = dir === 'left' ? -amount : amount;
          programmaticScrollTo(current + delta);
        };

        btnLeft.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          scrollToItem('left');
        });
        btnRight.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          scrollToItem('right');
        });

        // 悬停在左右边缘自动滚动（可发现性更强，且不影响移动端）
        let raf = null;
        let vel = 0;
        const tick = () => {
          if (vel !== 0) {
            scroller.scrollLeft += vel;
            update();
          }
          raf = requestAnimationFrame(tick);
        };
        const start = () => {
          if (raf == null) raf = requestAnimationFrame(tick);
        };
        const stop = () => {
          if (raf != null) cancelAnimationFrame(raf);
          raf = null;
          vel = 0;
        };

        root.addEventListener('mousemove', (ev) => {
          // 只在桌面端启用
          if (window.matchMedia('(max-width: 768px)').matches) return;
          // 鼠标在浮层上时不触发边缘自动滚动
          if (panel && panel.contains(ev.target)) {
            vel = 0;
            return;
          }

          const rect = root.getBoundingClientRect();
          const x = ev.clientX - rect.left;
          const edge = 60;
          const maxV = 10; // px/frame

          if (x < edge) {
            vel = -Math.ceil(((edge - x) / edge) * maxV);
            start();
          } else if (x > rect.width - edge) {
            vel = Math.ceil(((x - (rect.width - edge)) / edge) * maxV);
            start();
          } else {
            vel = 0;
          }
        });
        root.addEventListener('mouseleave', stop);

        scroller.addEventListener('scroll', update, { passive: true });
        scroller.addEventListener('scroll', dismissHintOnce, { passive: true });
        scroller.addEventListener('touchstart', dismissHintOnce, { passive: true });
        scroller.addEventListener('wheel', dismissHintOnce, { passive: true });
        window.addEventListener('resize', update);
        update();

        // 子颜色浮层 + 颜色筛选：鼠标悬停展开浮层，点击色块或子颜色在当前页筛选商品
        if (!panel) return;

        const families = Array.from(root.querySelectorAll('.color-family'));
        const groupOf = (family) => panel.querySelector(`[data-family-group="${family.dataset.familyIndex}"]`);
        const optionsOf = (group) => (group ? Array.from(group.querySelectorAll('.sub-color[data-param]')) : []);

        let activeFamily = null;
        let closeTimer = null;

        const closePanel = () => {
          clearTimeout(closeTimer);
          panel.classList.remove('is-open');
          activeFamily?.classList.remove('is-active');
          activeFamily = null;
        };

        const scheduleClose = () => {
          clearTimeout(closeTimer);
          closeTimer = setTimeout(closePanel, 150);
        };

        // 浮层以色块为中心，左右不超出容器；小三角始终指向色块
        const positionPanel = () => {
          if (!activeFamily) return;
          const rootRect = root.getBoundingClientRect();
          const famRect = activeFamily.getBoundingClientRect();
          const center = famRect.left + famRect.width / 2 - rootRect.left;

          // 色块被滚出可视区域时收起
          if (center < 0 || center > rootRect.width) {
            closePanel();
            return;
          }

          const panelWidth = panel.offsetWidth;
          const left = Math.max(0, Math.min(rootRect.width - panelWidth, center - panelWidth / 2));
          const arrowLeft = Math.max(20, Math.min(panelWidth - 20, center - left));
          panel.style.left = `${left}px`;
          panel.style.setProperty('--arrow-left', `${arrowLeft}px`);
        };

        const openPanel = (family) => {
          clearTimeout(closeTimer);
          const group = groupOf(family);

          // 没有子颜色的色系不展开
          if (!group || !group.querySelector('.sub-color')) {
            closePanel();
            return;
          }

          if (activeFamily !== family) {
            activeFamily?.classList.remove('is-active');
            activeFamily = family;
            family.classList.add('is-active');
            panel.querySelectorAll('[data-family-group]').forEach((item) => {
              item.hidden = item !== group;
            });
          }

          positionPanel();
          if (activeFamily) panel.classList.add('is-open');
        };

        // 选中状态以网址里的筛选参数为准，所以和左侧 Filter 的 COLOR 始终同步
        const syncSelection = () => {
          const params = new URLSearchParams(window.location.search);

          panel.querySelectorAll('.sub-color[data-param]').forEach((option) => {
            const selected = params.getAll(option.dataset.param).includes(option.dataset.value);
            option.classList.toggle('is-selected', selected);
            option.setAttribute('aria-pressed', selected);
          });

          families.forEach((family) => {
            const group = groupOf(family);
            const options = optionsOf(group);
            const count = options.filter((option) => option.classList.contains('is-selected')).length;
            const all = options.length > 0 && count === options.length;

            family.classList.toggle('is-disabled', options.length === 0);
            family.classList.toggle('is-selected', all);
            family.classList.toggle('is-partial', count > 0 && !all);
            family.setAttribute('aria-pressed', all);

            const countEl = family.querySelector('[data-family-count]');
            if (countEl) countEl.textContent = count ? `(${count})` : '';

            const selectAll = group?.querySelector('[data-select-all]');
            if (selectAll) {
              selectAll.checked = all;
              selectAll.closest('.color-swatch-select-all').hidden = options.length === 0;
            }
          });
        };

        // 改网址里的颜色参数，交给主题自带的筛选逻辑用 AJAX 刷新商品，不跳转页面
        const applyFilters = (options, selected) => {
          const params = new URLSearchParams(window.location.search);
          options.forEach((option) => {
            const { param, value } = option.dataset;
            const rest = params.getAll(param).filter((item) => item !== value);
            params.delete(param);
            rest.forEach((item) => params.append(param, item));
            if (selected) params.append(param, value);
          });
          params.delete('page');

          const FacetFiltersForm = customElements.get('facet-filters-form');
          if (FacetFiltersForm && document.getElementById('product-grid')) {
            // 保持当前滚动位置，方便连续多选
            FacetFiltersForm.keepScrollCount = (FacetFiltersForm.keepScrollCount || 0) + 1;
            FacetFiltersForm.renderPage(params.toString());
            syncSelection();
          } else {
            // 页面上没有主题筛选脚本时，退回整页刷新
            window.location.search = params.toString();
          }
        };

        families.forEach((family) => {
          family.addEventListener('pointerenter', (e) => {
            if (e.pointerType === 'mouse') openPanel(family);
          });
          family.addEventListener('focus', () => openPanel(family));
          family.addEventListener('click', () => {
            openPanel(family);
            const options = optionsOf(groupOf(family));
            if (!options.length) return;
            // 已全选时取消这个色系，否则选中它下面所有颜色
            applyFilters(options, !family.classList.contains('is-selected'));
          });
          family.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              family.click();
            }
          });
        });

        panel.addEventListener('click', (e) => {
          const option = e.target.closest('.sub-color[data-param]');
          if (!option) return;
          applyFilters([option], !option.classList.contains('is-selected'));
        });

        panel.addEventListener('change', (e) => {
          const selectAll = e.target.closest('[data-select-all]');
          if (!selectAll) return;
          applyFilters(optionsOf(selectAll.closest('[data-family-group]')), selectAll.checked);
        });

        root.addEventListener('pointerenter', (e) => {
          if (e.pointerType === 'mouse') clearTimeout(closeTimer);
        });
        root.addEventListener('pointerleave', (e) => {
          if (e.pointerType === 'mouse') scheduleClose();
        });

        // 点击外部或按 Esc 收起
        document.addEventListener('click', (e) => {
          if (activeFamily && !root.contains(e.target)) closePanel();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closePanel();
        });

        // 左侧 Filter 改动或浏览器前进后退后，商品网格会重新渲染，这时同步色块状态
        const grid = document.getElementById('ProductGridContainer');
        if (grid) new MutationObserver(syncSelection).observe(grid, { childList: true });
        window.addEventListener('popstate', syncSelection);
        syncSelection();

        scroller.addEventListener('scroll', positionPanel, { passive: true });
        window.addEventListener('resize', positionPanel);
      });
    };

    // Shopify 主题里 section 可能在 DOMContentLoaded 之后才注入
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
    document.addEventListener('shopify:section:load', init);
  })();
</script>

