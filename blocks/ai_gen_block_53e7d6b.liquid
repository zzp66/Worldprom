{% doc %}
  @prompt
    This component serves as a button bar on website category pages, designed to guide users to other related categories. The order of the buttons is fully customizable, and users are free to adjust the number of buttons displayed per row (ranging from 1 to 16); the layout automatically adjusts to fill the entire row based on the specified count. On mobile devices, the interface utilizes a horizontal scrolling mode. The spacing between buttons, as well as the top, bottom, left, and right margins of the entire module, are all adjustable; these spacing settings can be configured independently for mobile and desktop environments. Users can select their preferred button styles and border designs, and can individually set the text and background colors for each specific button. Furthermore, the text font and font size are also fully customizable. Additionally, the button colors can be customized to change dynamically when a user hovers their mouse over them. Finally, when a user is currently browsing the category corresponding to a specific button, that button becomes disabled (non-selectable) and is highlighted using a user-defined accent color.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-nav-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.spacing_top_desktop }}px;
    padding-bottom: {{ block.settings.spacing_bottom_desktop }}px;
    padding-left: {{ block.settings.spacing_left_desktop }}px;
    padding-right: {{ block.settings.spacing_right_desktop }}px;
  }

  .ai-category-nav__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.buttons_per_row_desktop }}, 1fr);
    gap: {{ block.settings.button_gap_desktop }}px;
  }

  .ai-category-nav__button-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px 20px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    border-style: {{ block.settings.border_style }};
    border-width: {{ block.settings.border_width }}px;
    border-radius: {{ block.settings.border_radius }}px;
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    font-weight: {{ block.settings.font_family.weight }};
    font-size: {{ block.settings.font_size_desktop }}px;
    text-align: center;
    word-wrap: break-word;
  }

  .ai-category-nav__button-{{ ai_gen_id }}:not(.ai-category-nav__button--active-{{ ai_gen_id }}):hover {
    transform: translateY(-2px);
  }

  .ai-category-nav__button--active-{{ ai_gen_id }} {
    cursor: default;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-category-nav-{{ ai_gen_id }} {
      padding-top: {{ block.settings.spacing_top_mobile }}px;
      padding-bottom: {{ block.settings.spacing_bottom_mobile }}px;
      padding-left: {{ block.settings.spacing_left_mobile }}px;
      padding-right: {{ block.settings.spacing_right_mobile }}px;
    }

    .ai-category-nav__container-{{ ai_gen_id }} {
      display: flex;
      overflow-x: auto;
      gap: {{ block.settings.button_gap_mobile }}px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .ai-category-nav__container-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-category-nav__button-{{ ai_gen_id }} {
      flex-shrink: 0;
      min-width: fit-content;
      font-size: {{ block.settings.font_size_mobile }}px;
    }
  }
{% endstyle %}

<category-nav-{{ ai_gen_id }} class="ai-category-nav-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-nav__container-{{ ai_gen_id }}">
    {% for i in (1..16) %}
      {% liquid
        assign button_enabled_key = 'button_' | append: i | append: '_enabled'
        assign button_text_key = 'button_' | append: i | append: '_text'
        assign button_link_key = 'button_' | append: i | append: '_link'
        assign button_text_color_key = 'button_' | append: i | append: '_text_color'
        assign button_bg_color_key = 'button_' | append: i | append: '_bg_color'
        assign button_border_color_key = 'button_' | append: i | append: '_border_color'
        assign button_hover_text_color_key = 'button_' | append: i | append: '_hover_text_color'
        assign button_hover_bg_color_key = 'button_' | append: i | append: '_hover_bg_color'
        assign button_hover_border_color_key = 'button_' | append: i | append: '_hover_border_color'

        assign button_enabled = block.settings[button_enabled_key]
        assign button_text = block.settings[button_text_key]
        assign button_link = block.settings[button_link_key]
        assign button_text_color = block.settings[button_text_color_key]
        assign button_bg_color = block.settings[button_bg_color_key]
        assign button_border_color = block.settings[button_border_color_key]
        assign button_hover_text_color = block.settings[button_hover_text_color_key]
        assign button_hover_bg_color = block.settings[button_hover_bg_color_key]
        assign button_hover_border_color = block.settings[button_hover_border_color_key]
      %}

      {% if button_enabled and button_text != blank %}
        {% liquid
          assign is_active = false
          if button_link != blank
            assign current_url = request.path
            assign button_url = button_link | split: request.host | last
            if current_url == button_url
              assign is_active = true
            endif
          endif
        %}

        <a
          href="{{ button_link }}"
          class="ai-category-nav__button-{{ ai_gen_id }} {% if is_active %}ai-category-nav__button--active-{{ ai_gen_id }}{% endif %}"
          data-button-index="{{ i }}"
          style="
            {% if is_active %}
              color: {{ block.settings.active_text_color }};
              background-color: {{ block.settings.active_bg_color }};
              border-color: {{ block.settings.active_border_color }};
            {% else %}
              color: {{ button_text_color }};
              background-color: {{ button_bg_color }};
              border-color: {{ button_border_color }};
            {% endif %}
          "
          data-default-text-color="{{ button_text_color }}"
          data-default-bg-color="{{ button_bg_color }}"
          data-default-border-color="{{ button_border_color }}"
          data-hover-text-color="{{ button_hover_text_color }}"
          data-hover-bg-color="{{ button_hover_bg_color }}"
          data-hover-border-color="{{ button_hover_border_color }}"
        >
          {{ button_text }}
        </a>
      {% endif %}
    {% endfor %}
  </div>
</category-nav-{{ ai_gen_id }}>

<script>
  (function() {
    class CategoryNav{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.buttons = this.querySelectorAll('.ai-category-nav__button-{{ ai_gen_id }}:not(.ai-category-nav__button--active-{{ ai_gen_id }})');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.buttons.forEach((button) => {
          const defaultTextColor = button.getAttribute('data-default-text-color');
          const defaultBgColor = button.getAttribute('data-default-bg-color');
          const defaultBorderColor = button.getAttribute('data-default-border-color');
          const hoverTextColor = button.getAttribute('data-hover-text-color');
          const hoverBgColor = button.getAttribute('data-hover-bg-color');
          const hoverBorderColor = button.getAttribute('data-hover-border-color');

          button.addEventListener('mouseenter', () => {
            button.style.color = hoverTextColor;
            button.style.backgroundColor = hoverBgColor;
            button.style.borderColor = hoverBorderColor;
          });

          button.addEventListener('mouseleave', () => {
            button.style.color = defaultTextColor;
            button.style.backgroundColor = defaultBgColor;
            button.style.borderColor = defaultBorderColor;
          });
        });
      }
    }

    customElements.define('category-nav-{{ ai_gen_id }}', CategoryNav{{ ai_gen_id }});
  })();
</script>

