{%- liquid
	assign ratio = 1
	assign image_sizes = '320x0,640x0'
	if image_ratio == 'adapt'
		if article.image
			assign ratio = article.image.aspect_ratio
		endif
	elsif image_ratio == 'portrait'
		assign ratio = 1 | divided_by: 1.25
	elsif image_ratio == 'landscape'
		assign ratio = 1 | divided_by: 0.75
	endif
-%}
{%- if article -%}
<div class="blog-post">
	{%- if article.image -%}
	<figure class="featured-image aspect-ratio aspect-ratio--{{ image_ratio }}" style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;">
		<a href="{{ article.url }}" title="{{ article.title | escape }}" class="featured-image--link">
			{%- render 'responsive-image', image: article.image, sizes: image_sizes -%}		
		</a>
	</figure>
	{%- endif -%}
	<div class="blog-post--inner">
		{% if show_date %}
		<aside class="post-meta">
			{{ article.published_at | date: "%B %d %Y" }}
		</aside>
		{% endif %}
		<h5><a href="{{ article.url }}" title="{{ article.title | escape }}">{{ article.title }}</a></h5>
		{% if show_excerpt %}
		<div class="post-excerpt">
			<p>{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
		</div>
		{% endif %}
	</div>
</div>
{%- else -%}
<div class="blog-post">
	{% if show_image %}
	<figure class="featured-image aspect-ratio" style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;">
		<a href="{{ article.url }}" title="{{ article.title | escape }}" class="featured-image--link">
			<div class="thb-placeholder">
				{{ 'image' | placeholder_svg_tag }}
			</div>
		</a>
	</figure>
	{% endif %}
	<div class="blog-post--inner">
		{% if show_date %}
		<aside class="post-meta">
			{{ "today" | date: "%B %d %Y" }}
		</aside>
		{% endif %}
		<h5><a role="link" aria-disabled="true">{{ 'sections.featured_blog.onboarding_title' | t }}</a></h5>
		{% if show_excerpt %}
		<div class="post-excerpt">
			<p>{{ 'sections.featured_blog.onboarding_content' | t }}</p>
		</div>
		{% endif %}
	</div>
</div>
{%- endif -%}
