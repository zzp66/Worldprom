  {%- if measure_text != blank or block.settings.custom_sizing_guide_image != blank -%}
    <div class="worldprom-size-guide__measure">
      {%- if measure_text != blank -%}
        <div class="worldprom-size-guide__measure-text rte">
          {{ measure_text }}
        </div>
      {%- endif -%}
      {%- if block.settings.custom_sizing_guide_image != blank -%}
        <div class="worldprom-size-guide__measure-image">
          {%- render 'responsive-image', image: block.settings.custom_sizing_guide_image, sizes: '480x0' -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="worldprom-size-guide__lengths">
    <div class="worldprom-size-guide__lengths-grid">
      {%- for length_type in length_types -%}
        {%- assign index = forloop.index0 -%}
        {%- assign length_image_setting = length_images[index] -%}
        <div class="worldprom-size-guide__length-card">
          <div class="worldprom-size-guide__length-media">
            {%- case length_type -%}
              {%- when 'floor' -%}
                {%- if block.settings.custom_sizing_guide_length_floor_image != blank -%}
                  {%- render 'responsive-image',
                    image: block.settings.custom_sizing_guide_length_floor_image,
                    sizes: '240x0'
                  -%}
                {%- else -%}
                  <div class="worldprom-size-guide__length-placeholder" aria-hidden="true"></div>
                {%- endif -%}
              {%- when 'ankle' -%}
                {%- if block.settings.custom_sizing_guide_length_ankle_image != blank -%}
                  {%- render 'responsive-image',
                    image: block.settings.custom_sizing_guide_length_ankle_image,
                    sizes: '240x0'
                  -%}
                {%- else -%}
                  <div class="worldprom-size-guide__length-placeholder" aria-hidden="true"></div>
                {%- endif -%}
              {%- when 'tea' -%}
                {%- if block.settings.custom_sizing_guide_length_tea_image != blank -%}
                  {%- render 'responsive-image',
                    image: block.settings.custom_sizing_guide_length_tea_image,
                    sizes: '240x0'
                  -%}
                {%- else -%}
                  <div class="worldprom-size-guide__length-placeholder" aria-hidden="true"></div>
                {%- endif -%}
              {%- when 'knee' -%}
                {%- if block.settings.custom_sizing_guide_length_knee_image != blank -%}
                  {%- render 'responsive-image',
                    image: block.settings.custom_sizing_guide_length_knee_image,
                    sizes: '240x0'
                  -%}
                {%- else -%}
                  <div class="worldprom-size-guide__length-placeholder" aria-hidden="true"></div>
                {%- endif -%}
              {%- when 'short' -%}
                {%- if block.settings.custom_sizing_guide_length_short_image != blank -%}
                  {%- render 'responsive-image',
                    image: block.settings.custom_sizing_guide_length_short_image,
                    sizes: '240x0'
                  -%}
                {%- else -%}
                  <div class="worldprom-size-guide__length-placeholder" aria-hidden="true"></div>
                {%- endif -%}
            {%- endcase -%}
          </div>
          <p class="worldprom-size-guide__length-label">{{ length_labels[index] }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if hollow_text != blank -%}
      <div class="worldprom-size-guide__hollow rte">
        {{ hollow_text }}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .product-popup-modal--worldprom-size-guide .product-popup-modal__content {
    max-width: min(96vw, 1200px);
  }

  .worldprom-size-guide {
    color: #2e2e38;
  }

  .worldprom-size-guide__table-section {
    margin-bottom: 28px;
  }

  .worldprom-size-guide__table-title {
    margin: 0 0 12px;
    text-align: center;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #2f3340;
  }

  .worldprom-size-guide__table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid #e8e0f2;
    border-radius: 4px;
  }

  .worldprom-size-guide__table {
    width: 100%;
    min-width: 960px;
    border-collapse: separate;
    border-spacing: 0;
    text-align: center;
    font-size: 12px;
    line-height: 1.3;
    color: #2f3340;
  }

  .worldprom-size-guide__table th,
  .worldprom-size-guide__table td {
    padding: 8px 5px;
    border-right: 1px solid #f4effa;
    border-bottom: 1px solid #f4effa;
    white-space: nowrap;
  }

  .worldprom-size-guide__table thead th {
    background: #b3a6cc;
    font-weight: 700;
    vertical-align: middle;
  }

  .worldprom-size-guide__table thead tr:nth-child(2) th {
    font-weight: 500;
    background: #b7abcd;
    font-size: 11px;
  }

  .worldprom-size-guide__table tbody td {
    background: #f2ebf8;
    font-weight: 400;
  }

  .worldprom-size-guide__table tbody td:first-child {
    font-weight: 700;
    position: sticky;
    left: 0;
    z-index: 1;
    background: #ebe2f9;
    box-shadow: 1px 0 0 #f4effa;
  }

  .worldprom-size-guide__measure {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(200px, 280px);
    gap: 24px;
    align-items: center;
    margin-bottom: 30px;
  }

  .worldprom-size-guide__measure-text > *:last-child {
    margin-bottom: 0;
  }

  .worldprom-size-guide__measure-text li {
    margin-bottom: 14px;
  }

  .worldprom-size-guide__measure-text li:last-child {
    margin-bottom: 0;
  }

  .worldprom-size-guide__measure-image img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 6px;
  }

  .worldprom-size-guide__lengths-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 24px;
  }

  .worldprom-size-guide__length-card {
    text-align: center;
  }

  .worldprom-size-guide__length-media {
    margin-bottom: 8px;
  }

  .worldprom-size-guide__length-media img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
  }

  .worldprom-size-guide__length-placeholder {
    aspect-ratio: 3 / 5;
    background: linear-gradient(180deg, #f2ebf8 0%, #e8dff0 100%);
    border-radius: 4px;
  }

  .worldprom-size-guide__length-label {
    margin: 0;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.3;
    color: #4a4f5c;
  }

  .worldprom-size-guide__hollow {
    margin: 0 auto;
    font-size: 14px;
    line-height: 1.55;
  }
  .worldprom-size-guide__hollow p {
    margin: 0;
  }

  .worldprom-size-guide__hollow p strong{
    font-size: 16px;
    font-weight: bold;
    color: #b3a6cc;
  }

  .worldprom-size-guide__hollow > *:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 989px) {
    .worldprom-size-guide__lengths-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 767px) {
    .worldprom-size-guide__table-title {
      font-size: 16px;
    }

    .worldprom-size-guide__table {
      font-size: 10px;
      min-width: 880px;
    }

    .worldprom-size-guide__table th,
    .worldprom-size-guide__table td {
      padding: 6px 4px;
    }

    .worldprom-size-guide__measure {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-bottom: 24px;
    }

    .worldprom-size-guide__measure-image {
      max-width: 280px;
      margin: 0 auto;
    }

    .worldprom-size-guide__lengths-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .worldprom-size-guide__length-label {
      font-size: 10px;
    }

    .worldprom-size-guide__hollow {
      font-size: 13px;
      text-align: left;
    }
  }

  @media screen and (max-width: 479px) {
    .worldprom-size-guide__lengths-grid {
      display: flex;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      gap: 12px;
      padding-bottom: 4px;
      scroll-snap-type: x mandatory;
