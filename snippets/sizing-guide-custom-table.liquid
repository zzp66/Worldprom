<div class="sizing-guide-custom">
  {%- if block.settings.custom_sizing_guide_richtext != blank or block.settings.custom_sizing_guide_image != blank -%}
    <div class="sizing-guide-custom__intro{% if block.settings.custom_sizing_guide_image == blank %} sizing-guide-custom__intro--full{%- endif -%}">
      {%- if block.settings.custom_sizing_guide_richtext != blank -%}
        <div class="sizing-guide-custom__text rte">
          {{ block.settings.custom_sizing_guide_richtext }}
        </div>
      {%- endif -%}
      {%- if block.settings.custom_sizing_guide_image != blank -%}
        <div class="sizing-guide-custom__image">
          {%- render 'responsive-image', image: block.settings.custom_sizing_guide_image, sizes: '420x0' -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="sizing-guide-custom__table-wrap">
    <table class="sizing-guide-custom__table" role="table">
      <thead>
