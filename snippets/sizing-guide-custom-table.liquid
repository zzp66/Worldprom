{%- liquid
  assign measure_text = block.settings.custom_sizing_guide_measure_richtext
  if measure_text == blank
    assign measure_text = block.settings.custom_sizing_guide_richtext
  endif

  assign hollow_text = block.settings.custom_sizing_guide_hollow_richtext
  if hollow_text == blank
    assign hollow_text = '<p><strong>Hollow to Hem (Without Heels)</strong></p><p>Stand straight barefoot.</p><p>Measure vertically from the hollow at the base of your neck straight down to the floor along the front of your body.</p><p>This measurement excludes shoe and heel height.</p>'
  endif

  assign length_types = 'floor,ankle,tea,knee,short' | split: ','
  assign length_labels = 'Floor Length,Ankle Length,Tea Length,Knee Length,Short & Mini Length' | split: ','
-%}

