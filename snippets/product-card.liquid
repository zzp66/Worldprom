{%- liquid
  assign index_c = index | default: 1 | modulo: 4 | plus: 1
-%}
{%- if product_card_product and product_card_product != empty -%}
  {%- liquid
    assign products_hover_images = settings.products_hover_images
    assign products_hover_images_count = settings.products_hover_images_count
    assign featured_media = product_card_product.featured_media
    assign sizes = '375x0,770x0'
    assign is_video = false
    assign use_video = settings.products_use_video
    assign hv_color_match = false
    assign hv_collection = collection
    if collection_context != blank
      assign hv_collection = collection_context
    endif
    assign hv_card_url = product_card_product.url
    if hv_collection != blank
      assign hv_card_url = product_card_product.url | within: hv_collection
    endif
    assign hv_matched_color_name = ''
    assign hv_matched_option_value = nil
    assign hv_matched_variant = nil

    assign is_hv_card_product = false
    assign hv_card_suffix = product_card_product.template_suffix | default: '' | downcase
    if hv_card_suffix contains 'high-variant'
      assign is_hv_card_product = true
    endif

    if hv_collection != blank and is_hv_card_product
      assign col_handle = hv_collection.handle | default: '' | downcase | strip
      assign col_title_down = hv_collection.title | default: '' | downcase | strip
      assign col_title_handle = hv_collection.title | default: '' | downcase | handleize
      assign col_hay = '-' | append: col_handle | append: '-' | append: col_title_handle | append: '-'
      assign col_title_hay = ' ' | append: col_title_down | append: ' '
      assign hv_best_len = 0

      for option in product_card_product.options_with_values
        assign opt_name_down = option.name | downcase
        assign is_color_option = false
        if opt_name_down contains 'color' or opt_name_down contains 'colour' or opt_name_down contains 'couleur' or opt_name_down contains 'farbe'
          assign is_color_option = true
        endif
        assign color_swatches_variant_option = settings.color_swatches_variant_option | downcase | split: ', '
        if color_swatches_variant_option contains opt_name_down
          assign is_color_option = true
        endif

        unless is_color_option
          continue
        endunless

        for option_value in option.values
          assign ov_name = option_value.name | default: option_value | append: ''
          assign ov_down = ov_name | downcase | strip
          assign ov_handle = ov_down | handleize
          assign ov_len = ov_handle | size
          if ov_handle == blank or ov_len < 2 or ov_len <= hv_best_len
            continue
          endif

          assign matched = false
          if ov_handle == col_handle or ov_handle == col_title_handle or ov_down == col_title_down
            assign matched = true
          endif

          unless matched
            assign ov_token = '-' | append: ov_handle | append: '-'
            if col_hay contains ov_token
              assign matched = true
            endif
          endunless

          unless matched
            assign ov_spaced = ' ' | append: ov_down | append: ' '
            if col_title_hay contains ov_spaced
              assign matched = true
            endif
          endunless

          if matched
            assign hv_best_len = ov_len
            assign hv_color_match = true
            assign hv_matched_option_value = option_value
            assign hv_matched_color_name = ov_down
            assign hv_matched_variant = option_value.variant
          endif
        endfor

        if hv_color_match
          break
        endif
      endfor
    endif

    if hv_matched_option_value
      assign ov_handle = hv_matched_color_name | handleize
      assign ov_compact = ov_handle | remove: '-'
      assign ov_underscore = ov_handle | replace: '-', '_'
      assign featured_ok = false

      if hv_matched_variant and hv_matched_variant.featured_media
        assign fm_src = hv_matched_variant.featured_media.preview_image.src | default: hv_matched_variant.featured_media.src | default: '' | downcase
        if fm_src contains ov_compact or fm_src contains ov_handle or fm_src contains ov_underscore
          assign featured_media = hv_matched_variant.featured_media
          assign featured_ok = true
        endif
      endif

      unless featured_ok
        for media in product_card_product.media
          assign media_src = media.preview_image.src | default: media.src | default: ''
          assign media_alt = media.alt | default: '' | downcase
          assign media_src_down = media_src | downcase
          if media_alt contains '#shared' or media_src_down contains 'shared'
            continue
          endif
          assign media_hit = false
          if ov_compact != blank
            if media_src_down contains ov_compact
              assign media_hit = true
            endif
            if media_src_down contains ov_handle
              assign media_hit = true
            endif
            if media_src_down contains ov_underscore
              assign media_hit = true
            endif
            if media_alt contains hv_matched_color_name
              assign media_hit = true
            endif
          endif
          if media_hit
            assign featured_media = media
            assign featured_ok = true
            break
          endif
        endfor
      endunless

      unless featured_ok
        for image in product_card_product.images
          assign image_src = image.src | default: '' | downcase
          assign image_alt = image.alt | default: '' | downcase
          if image_alt contains '#shared' or image_src contains 'shared'
            continue
          endif
          assign image_hit = false
          if ov_compact != blank
            if image_src contains ov_compact
              assign image_hit = true
            endif
            if image_src contains ov_handle
              assign image_hit = true
            endif
            if image_src contains ov_underscore
              assign image_hit = true
            endif
            if image_alt contains hv_matched_color_name
              assign image_hit = true
            endif
          endif
          if image_hit
            assign featured_media = image
            assign featured_ok = true
            break
          endif
        endfor
      endunless

      unless featured_ok
        if hv_matched_variant and hv_matched_variant.featured_media
          assign featured_media = hv_matched_variant.featured_media
        endif
      endunless

      if hv_matched_option_value.id
        if hv_card_url contains '?'
          assign hv_card_url = hv_card_url | append: '&option_values=' | append: hv_matched_option_value.id
        else
          assign hv_card_url = hv_card_url | append: '?option_values=' | append: hv_matched_option_value.id
        endif
      endif
    endif

    if featured_media.media_type != 'image'
      if featured_media.media_type == 'video' and use_video
        assign is_video = true
        assign featured_media = featured_media
      else
        assign featured_media = featured_media.preview_image
      endif
    endif
    assign product_content_alignment = settings.product_content_alignment

    assign is_purchasable = false
    if product_card_product.available and product_card_product.variants.size == 1
      assign is_purchasable = true
    endif

    # Product card options
    assign show_size_options = settings.show_size_options
    assign size_options_variant_name = settings.size_options_variant_name
    for option in product_card_product.options_with_values
      if option.name == size_options_variant_name
        assign has_size_option = true
      endif
    endfor

    # Has review
    if settings.show_products_vendor and product_card_product.vendor
      assign vendor_displayed = true
    endif
    if settings.show_products_rating and product_card_product.metafields.reviews.rating.value != blank
      assign has_review = true
    endif

    # Product card image options
    assign product_image_fit = settings.product_image_fit
  -%}
  <product-card class="product-card text-{{ product_content_alignment }}"{% if hv_matched_color_name != blank %} data-hv-collection-color="{{ hv_matched_color_name | escape }}"{% endif %}>
    <div class="product-card--image-wrapper">
      <a
        href="{{ hv_card_url }}"
        title="{{ product_card_product.title | escape }}"
        class="product-card--image-link"
      ></a>
      <div class="product-card--image product-card--image--{{ product_image_fit }}">
        <div class="product-card--image-inner" style="--ratio-percent: 150%;">
          {%- if featured_media -%}
            <figure class="aspect-ratio aspect-ratio--adapt product-card--image-primary">
              {%- if is_video and use_video -%}
                {{
                  featured_media
                  | video_tag:
                    controls: false,
                    loading: 'lazy',
                    loop: true,
                    autoplay: true,
                    image_size: '770x',
                    class: 'product-primary-image'
                }}
              {%- else -%}
                {%- render 'responsive-image', class: 'product-primary-image', image: featured_media, sizes: sizes -%}
              {%- endif -%}
            </figure>
          {%- else -%}
            <figure class="aspect-ratio aspect-ratio--adapt">
              <div class="thb-placeholder">
                {{ 'product-apparel-' | append: index_c | placeholder_svg_tag }}
              </div>
            </figure>
          {%- endif -%}
          {%- if products_hover_images and product_card_product.images.size > 1 -%}
            {%- for i in (1..products_hover_images_count) -%}
              {%- if product_card_product.images[i] -%}
                <figure class="aspect-ratio aspect-ratio--adapt">
                  {%- render 'responsive-image',
                    class: 'product-secondary-image',
                    image: product_card_product.images[i],
                    sizes: sizes,
                    priority: 'low',
                    defer: true
                  -%}
                </figure>
              {%- endif -%}
            {%- endfor %}
          {%- endif -%}
        </div>
      </div>
      {%- if products_hover_images and product_card_product.images.size > 1 -%}
        <div class="product-card--nav-container">
          <button class="product-card--nav product-card--nav-prev" tabindex="0" aria-label="Previous" name="prev">
            {%- render 'svg-icons' with 'carousel-prev' -%}
          </button>
          <button class="product-card--nav product-card--nav-next" tabindex="0" aria-label="Next" name="next">
            {%- render 'svg-icons' with 'carousel-next' -%}
          </button>
        </div>
      {%- endif -%}
      {%- if settings.enable_quick_add -%}
        {%- liquid
          assign button_tag = 'button'
          if product_card_product.selected_or_first_available_variant.available == false
            assign button_content = 'products.product.sold_out' | t
            assign button_tag = 'div'
          else
            if product_card_product.metafields.theme.preorder and product_card_product.available
              assign button_content = 'products.product.pre_order' | t
            else
              if is_purchasable
                assign button_content = 'products.product.add_to_cart' | t
              else
                assign button_content = 'products.product.choose_options' | t
              endif
            endif

            unless is_purchasable
              assign button_tag = 'quick-view'
            endunless

            if has_size_option and show_size_options
              assign button_tag = 'div'
            endif
          endif
        -%}
        <{{ button_tag }}
          class="product-card--quickview product-card--add-to-cart-button{% if is_purchasable %} product-card--add-to-cart-button-simple{% endif %}"
          data-product-id="{{ product_card_product.selected_or_first_available_variant.id }}"
          data-product-handle="{{ product_card_product.handle }}"
        >
          <div class="loading-overlay">{% render 'svg-icons' with 'thb-loading' %}</div>
          {%- if show_size_options and has_size_option -%}
            {%- render 'product-card-size-options', product_card_product: product_card_product -%}
          {%- endif -%}
          <span class="product-card--quickview-text">{{ button_content }}</span>
        </{{ button_tag }}>
      {%- endif -%}
    </div>
    <div class="product-card-info">
      {%- if vendor_displayed -%}
        <div class="product-card-text-with-review product-card-vendor">
          <a
            href="{{ product_card_product.vendor | url_for_vendor }}"
            title="{{ product_card_product.vendor | escape }}"
          >
            {{- product_card_product.vendor -}}
          </a>
          {% comment %}
            {%- if has_review -%}
              <div
                class="star-rating simple"
                style="--star-rating: {{ product_card_product.metafields.reviews.rating.value.rating }};"
              >
                <span class="body-font">
                  {{- product_card_product.metafields.reviews.rating.value.rating | round: 2 -}}
                </span>
              </div>
            {%- endif -%}
          {% endcomment %}
        </div>
      {%- endif -%}
      {%- if settings.show_products_subtitle and product_card_product.metafields.descriptors.subtitle != blank -%}
        <div class="product-card-subtitle-row">
          <p class="product-card-subtitle">{{ product_card_product.metafields.descriptors.subtitle }}</p>
          {% render 'product-card-badge', product_card_product: product_card_product %}
        </div>
      {%- endif -%}
      <div class="product-card-text-with-review">
        <a
          href="{{ hv_card_url }}"
          title="{{ product_card_product.title | escape }}"
          class="product-card-title"
        >
          {{- product_card_product.title -}}
        </a>
        {%- unless vendor_displayed -%}
          {%- comment -%}
            {%- if has_review -%}
              <div
                class="star-rating simple"
                style="--star-rating: {{ product_card_product.metafields.reviews.rating.value.rating }};"
              >
                <span class="body-font">
                  {{- product_card_product.metafields.reviews.rating.value.rating | round: 2 -}}
                </span>
              </div>
            {%- endif -%}
          {%- endcomment -%}
        {%- endunless -%}
      </div>

      {% render 'product-price', product: product_card_product %}

      {% render 'product-card-siblings', product: product_card_product %}

      <!-- Start of Judge.me code -->
      <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product_card_product.id }}">
        {{ product_card_product.metafields.judgeme.badge }}
      </div>
      <!-- End of Judge.me code -->

      {% comment %}
        {%- if has_review -%}
          <div
            class="star-rating star-rating--mobile simple"
            style="--star-rating: {{ product_card_product.metafields.reviews.rating.value.rating }};"
          >
            <span class="body-font">{{ product_card_product.metafields.reviews.rating.value.rating | round: 2 }}</span>
          </div>
        {%- endif -%}
      {% endcomment %}
      {%- render 'product-card-swatch', product: product_card_product, sizes: sizes -%}
      {%- render 'product-card-labels', product: product_card_product -%}
    </div>
  </product-card>
{%- else -%}
  <product-card class="product-card">
    <div class="product-card--image-wrapper">
      <a
        href="{{ product_card_product.url | within: collection }}"
        title="{{ product_card_product.title | escape }}"
        class="product-card--image-link"
      ></a>
      <div class="product-card--image">
        <div class="product-card--image-inner" style="--ratio-percent: 150%;">
          <figure class="aspect-ratio aspect-ratio--adapt product-card--image-primary">
            <div class="thb-placeholder">
              {{ 'product-apparel-' | append: index_c | placeholder_svg_tag }}
            </div>
          </figure>
        </div>
      </div>
      {%- if settings.enable_quick_add -%}
        <button
          class="product-card--quickview"
          data-product-handle="{{ product_card_product.handle }}"
          tabindex="-1"
          disabled
        >
          <div class="loading-overlay">{% render 'svg-icons' with 'thb-loading' %}</div>
          <span>{{ 'products.product.quick_view' | t }}</span>
        </button>
      {%- endif -%}
    </div>
    <div class="product-card-info">
      {%- if settings.show_products_vendor -%}
        <div class="product-card-text-with-review product-card-vendor">
          <a href="#" title="{{ 'onboarding.product_vendor' | t }}">{{ 'onboarding.product_vendor' | t }}</a>
          {%- if has_review -%}
            <div class="star-rating simple" style="--star-rating: 5.0;"><span class="body-font">5.0</span></div>
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="product-card-text-with-review">
        <a href="#" title="{{ product_card_product.title | escape }}" class="product-card-title">
          {{- 'onboarding.product_title' | t -}}
        </a>
        {%- unless settings.show_products_vendor -%}
          {%- if has_review -%}
            <div class="star-rating simple" style="--star-rating: 5.0;"><span class="body-font">5.0</span></div>
          {%- endif -%}
        {%- endunless -%}
      </div>
      {% render 'product-price', product: product_card_product %}
      {%- if has_review -%}
        <div class="star-rating star-rating--mobile simple" style="--star-rating: 5.0;">
          <span class="body-font">5.0</span>
        </div>
      {%- endif -%}
    </div>
  </product-card>
{%- endif -%}
