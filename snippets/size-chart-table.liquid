    function extractChartSource(raw) {
      if (raw == null || raw === '') return '';
      if (typeof raw === 'object') {
        if (Array.isArray(raw)) {
          return extractChartSource(raw[0]);
        }
        return raw.handle || (raw.system && raw.system.handle) || raw.label || raw.name || '';
      }
      return String(raw);
    }

    function toChartSlug(source) {
      return String(source)
        .toLowerCase()
        .trim()
        .replace(/\s+/g, '_')
        .replace(/-+/g, '_')
        .replace(/^gid:\/\/shopify\/[^/]+\//, '')
        .replace(/[^a-z0-9_]/g, '');
    }

    function resolveChartTypeFromSource(source) {
      if (!source || source === 'default') return null;

      const slug = toChartSlug(source);
      if (!slug) return null;

      if (CHART_TYPE_ALIASES[slug]) return CHART_TYPE_ALIASES[slug];
      if (sizeChartProfiles[slug]) return slug;

      if (slug.includes('floor') && slug.includes('length')) return 'dress';
      if (slug.includes('ankle')) return 'ankle_length';
      if (slug.includes('tea') || slug.includes('midi')) return 'tea_length';
      if (slug.includes('knee')) return 'knee_length';
      if (slug.includes('short') || slug.includes('mini')) return 'short_skirt';
      if (slug.includes('maxi')) return 'dress';

      return null;
    }

    function normalizeChartTypeKey(raw) {
      const fromLiquid = {{ length_type_key | json }};
      const candidates = [];

      if (raw != null && raw !== '') candidates.push(raw);
      if (fromLiquid) candidates.push(fromLiquid);

      if (lengthTypeMetafieldValue) {
        if (Array.isArray(lengthTypeMetafieldValue)) {
          lengthTypeMetafieldValue.forEach(function (item) {
            candidates.push(item);
          });
        } else {
          candidates.push(lengthTypeMetafieldValue);
        }
      }

      for (let i = 0; i < candidates.length; i++) {
        const resolved = resolveChartTypeFromSource(extractChartSource(candidates[i]));
        if (resolved) return resolved;
      }

      // 未配置裙长 metafield 或无法映射时不显示尺码表，避免信息错误
      return null;
    }

    const PLUS_SIZE_ALIASES = [
      ['US16W', 'US16'],
      ['US18W', 'US18'],
      ['US20W', 'US20'],
      ['US22W', 'US22'],
      ['US24W', 'US24'],
      ['US26W', 'US26']
    ];

    function normalizeSizeKey(sizeRaw) {
      return String(sizeRaw)
        .toUpperCase()
        .trim()
        .replace(/\s+/g, '')
        .replace(/[^A-Z0-9]/g, '');
    }

    function buildNormalizedLookup(table) {
      const normalized = {};
      Object.keys(table).forEach(function (key) {
        normalized[normalizeSizeKey(key)] = table[key];
      });
      PLUS_SIZE_ALIASES.forEach(function (pair) {
        const wKey = normalizeSizeKey(pair[0]);
        const srcKey = normalizeSizeKey(pair[1]);
        if (normalized[srcKey] && !normalized[wKey]) {
          normalized[wKey] = normalized[srcKey];
        }
      });
      return normalized;
    }

    const scriptEl = document.currentScript;
    const wrapper = scriptEl && scriptEl.previousElementSibling?.classList?.contains('variant-size-table-wrapper')
      ? scriptEl.previousElementSibling
      : document.querySelector('.variant-size-table-wrapper');

    if (!wrapper) return;

    const rows = Array.from(wrapper.querySelectorAll('.variant-row'));

    function hideAll() {
      rows.forEach(function (r) {
        r.style.display = 'none';
      });
      wrapper.classList.add('hidden');
    }

    const activeChartType = normalizeChartTypeKey(wrapper.dataset.sizeChartType);
    const activeSizeTable = activeChartType ? sizeChartProfiles[activeChartType] : null;

    if (!activeSizeTable) {
      hideAll();
      return;
    }

    wrapper.classList.remove('hidden');

    const normalizedSizeTable = buildNormalizedLookup(activeSizeTable);

    const productOptions = {{ product.options | json }};
    const sizeIndex = (productOptions || []).findIndex(function (opt) {
      return String(opt).toLowerCase() === 'size';
    });
    const sizeValues = rows.map(function (r) {
      return r.dataset.size;
    });
    let currentUnit = 'cm';

    function formatCmValue(value) {
      const num = Number(value);
      if (!Number.isFinite(num)) return value;
      return Number.isInteger(num) ? num : num.toFixed(1);
    }

    function lookupSizeData(sizeRaw, unit) {
      const row = normalizedSizeTable[normalizeSizeKey(sizeRaw)];
      if (!row) return null;

      const data = row[unit];
      if (!data) return null;

      if (unit === 'cm') {
        return {
          bust: formatCmValue(data.bust),
          waist: formatCmValue(data.waist),
          hip: formatCmValue(data.hip),
          length: formatCmValue(data.length)
        };
      }

      return data;
    }

    function renderTable(unit) {
      rows.forEach(function (row) {
        const size = row.dataset.size;
        const d = lookupSizeData(size, unit);
        if (d) {
          row.querySelector('.bust').textContent = d.bust;
          row.querySelector('.waist').textContent = d.waist;
          row.querySelector('.hip').textContent = d.hip;
          row.querySelector('.length').textContent = d.length;
        } else {
          row.querySelectorAll('td:not(:first-child)').forEach(function (td) {
            td.textContent = '-';
          });
        }
      });
    }

    renderTable(currentUnit);

    const sizeUnitWrapper = wrapper.querySelector('.size-unit');
    const unitSwitch = sizeUnitWrapper.querySelector('.unit-switch');
    sizeUnitWrapper.addEventListener('click', function (e) {
      e.preventDefault();
      unitSwitch.classList.toggle('right');
      const toUnit = unitSwitch.classList.contains('right') ? 'cm' : 'in';
      if (toUnit !== currentUnit) {
        currentUnit = toUnit;
        renderTable(currentUnit);
      }
    });

    function show3Rows(idx) {
      if (!Array.isArray(rows) || rows.length === 0) return;
      const n = rows.length;

      if (n <= 3) {
        rows.forEach(function (r, i) {
          r.style.display = 'table-row';
          r.classList.toggle('active', i === idx);
        });
        return;
      }

      let start;
      let end;
      if (idx <= 0) {
        start = 0;
        end = 2;
      } else if (idx >= n - 1) {
        start = n - 3;
        end = n - 1;
      } else {
        start = idx - 1;
        end = idx + 1;
      }

      rows.forEach(function (r, i) {
        if (i >= start && i <= end) {
          r.style.display = 'table-row';
        } else {
          r.style.display = 'none';
        }
        r.classList.toggle('active', i === idx);
      });
    }

    function showWrapper() {
      wrapper.classList.remove('hidden');
    }

    function getSizeValueFromVariant(v) {
      if (!v) return null;
      if (Array.isArray(v.options) && sizeIndex !== -1 && v.options[sizeIndex] != null) {
        return v.options[sizeIndex];
      }
      if (sizeIndex === 0 && v.option1 != null) return v.option1;
      if (sizeIndex === 1 && v.option2 != null) return v.option2;
      if (sizeIndex === 2 && v.option3 != null) return v.option3;

      // 高变体 / 选项顺序不确定时，从 options 里找像尺码的值
      if (Array.isArray(v.options)) {
        const match = v.options.find(function (opt) {
          const key = normalizeSizeKey(opt);
          return sizeValues.some(function (s) {
            return normalizeSizeKey(s) === key;
          }) || String(opt).toLowerCase().trim() === 'free custom';
        });
        if (match != null) return match;
      }
      return null;
    }

    function handleVariantObject(v) {
      if (!v) return;
      const sizeVal = getSizeValueFromVariant(v);
      if (!sizeVal) return;
      if (String(sizeVal).toLowerCase().trim() === 'free custom') {
        hideAll();
        return;
      }

      showWrapper();
      const idx = sizeValues.findIndex(function (s) {
        return s === sizeVal;
      });
      if (idx !== -1) {
        show3Rows(idx);
        return;
      }

      const normalized = normalizeSizeKey(sizeVal);
      const found = sizeValues.findIndex(function (s) {
        return normalizeSizeKey(s) === normalized;
      });
      if (found !== -1) show3Rows(found);
      else hideAll();
    }

    document.addEventListener('variant:change', function (e) {
      handleVariantObject(e.detail && e.detail.variant ? e.detail.variant : null);
    });
    document.addEventListener('product:variant-change', function (e) {
      handleVariantObject(e.detail && e.detail.variant ? e.detail.variant : null);
    });

    const initialVariant = {{ product.selected_or_first_available_variant | json }};
    handleVariantObject(initialVariant);
  });
</script>
