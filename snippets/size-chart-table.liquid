{%- liquid
  assign table_header_bg_color_value = table_header_bg_color | default: '#b3a6cc'
  assign table_body_bg_color_value = table_body_bg_color | default: '#fdf7ff'
  assign unit_switch_right_bg_color_value = unit_switch_right_bg_color | default: '#b3a6cc'
  assign table_active_row_bg_color_value = table_active_row_bg_color | default: '#ebe2f9'
  assign table_text_color_value = table_text_color | default: '#1d1d1f'

  assign length_type_metafield = product.metafields.shopify['skirt-dress-length-type']
  assign length_type_key = ''

  if length_type_metafield != blank and length_type_metafield.value != blank
    if length_type_metafield.type contains 'list.'
      for length_option in length_type_metafield.value
        capture length_option_label
          if length_option.label != blank
            echo length_option.label
          elsif length_option.name != blank
            echo length_option.name
          elsif length_option.handle != blank
            echo length_option.handle
          else
            echo length_option | metafield_text: field: 'label'
          endif
        endcapture
        assign length_option_label = length_option_label | strip
        if length_option_label == blank
          capture length_option_label
            echo length_option | metafield_text: field: 'name'
          endcapture
          assign length_option_label = length_option_label | strip
        endif
        if length_option_label != blank
          assign length_type_key = length_option_label
          break
        endif
      endfor
    else
      assign length_option = length_type_metafield.value
      capture length_option_label
        if length_option.label != blank
          echo length_option.label
        elsif length_option.name != blank
          echo length_option.name
        elsif length_option.handle != blank
          echo length_option.handle
        else
          echo length_option | metafield_text: field: 'label'
        endif
      endcapture
      assign length_type_key = length_option_label | strip
    endif
  endif

  assign length_type_key = length_type_key | downcase | strip

  if length_type_metafield != blank
    assign length_type_metafield_json = length_type_metafield.value | json
  else
    assign length_type_metafield_json = 'null'
  endif
-%}

<style>
  .variant-size-table-wrapper {
    margin-top: 1.2rem;
    max-width: 720px;
    transition: all 0.4s ease;
    overflow: hidden;
  }
  .variant-size-table-wrapper.hidden {
    max-height: 0;
    opacity: 0;
    margin: 0;
  }

  .size-unit {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    margin-bottom: 15px;
    cursor: pointer;
  }
  .size-unit .unit {
    font-weight: 500;
    font-size: 16px;
  }
  .size-unit .unit-switch {
    width: 40px;
    height: 20px;
    background: #ccc;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    transition: all 0.3s ease;
    position: relative;
  }
  .size-unit .unit-switch.right {
    justify-content: flex-end;
    background: var(--size-chart-unit-switch-right-bg, #b3a6cc);
  }
  .size-unit .switch-icon {
    width: 16px;
    height: 16px;
    background: #fff;
    border-radius: 50%;
    margin: 2px;
    transition: transform 0.3s ease;
  }

  .variant-size-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    text-align: center;
    color: var(--size-chart-text-color, #1d1d1f);
  }
  .variant-size-table th,
  .variant-size-table td {
    width: 20%;
    border: 1px solid #ccc;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }
  .variant-size-table th {
    font-size: 18px;
    font-weight: bold;
    padding: 10px;
    background-color: var(--size-chart-header-bg, #b3a6cc);
  }
  .variant-size-table td {
    font-size: 14px;
    font-weight: 400;
    padding: 8px 10px;
    background-color: var(--size-chart-body-bg, #fdf7ff);
  }
  .variant-row.active td {
    background-color: var(--size-chart-active-row-bg, #ebe2f9);
    font-weight: 600;
  }

  @media screen and (max-width: 767px) {
    .variant-size-table th {
      font-size: 14px;
    }
    .variant-size-table td {
      font-size: 12px;
    }
  }
</style>

<div
  class="variant-size-table-wrapper"
  data-size-chart-type="{{ length_type_key | escape }}"
  style="--size-chart-header-bg: {{ table_header_bg_color_value }}; --size-chart-body-bg: {{ table_body_bg_color_value }}; --size-chart-unit-switch-right-bg: {{ unit_switch_right_bg_color_value }}; --size-chart-active-row-bg: {{ table_active_row_bg_color_value }}; --size-chart-text-color: {{ table_text_color_value }};"
>
  <div class="size-unit">
    <span class="unit">IN</span>
    <div class="unit-switch right"><span class="switch-icon"></span></div>
    <span class="unit">CM</span>
  </div>

  <table class="variant-size-table">
    <thead>
      <tr>
        <th>Size</th>
        <th>Bust</th>
        <th>Waist</th>
        <th>Hip</th>
        <th>Length</th>
      </tr>
    </thead>
    <tbody>
      {% for option in product.options_with_values %}
        {% assign opt_name_down = option.name | downcase %}
        {% if opt_name_down == 'size' %}
          {% for size in option.values %}
            {% assign size_stripped = size | strip %}
            {% assign size_lower = size_stripped | downcase %}
            {% unless size_lower == 'free custom' %}
              <tr class="variant-row" data-size="{{ size_stripped }}">
                <td>{{ size_stripped }}</td>
                <td class="bust"></td>
                <td class="waist"></td>
                <td class="hip"></td>
                <td class="length"></td>
              </tr>
            {% endunless %}
          {% endfor %}
        {% endif %}
      {% endfor %}
    </tbody>
  </table>
</div>

