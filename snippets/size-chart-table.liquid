<style>
  .variant-size-table-wrapper {
    margin-top: 1.2rem;
    max-width: 720px;
    transition: all 0.4s ease;
    overflow: hidden;
  }
  .variant-size-table-wrapper.hidden {
    max-height: 0;
    opacity: 0;
    margin: 0;
  }

  .size-unit {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    margin-bottom: 15px;
    cursor: pointer;
  }
  .size-unit .unit {
    font-weight: 500;
    font-size: 16px;
  }
  .size-unit .unit-switch {
    width: 40px;
    height: 20px;
    background: #ccc;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    transition: all 0.3s ease;
    position: relative;
  }
  .size-unit .unit-switch.right {
    justify-content: flex-end;
    background: #b3a6cc;
  }
  .size-unit .switch-icon {
    width: 16px;
    height: 16px;
    background: #fff;
    border-radius: 50%;
    margin: 2px;
    transition: transform 0.3s ease;
  }

  .variant-size-table {
    width: 100%;
    border-collapse: collapse;
    text-align: center;
  }
  .variant-size-table th,
  .variant-size-table td {
    border: 1px solid #ccc;
  }
  .variant-size-table th {
    font-size: 18px;
    font-weight: bold;
    padding: 10px;
    background-color: #b3a6cc;
  }
  .variant-size-table td {
    font-size: 14px;
    font-weight: 400;
    padding: 8px 10px;
    background-color: #fdf7ff;
  }
  .variant-row.active td {
    background-color: #ebe2f9;
    font-weight: 600;
  }

  @media screen and (max-width: 767px) {
    .variant-size-table th {
      font-size: 14px;
    }
    .variant-size-table td {
      font-size: 12px;
    }
  }
</style>

<div class="variant-size-table-wrapper">
  <div class="size-unit">
    <span class="unit">IN</span>
    <div class="unit-switch right"><span class="switch-icon"></span></div>
    <span class="unit">CM</span>
  </div>

  <table class="variant-size-table">
    <thead>
      <tr>
        <th>Size</th>
        <th>Bust</th>
        <th>Waist</th>
        <th>Hip</th>
        <th>Length</th>
      </tr>
    </thead>
    <tbody>
      {% for option in product.options_with_values %}
        {% assign opt_name_down = option.name | downcase %}
        {% if opt_name_down == 'size' %}
          {% for size in option.values %}
            {% assign size_stripped = size | strip %}
            {% assign size_lower = size_stripped | downcase %}
            {% unless size_lower == 'free custom' %}
              <tr class="variant-row" data-size="{{ size_stripped }}">
                <td>{{ size_stripped }}</td>
                <td class="bust"></td>
                <td class="waist"></td>
                <td class="hip"></td>
                <td class="length"></td>
              </tr>
            {% endunless %}
          {% endfor %}
        {% endif %}
      {% endfor %}
    </tbody>
  </table>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {

    // ---------------- 1) 尺码数据 ----------------
    const sizeTable = {
      "US2":   { cm:{bust:83,waist:65,hip:91,length:147}, in:{bust:"32½",waist:"25½",hip:"35¾",length:58}},
      "US4":   { cm:{bust:85,waist:68,hip:92,length:147}, in:{bust:"33½",waist:"26½",hip:"36¼",length:58}},
      "US6":   { cm:{bust:88,waist:70,hip:96,length:150}, in:{bust:"34½",waist:"27½",hip:"37¾",length:59}},
      "US8":   { cm:{bust:90,waist:72,hip:98,length:150}, in:{bust:"35½",waist:"28½",hip:"38¾",length:59}},
      "US10":  { cm:{bust:93,waist:75,hip:101,length:152}, in:{bust:"36½",waist:"29½",hip:"39¾",length:60}},
      "US12":  { cm:{bust:97,waist:79,hip:105,length:152}, in:{bust:"38",waist:"31",hip:"41¼",length:60}},
      "US14":  { cm:{bust:100,waist:83,hip:109,length:155}, in:{bust:"39½",waist:"32½",hip:"42¾",length:61}},
      "US16":  { cm:{bust:104,waist:86,hip:112,length:155}, in:{bust:"41",waist:"34",hip:"44",length:61}},
      "US16W": { cm:{bust:109,waist:92,hip:116,length:155}, in:{bust:"43",waist:"36¼",hip:"45½",length:61}},
      "US18W": { cm:{bust:114,waist:98,hip:121,length:155}, in:{bust:"45",waist:"38½",hip:"47½",length:61}},
      "US20W": { cm:{bust:119,waist:104,hip:126,length:155}, in:{bust:"47",waist:"40¾",hip:"49½",length:61}},
      "US22W": { cm:{bust:124,waist:109,hip:131,length:155}, in:{bust:"49",waist:"43",hip:"51½",length:61}},
      "US24W": { cm:{bust:129,waist:114,hip:136,length:155}, in:{bust:"51",waist:"45¼",hip:"53¼",length:61}},
      "US26W": { cm:{bust:134,waist:119,hip:141,length:155}, in:{bust:"53",waist:"47½",hip:"55½",length:61}}
    };

    const normalizedSizeTable = {};
    Object.keys(sizeTable).forEach(k=>{
      normalizedSizeTable[k.toUpperCase().replace(/\s+/g,'').replace(/[^A-Z0-9]/g,'')] = sizeTable[k];
    });

    const productVariants = {{ product.variants | json }};
    const productOptions = {{ product.options | json }};
    const sizeIndex = (productOptions||[]).findIndex(opt=>String(opt).toLowerCase()==='size');

    const wrapper = document.querySelector('.variant-size-table-wrapper');
    const rows = Array.from(document.querySelectorAll('.variant-row'));
    const sizeValues = rows.map(r=>r.dataset.size);
    let currentUnit = 'cm';

    function lookupSizeData(sizeRaw, unit){
      const norm = String(sizeRaw).toUpperCase().trim().replace(/\s+/g,'').replace(/[^A-Z0-9]/g,'');
      return normalizedSizeTable[norm]? normalizedSizeTable[norm][unit]:null;
    }

    function renderTable(unit){
      rows.forEach(row=>{
        const size=row.dataset.size;
        const d=lookupSizeData(size,unit);
        if(d){
          row.querySelector('.bust').textContent=d.bust;
          row.querySelector('.waist').textContent=d.waist;
          row.querySelector('.hip').textContent=d.hip;
          row.querySelector('.length').textContent=d.length;
        }else{
          row.querySelectorAll('td:not(:first-child)').forEach(td=>td.textContent='-');
        }
      });
    }
    renderTable(currentUnit);

    // ---- 滑块切换动画 ----
    const sizeUnitWrapper=document.querySelector('.size-unit');
    const unitSwitch=sizeUnitWrapper.querySelector('.unit-switch');
    sizeUnitWrapper.addEventListener('click',function(e){
      e.preventDefault();
      unitSwitch.classList.toggle('right');
      const toUnit=unitSwitch.classList.contains('right')?'cm':'in';
      if(toUnit!==currentUnit){ currentUnit=toUnit; renderTable(currentUnit); }
    });

    // ---- 三行窗口逻辑（已修复边界：首/末项仍显示三行） ----
    function show3Rows(idx){
      if (!Array.isArray(rows) || rows.length === 0) return;
      const n = rows.length;

      // 若总行数 <= 3 则全部显示
      if (n <= 3) {
        rows.forEach((r,i)=>{ r.style.display='table-row'; r.classList.toggle('active', i===idx); });
        return;
      }

      // 边界处理：首项 -> 0,1,2 ; 末项 -> n-3,n-2,n-1 ; 其它 -> idx-1,idx,idx+1
      let start, end;
      if (idx <= 0) {
        start = 0;
        end = 2;
      } else if (idx >= n - 1) {
        start = n - 3;
        end = n - 1;
      } else {
        start = idx - 1;
        end = idx + 1;
      }

      rows.forEach((r,i)=>{
        if (i >= start && i <= end) {
          r.style.display = 'table-row';
        } else {
          r.style.display = 'none';
        }
        r.classList.toggle('active', i === idx);
      });
    }

    function hideAll(){ rows.forEach(r=>r.style.display='none'); wrapper.classList.add('hidden'); }
    function showWrapper(){ wrapper.classList.remove('hidden'); }

    function handleVariantObject(v){
      if(!v||sizeIndex===-1)return;
      const sizeVal=v.options[sizeIndex];
      if(!sizeVal)return;
      if(String(sizeVal).toLowerCase().trim()==='free custom'){ hideAll();return;}
      showWrapper();
      const idx=sizeValues.findIndex(s=>s===sizeVal);
      if(idx!==-1){ show3Rows(idx); }
      else{
        const normalized=String(sizeVal).toUpperCase().replace(/\s+/g,'').replace(/[^A-Z0-9]/g,'');
        const found=sizeValues.findIndex(s=>String(s).toUpperCase().replace(/\s+/g,'').replace(/[^A-Z0-9]/g,'')===normalized);
        if(found!==-1) show3Rows(found);
        else hideAll();
      }
    }

    document.addEventListener('variant:change',e=>{ handleVariantObject(e.detail&&e.detail.variant?e.detail.variant:null); });

    const variantInput=document.querySelector('[name="id"]');
    if(variantInput){
      variantInput.addEventListener('change',function(){
        const v=productVariants.find(x=>String(x.id)===String(this.value));
        if(v)handleVariantObject(v);
      });
    }

    const initialVariant={{ product.selected_or_first_available_variant | json }};
    handleVariantObject(initialVariant);
  });
</script>
