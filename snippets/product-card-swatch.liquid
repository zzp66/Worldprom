{%- if settings.show_products_swatches -%}
	{%- unless product.has_only_default_variant -%}
		{%- for option in product.options_with_values -%}
			{%- liquid
				assign option_name = option.name | downcase | escape 
				assign color_swatch = false

				if option_name contains 'color' or option_name contains 'colour' or option_name contains 'couleur' or option_name contains 'farbe'
					assign color_swatch = true
				endif
				
				# Additional swatch variant options set inside theme settings
				assign color_swatches_variant_option = settings.color_swatches_variant_option | downcase | split: ', '

				if color_swatches_variant_option contains option_name
					assign color_swatch = true
				endif
			-%}
			{%- if color_swatch -%}
				{%- liquid
				assign color_index = forloop.index0

				# The collection grid parses the custom color table once and passes it in (swatch_keys / swatch_vals).
				# Other callers don't, so parse it here as before.
				if swatch_keys
					assign key_array = swatch_keys
					assign val_array = swatch_vals
				else
					assign custom_colors = settings.color_swatches | newline_to_br | split: '<br />'
					assign key_array = ''
					assign val_array = ''

					for color in custom_colors
						assign key = color | split: ':' | first | rstrip
						assign value = color | split: ':' | last | lstrip
						assign key_array = key_array | append: ',' | append: key
						assign val_array = val_array | append: ',' | append: value
					endfor

					assign key_array = key_array | remove_first: ',' | strip_newlines | downcase | split: ','
					assign val_array = val_array | remove_first: ',' | split: ','
				endif

				# Number of swatches to show
				assign show_products_swatches_limit_count = settings.show_products_swatches_limit_count
				if option.values.size > show_products_swatches_limit_count
					assign remaining = option.values.size | minus: show_products_swatches_limit_count
				endif

				assign size = option.values.size | at_most: show_products_swatches_limit_count

				# The color the card image currently shows (passed in by product-card on color collections)
				assign selected_index = -1
				if selected_color != blank
					for option_value in option.values
						assign option_value_down = option_value.name | default: option_value | append: '' | downcase | strip
						if option_value_down == selected_color
							assign selected_index = forloop.index0
							break
						endif
					endfor
				endif

				# Swatch order: move the selected color to the front when it falls outside the visible swatches
				assign last_index = option.values.size | minus: 1
				assign swatch_order = ''
				if selected_index >= show_products_swatches_limit_count
					assign swatch_order = selected_index | append: ''
					for i in (0..last_index)
						if i != selected_index
							assign swatch_order = swatch_order | append: ',' | append: i
						endif
					endfor
				else
					for i in (0..last_index)
						assign swatch_order = swatch_order | append: ',' | append: i
					endfor
					assign swatch_order = swatch_order | remove_first: ','
				endif
				assign swatch_order = swatch_order | split: ','
				-%}
				{% if option.values.size > 1 %}
				<div class="product-card-swatches--container no-js-hidden">
					<div class="product-card-swatches product-card-swatches-expand--{{ settings.show_products_swatches_expand }}" data-index="{{ color_index }}" style="--size: {{ size }}">
						{%- capture option_id %}{{ section.id }}-{{ product.id }}-{{ option.name | handle }}{% endcapture -%}
						{%- for swatch_index in swatch_order limit: show_products_swatches_limit_count -%}
							{%- liquid
								assign value_index = swatch_index | plus: 0
								assign value = option.values[value_index]
								assign value_name = value.name | default: value | append: ''
								assign active = false
								assign variant_image = blank
								assign variant_url = ''
								assign srcset = ''

								# Exact match: the variant Shopify links to this option value.
								# Fallback compares the color option exactly (never a partial title match,
								# which confused e.g. Blue with Sky Blue).
								assign swatch_variant = value.variant
								if swatch_variant == blank
									for variant in product.variants
										if variant.options[color_index] == value_name
											assign swatch_variant = variant
											break
										endif
									endfor
								endif

								if selected_index >= 0
									if value_index == selected_index
										assign active = true
									endif
								elsif swatch_variant.image.id and swatch_variant.image.id == product.featured_image.id
									assign active = true
								endif

								if swatch_variant
									if swatch_variant.image
										assign variant_image = swatch_variant.image
									endif
									assign variant_url = swatch_variant.url
								endif
								assign image_sizes = sizes | split: ","
							-%}
							{%- capture srcset -%}
								{%- if variant_image != blank -%}
								  {%- for size in image_sizes -%}
								    {%- assign small_size = '20x' -%}
								    {%- assign size_array = size | split: "x" -%}
								    {%- assign size_x = size_array[0] | append: 'x' -%}
								    {% if size_array[1] != "0" %}
								      {%- assign size_x = size -%}
								      {%- assign small_x = size_array[1] | times: 20 | divided_by: size_array[0] | floor -%}
								      {%- assign small_size = small_size | append: small_x -%}
								    {% endif %}
								    {{- variant_image.src | img_url: size_x, crop: 'center' }} {{ size_array[0] }}w,
								  {%- endfor -%}
								{%- endif -%}
							{%- endcapture -%}
							{% assign l = srcset | size | minus: 1 %}
							{%- liquid
								assign color_value = value | downcase | escape

								for custom_color in key_array
									if custom_color == color_value
										assign color_value = val_array[forloop.index0]
									endif
								endfor

								assign bg_value = ''
								if color_value contains '.'
									assign bg_value = color_value | file_url
									assign color_value = 'var(--bg-body)'
								endif

								if settings.color_swatches_use_variants
									assign variant_image = blank

									if swatch_variant.image
										assign bg_value = swatch_variant.image | image_url: width: 52
									endif
								endif

								if value.swatch.image
									assign bg_value = value.swatch.image | image_url: width: variant_image_size
									assign swatch_focal_point = value.swatch.image.presentation.focal_point
								elsif value.swatch.color
									assign color_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
								endif
							-%}
							<input
								type="radio"
								class="product-card-swatch-input"
								id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
								name="{{ option_id }}-option"
								value="{{ value | escape }}"
								data-srcset="{{- srcset | slice: 0, l | strip_newlines -}}"
								{% if active %}checked{% endif %}
							><label
								class="product-card-swatch{% if settings.color_swatches_use_variants %} product-card-swatch--variant{%- endif -%}"
								for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
								style="--option-color: {{ color_value | downcase | escape }}; {%- if bg_value != blank -%} --option-color-image: url('{{ bg_value | escape }}');{%- endif -%}"
								data-href="{{ variant_url }}"
							>
								<span class="visually-hidden">{{ value }}</span>
							</label>
						{%- endfor -%}
					</div>
					{%- if remaining > 0 -%}
					<div class="product-card-swatches--remaining">+ {{ remaining }}</div>
					{%- endif -%}
				</div>
				{%- endif -%}
				{% break %}
			{%- endif -%}
		{%- endfor -%}
	{%- endunless -%}
{%- endif -%}
