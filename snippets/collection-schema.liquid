{%- liquid
	assign schema_description = page_description | default: collection.description | strip_html | strip_newlines | strip
	assign schema_description = schema_description | replace: '&nbsp;', ' ' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&rsquo;', "'" | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&amp;', '&'
-%}
<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	"name": {{ collection.title | json }},
	"url": "{{ canonical_url }}",
	{%- if schema_description != blank %}
	"description": {{ schema_description | json }},
	{%- endif %}
	"mainEntity": {
		"@type": "ItemList",
		"itemListElement": [
			{%- for product in collection.products limit: 20 -%}
			{%- assign product_url = shop.url | append: product.url -%}
			{
				"@type": "ListItem",
				"position": {{ forloop.index }},
				"url": "{{ product_url }}"
			}{%- unless forloop.last -%},{%- endunless -%}
			{%- endfor -%}
		]
	}
}
</script>
