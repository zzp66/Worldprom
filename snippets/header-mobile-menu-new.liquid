<nav id="mobile-menu" class="mobile-menu-drawer" role="dialog" tabindex="-1">
  <div class="mobile-menu-drawer--inner">
    {%- if header_settings.menu -%}
      <ul class="mobile-menu {{ settings.navigation_font_family }}-font">
        {%- for link in header_settings.menu.links -%}
          {%- liquid
            assign parent_index = forloop.index
            assign has_sub_menu = false
            assign has_mega_menu = false
            assign has_menu_badge = false

            assign mega_menu_block_index_sidebar = false

            assign mega_menu_blocks = blocks | where: 'type', 'megamenu'
            assign mega_menu_blocks_sidebar = blocks | where: 'type', 'megamenu_sidebar'
            assign mega_menu_blocks_promotions = blocks | where: 'type', 'megamenu_promotions'

            assign menu_badge_index = false
            assign menu_badge_blocks = blocks | where: 'type', 'menu_badge'

            if link.links.size > 0
              assign has_sub_menu = true
            endif
            for block in mega_menu_blocks
              assign position = block.settings.position | plus: 0
              if position == parent_index
                assign has_mega_menu = true
              endif
            endfor

            for block in mega_menu_blocks_sidebar
              assign position_sidebar = block.settings.position | plus: 0
              if position_sidebar == parent_index
                assign has_mega_menu = true
                assign mega_menu_block_index_sidebar = forloop.index0
              endif
            endfor

            for block in mega_menu_blocks_promotions
              assign position_promotions = block.settings.position | plus: 0
              if position_promotions == parent_index
                assign has_mega_menu = true
              endif
            endfor

            for block in menu_badge_blocks
              assign badge_position = block.settings.badge_position | plus: 0
              if badge_position == parent_index
                assign has_menu_badge = true
                assign menu_badge_index = forloop.index0
              endif
            endfor
          -%}
          <li class="link-forloop-1">
            {%- if has_sub_menu == true or has_mega_menu == true -%}
              <div class="link-forloop-1-box">
                <div class="link-forloop-1-title link-container">
                  {%- liquid
                    assign nav_collection = blank
                    if link.type == 'collection_link' and link.object != blank
                      assign nav_collection = link.object
                    endif
                  -%}
                  {%- if nav_collection and nav_collection.metafields.custom.link_color_block != blank -%}
                    <span
                      class="nav-color-block"
                      style="background-color: {{ nav_collection.metafields.custom.link_color_block }};"
                    ></span>
                  {%- endif -%}
                  {%- if nav_collection and nav_collection.metafields.custom.link_img_block != blank -%}
                    <div class="nav-img-block">
                      <img
                        src="{{ nav_collection.metafields.custom.link_img_block | image_url: width: master }}"
                        alt=""
                        width="15"
                        height="15"
                      >
                    </div>
                  {%- endif -%}
                  {{ link.title }}
                  {%- if has_menu_badge -%}
                    {%- assign menu_badge_block = menu_badge_blocks[menu_badge_index] -%}
                    <span
                      class="menu-item-badge"
                      style="--menu-badge-bg: {{ menu_badge_block.settings.color_bg }};--menu-badge-text: {{ menu_badge_block.settings.color_text }};"
                    >
                      {{- menu_badge_block.settings.text -}}
                    </span>
                  {%- endif -%}
                  <span class="link-forward">{%- render 'svg-icons' with 'thb-mobile-menu-forward' -%}</span>
                </div>
                <div class="link-forloop-2-menu">
                  <ul class="sub-menu-2">
                    {%- assign has_menu_badge = false -%}
                    {%- for l in link.links -%}
                      {%- liquid
                        assign has_sub_menu = false
                        if l.links.size > 0
                          assign has_sub_menu = true
                        endif

                        assign mega_menu_block_sidebar = mega_menu_blocks_sidebar[mega_menu_block_index_sidebar]
                      -%}
                      <li class="link-forloop-2">
                        {%- if has_mega_menu and mega_menu_block_sidebar -%}
                          {%- if l.links.size > 0 -%}
                            <div class="link-forloop-2-box">
                              <div class="link-forloop-2-title link-container">
                                {{- l.title -}}
                                <span class="link-forward">
                                  {%- render 'svg-icons' with 'thb-mobile-menu-forward' -%}
                                </span>
                              </div>
                              <div class="link-forloop-2-menu">
                                <ul class="sub-menu-2 mega-menu-sidebar--content">
                                  {%- for sub_link in l.links -%}
                                    <li class="link-forloop-2">
                                      {%- if sub_link.type == 'collection_link' and sub_link.object.featured_image -%}
                                        {%- if mega_menu_block_sidebar.settings.content_collection_image -%}
                                          <a href="{{ sub_link.url }}" class="mega-menu-sidebar--content-container">
                                            <div class="mega-menu-sidebar--content-image">
                                              {%- render 'responsive-image',
                                                image: sub_link.object.featured_image,
                                                sizes: '237x237',
                                                priority: 'low'
                                              -%}
                                            </div>
                                            <span class="text-button">
                                              {%- liquid
                                                assign nav_collection = blank
                                                if sub_link.type == 'collection_link' and sub_link.object != blank
                                                  assign nav_collection = sub_link.object
                                                endif
                                              -%}
                                              {%- if nav_collection and nav_collection.metafields.custom.link_color_block != blank -%}
                                                <span
                                                  class="nav-color-block"
                                                  style="background-color: {{ nav_collection.metafields.custom.link_color_block }};"
                                                ></span>
                                              {%- endif -%}
                                              {%- if nav_collection and nav_collection.metafields.custom.link_img_block != blank -%}
                                                <div class="nav-img-block">
                                                  <img
                                                    src="{{ nav_collection.metafields.custom.link_img_block | image_url: width: master }}"
                                                    alt=""
                                                    width="15"
                                                    height="15"
                                                  >
                                                </div>
                                              {%- endif -%}
                                              {{- sub_link.title -}}
                                            </span>
                                          </a>
                                        {%- else -%}
                                          <a href="{{ sub_link.url }}" class="thb-full-menu--link">
                                            {%- liquid
                                              assign nav_collection = blank
                                              if sub_link.type == 'collection_link' and sub_link.object != blank
                                                assign nav_collection = sub_link.object
                                              endif
                                            -%}
                                            {%- if nav_collection and nav_collection.metafields.custom.link_color_block != blank -%}
                                              <span
                                                class="nav-color-block"
                                                style="background-color: {{ nav_collection.metafields.custom.link_color_block }};"
                                              ></span>
                                            {%- endif -%}
                                            {%- if nav_collection and nav_collection.metafields.custom.link_img_block != blank -%}
                                              <div class="nav-img-block">
                                                <img
                                                  src="{{ nav_collection.metafields.custom.link_img_block | image_url: width: master }}"
                                                  alt=""
                                                  width="15"
                                                  height="15"
                                                >
                                              </div>
                                            {%- endif -%}
                                            {{- sub_link.title -}}
                                          </a>
                                        {%- endif -%}
                                      {%- elsif sub_link.type == 'product_link' -%}
                                        {%- render 'product-card-simple',
                                          product_card_product: sub_link.object,
                                          show_product_image: mega_menu_block_sidebar.settings.content_product_image
                                        -%}
                                      {%- endif -%}
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              </div>
                            </div>
                          {%- else -%}
                            <a href="{{ l.url }}" title="{{ l.title | escape }}" class="link-container">
                              {%- liquid
                                assign nav_collection = blank
                                if l.type == 'collection_link' and l.object != blank
                                  assign nav_collection = l.object
                                endif
                              -%}
                              {%- if nav_collection and nav_collection.metafields.custom.link_color_block != blank -%}
                                <span
                                  class="nav-color-block"
                                  style="background-color: {{ nav_collection.metafields.custom.link_color_block }};"
                                ></span>
                              {%- endif -%}
                              {%- if nav_collection and nav_collection.metafields.custom.link_img_block != blank -%}
                                <div class="nav-img-block">
                                  <img
                                    src="{{ nav_collection.metafields.custom.link_img_block | image_url: width: master }}"
                                    alt=""
                                    width="15"
                                    height="15"
                                  >
                                </div>
                              {%- endif -%}
                              {{- l.title -}}
                            </a>
                          {%- endif -%}
                        {%- elsif has_sub_menu -%}
                          <div class="link-forloop-2-box">
                            <div class="link-forloop-2-title link-container">
                              {%- liquid
                                assign nav_collection = blank
                                if l.type == 'collection_link' and l.object != blank
                                  assign nav_collection = l.object
                                endif
                              -%}
                              {%- if nav_collection and nav_collection.metafields.custom.link_color_block != blank -%}
                                <span
                                  class="nav-color-block"
                                  style="background-color: {{ nav_collection.metafields.custom.link_color_block }};"
                                ></span>
                              {%- endif -%}
                              {%- if nav_collection and nav_collection.metafields.custom.link_img_block != blank -%}
                                <div class="nav-img-block">
                                  <img
                                    src="{{ nav_collection.metafields.custom.link_img_block | image_url: width: master }}"
                                    alt=""
                                    width="15"
                                    height="15"
                                  >
                                </div>
                              {%- endif -%}
                              {{- l.title }}
                              {%- if has_menu_badge -%}
                                {%- assign menu_badge_block = menu_badge_blocks[menu_badge_index] -%}
                                <span
                                  class="menu-item-badge"
                                  style="--menu-badge-bg: {{ menu_badge_block.settings.color_bg }};--menu-badge-text: {{ menu_badge_block.settings.color_text }};"
                                >
                                  {{- menu_badge_block.settings.text -}}
                                </span>
                              {%- endif -%}
                              <span class="link-forward">
                                {%- render 'svg-icons' with 'thb-mobile-menu-forward' -%}
                              </span>
                            </div>
                            <div class="link-forloop-3-menu">
                              <ul class="sub-menu-3">
                                {%- for sub_link in l.links -%}
                                  {%- liquid
                                    assign has_sub_menu = false
                                    if sub_link.links.size > 0
                                      assign has_sub_menu = true
                                    endif
                                  -%}
                                  <li class="sub-link-li">
                                    <a
                                      href="{{ sub_link.url }}"
                                      title="{{ sub_link.title | escape }}"
                                      class="link-container"
                                      role="menuitem"
                                    >
                                      {%- liquid
                                        assign nav_collection = blank
                                        if sub_link.type == 'collection_link' and sub_link.object != blank
                                          assign nav_collection = sub_link.object
                                        endif
                                      -%}
                                      {%- if nav_collection and nav_collection.metafields.custom.link_color_block != blank -%}
                                        <span
                                          class="nav-color-block"
                                          style="background-color: {{ nav_collection.metafields.custom.link_color_block }};"
                                        ></span>
                                      {%- endif -%}
                                      {%- if nav_collection and nav_collection.metafields.custom.link_img_block != blank -%}
                                        <div class="nav-img-block">
                                          <img
                                            src="{{ nav_collection.metafields.custom.link_img_block | image_url: width: master }}"
                                            alt=""
                                            width="15"
                                            height="15"
                                          >
                                        </div>
                                      {%- endif -%}
                                      {{- sub_link.title }}
                                      {% if has_sub_menu %}<span></span>{%- endif -%}
                                    </a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            </div>
                          </div>
                        {%- else -%}
                          <a href="{{ l.url }}" title="{{ l.title | escape }}" class="link-container">
                            {%- liquid
                              assign nav_collection = blank
                              if l.type == 'collection_link' and l.object != blank
                                assign nav_collection = l.object
                              endif
                            -%}
                            {%- if nav_collection and nav_collection.metafields.custom.link_color_block != blank -%}
                              <span
                                class="nav-color-block"
                                style="background-color: {{ nav_collection.metafields.custom.link_color_block }};"
                              ></span>
                            {%- endif -%}
                            {%- if nav_collection and nav_collection.metafields.custom.link_img_block != blank -%}
                              <div class="nav-img-block">
                                <img
                                  src="{{ nav_collection.metafields.custom.link_img_block | image_url: width: master }}"
                                  alt=""
                                  width="15"
                                  height="15"
                                >
                              </div>
                            {%- endif -%}
                            {{ l.title }}
                          </a>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
            {%- else -%}
              <a href="{{ link.url }}" title="{{ link.title | escape }}" class="link-container">
                {{- link.title }}
                {%- if has_menu_badge -%}
                  {%- assign menu_badge_block = menu_badge_blocks[menu_badge_index] -%}
                  <span
                    class="menu-item-badge"
                    style="--menu-badge-bg: {{ menu_badge_block.settings.color_bg }};--menu-badge-text: {{ menu_badge_block.settings.color_text }};"
                  >
                    {{- menu_badge_block.settings.text -}}
                  </span>
                {%- endif -%}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- assign mobile_secondary_menu = blocks | where: 'type', 'mobile_secondary_menu' -%}
    {%- if mobile_secondary_menu[0].settings.menu -%}
      <ul class="mobile-secondary-menu {{ settings.navigation_font_family }}-font">
        {%- for link in mobile_secondary_menu[0].settings.menu.links -%}
          <li class="{% if link.active %} active{% endif %}">
            <a href="{{ link.url }}" title="{{ link.title | escape }}">{{ link.title }}</a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    <div class="thb-mobile-menu-footer">
      <div class="no-js-hidden">
        {%- render 'localization',
          id: 'MobileMenuLocalization',
          show_language_switcher: header_settings.show_language_switcher,
          show_currency_switcher: header_settings.show_currency_switcher
        -%}
      </div>
    </div>
  </div>
</nav>
<link rel="stylesheet" href="{{ 'mobile-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'mobile-menu.css' | asset_url | stylesheet_tag }}</noscript>
<script>
  (function () {
    function setDisplay(el, isOpen) {
      if (!el) return;
      el.style.display = isOpen ? 'block' : 'none';
    }

    function isOpen(el) {
      if (!el) return false;
      return el.style.display !== 'none' && getComputedStyle(el).display !== 'none';
    }

    function closeAll(selector, exceptEl) {
      document.querySelectorAll(selector).forEach(function (el) {
        if (exceptEl && el === exceptEl) return;
        setDisplay(el, false);
      });
    }

    function deactivateAll(selector, exceptEl) {
      document.querySelectorAll(selector).forEach(function (el) {
        if (exceptEl && el === exceptEl) return;
        el.classList.remove('active');
      });
    }

    document.addEventListener('click', function (e) {
      var lvl1Title = e.target.closest('.link-forloop-1-title');
      if (lvl1Title) {
        e.preventDefault();
        var box1 = lvl1Title.closest('.link-forloop-1-box');
        var submenu2 = box1 ? box1.querySelector('.link-forloop-2-menu') : null;
        var arrow1 = lvl1Title.querySelector('.link-forward');

        closeAll('.link-forloop-2-menu', submenu2);
        deactivateAll('.link-forloop-1-title .link-forward', arrow1);

        var nextOpen = !isOpen(submenu2);
        setDisplay(submenu2, nextOpen);
        if (arrow1) arrow1.classList.toggle('active', nextOpen);
        return;
      }

      var lvl2Title = e.target.closest('.link-forloop-2-title');
      if (lvl2Title) {
        e.preventDefault();
        var box2 = lvl2Title.closest('.link-forloop-2-box');
        var submenu3 = box2 ? box2.querySelector('.link-forloop-3-menu') : null;
        var arrow2 = lvl2Title.querySelector('.link-forward');

        var menu2 = lvl2Title.closest('.link-forloop-2-menu');
        if (menu2) {
          menu2.querySelectorAll('.link-forloop-3-menu').forEach(function (el) {
            if (submenu3 && el === submenu3) return;
            setDisplay(el, false);
          });
          menu2.querySelectorAll('.link-forloop-2-title .link-forward').forEach(function (el) {
            if (arrow2 && el === arrow2) return;
            el.classList.remove('active');
          });
        }

        var nextOpen2 = !isOpen(submenu3);
        setDisplay(submenu3, nextOpen2);
        if (arrow2) arrow2.classList.toggle('active', nextOpen2);
      }
    });
  })();
</script>
